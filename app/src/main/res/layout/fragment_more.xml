<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollMore"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/roomkit_size_20"
        android:paddingTop="@dimen/roomkit_size_20"
        android:paddingBottom="@dimen/roomkit_size_24">

        <!-- Screen Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/rm_title"
            android:textColor="@color/roomkit_text_primary"
            android:textSize="@dimen/roomkit_text_30"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_spacing_xs"
            android:fontFamily="sans-serif"
            android:text="@string/rm_subtitle"
            android:textColor="@color/roomkit_text_secondary"
            android:textSize="@dimen/roomkit_text_14" />

        <!-- Brand / Property Hero Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_24"
            app:cardBackgroundColor="@color/roomkit_white"
            app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
            app:cardElevation="@dimen/roomkit_size_0"
            app:strokeColor="@color/roomkit_border"
            app:strokeWidth="@dimen/roomkit_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/roomkit_card_radius_medium">

                <FrameLayout
                    android:layout_width="@dimen/roomkit_action_height"
                    android:layout_height="@dimen/roomkit_action_height"
                    android:background="@drawable/bg_rm_icon">

                    <ImageView
                        android:layout_width="@dimen/roomkit_size_32"
                        android:layout_height="@dimen/roomkit_size_32"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_rm_building"
                        app:tint="@color/roomkit_text_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/roomkit_button_radius_compact"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/rm_brand"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_22"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_spacing_xs"
                        android:fontFamily="sans-serif"
                        android:text="@string/rm_brand_sub"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 1: Management -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_26"
            android:layout_marginBottom="@dimen/roomkit_size_12"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.10"
            android:text="@string/rm_management"
            android:textColor="@color/roomkit_text_primary"
            android:textSize="@dimen/roomkit_text_12"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/roomkit_white"
            app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
            app:cardElevation="@dimen/roomkit_size_0"
            app:strokeColor="@color/roomkit_border"
            app:strokeWidth="@dimen/roomkit_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Row 1: Tenants -->
                <LinearLayout
                    android:id="@+id/cardTenants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/roomkit_size_80"
                    android:orientation="horizontal"
                    android:padding="@dimen/roomkit_size_16">

                    <FrameLayout
                        android:layout_width="@dimen/roomkit_size_44"
                        android:layout_height="@dimen/roomkit_size_44"
                        android:background="@drawable/bg_rm_icon">

                        <ImageView
                            android:layout_width="@dimen/roomkit_size_24"
                            android:layout_height="@dimen/roomkit_size_24"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rm_tenants"
                            app:tint="@color/roomkit_text_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="@dimen/roomkit_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/roomkit_button_radius_compact"
                        android:layout_marginEnd="@dimen/roomkit_size_8"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/rm_tenants"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_17"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_size_3"
                            android:fontFamily="sans-serif"
                            android:text="@string/rm_tenants_sub"
                            android:textColor="@color/roomkit_text_secondary"
                            android:textSize="@dimen/roomkit_text_13" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/roomkit_size_20"
                        android:layout_height="@dimen/roomkit_size_20"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ref_chvron"
                        app:tint="@color/roomkit_text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/roomkit_stroke_width"
                    android:layout_marginStart="@dimen/roomkit_size_74"
                    android:layout_marginEnd="@dimen/roomkit_size_16"
                    android:background="@color/roomkit_border" />

                <!-- Row 2: Reports -->
                <LinearLayout
                    android:id="@+id/cardReports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/roomkit_size_80"
                    android:orientation="horizontal"
                    android:padding="@dimen/roomkit_size_16">

                    <FrameLayout
                        android:layout_width="@dimen/roomkit_size_44"
                        android:layout_height="@dimen/roomkit_size_44"
                        android:background="@drawable/bg_rm_icon">

                        <ImageView
                            android:layout_width="@dimen/roomkit_size_24"
                            android:layout_height="@dimen/roomkit_size_24"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rm_reports"
                            app:tint="@color/roomkit_text_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="@dimen/roomkit_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/roomkit_button_radius_compact"
                        android:layout_marginEnd="@dimen/roomkit_size_8"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/rm_reports"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_17"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_size_3"
                            android:fontFamily="sans-serif"
                            android:text="@string/rm_reports_sub"
                            android:textColor="@color/roomkit_text_secondary"
                            android:textSize="@dimen/roomkit_text_13" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/roomkit_size_20"
                        android:layout_height="@dimen/roomkit_size_20"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ref_chvron"
                        app:tint="@color/roomkit_text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/roomkit_stroke_width"
                    android:layout_marginStart="@dimen/roomkit_size_74"
                    android:layout_marginEnd="@dimen/roomkit_size_16"
                    android:background="@color/roomkit_border" />

                <!-- Row 3: Reminders -->
                <LinearLayout
                    android:id="@+id/cardReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/roomkit_size_80"
                    android:orientation="horizontal"
                    android:padding="@dimen/roomkit_size_16">

                    <FrameLayout
                        android:layout_width="@dimen/roomkit_size_44"
                        android:layout_height="@dimen/roomkit_size_44"
                        android:background="@drawable/bg_rm_icon">

                        <ImageView
                            android:layout_width="@dimen/roomkit_size_24"
                            android:layout_height="@dimen/roomkit_size_24"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rm_bell"
                            app:tint="@color/roomkit_text_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="@dimen/roomkit_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/roomkit_button_radius_compact"
                        android:layout_marginEnd="@dimen/roomkit_size_8"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/rm_reminders"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_17"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_size_3"
                            android:fontFamily="sans-serif"
                            android:text="@string/rm_reminders_sub"
                            android:textColor="@color/roomkit_text_secondary"
                            android:textSize="@dimen/roomkit_text_13" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRemindersBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/roomkit_size_8"
                        android:background="@drawable/bg_rd_badge_red"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="@dimen/roomkit_size_24"
                        android:paddingHorizontal="@dimen/roomkit_size_8"
                        android:paddingVertical="@dimen/roomkit_spacing_xs"
                        android:textColor="@color/roomkit_error"
                        android:textSize="@dimen/roomkit_text_12"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="3"
                        tools:visibility="visible" />

                    <ImageView
                        android:layout_width="@dimen/roomkit_size_20"
                        android:layout_height="@dimen/roomkit_size_20"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ref_chvron"
                        app:tint="@color/roomkit_text_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 2: Preferences -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_24"
            android:layout_marginBottom="@dimen/roomkit_size_12"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.10"
            android:text="@string/rm_preferences"
            android:textColor="@color/roomkit_text_primary"
            android:textSize="@dimen/roomkit_text_12"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/roomkit_white"
            app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
            app:cardElevation="@dimen/roomkit_size_0"
            app:strokeColor="@color/roomkit_border"
            app:strokeWidth="@dimen/roomkit_stroke_width">

            <!-- Settings Row -->
            <LinearLayout
                android:id="@+id/cardSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/roomkit_size_80"
                android:orientation="horizontal"
                android:padding="@dimen/roomkit_size_16">

                <FrameLayout
                    android:layout_width="@dimen/roomkit_size_44"
                    android:layout_height="@dimen/roomkit_size_44"
                    android:background="@drawable/bg_rm_icon">

                    <ImageView
                        android:layout_width="@dimen/roomkit_size_24"
                        android:layout_height="@dimen/roomkit_size_24"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_rr_setting"
                        app:tint="@color/roomkit_text_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/roomkit_button_radius_compact"
                    android:layout_marginEnd="@dimen/roomkit_size_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/rm_settings"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_17"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_3"
                        android:fontFamily="sans-serif"
                        android:text="@string/rm_settings_sub"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/roomkit_size_20"
                    android:layout_height="@dimen/roomkit_size_20"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ref_chvron"
                    app:tint="@color/roomkit_text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>