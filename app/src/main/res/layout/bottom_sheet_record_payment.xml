<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/roomkit_size_24"
        android:paddingTop="@dimen/roomkit_size_12"
        android:paddingBottom="@dimen/roomkit_size_24">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/roomkit_size_36"
            android:layout_height="@dimen/roomkit_spacing_xs"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/roomkit_size_20"
            app:cardBackgroundColor="@color/roomkit_slate_300"
            app:cardCornerRadius="@dimen/roomkit_stroke_width_focused"
            app:cardElevation="@dimen/roomkit_size_0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record payment"
            android:textSize="@dimen/roomkit_text_24"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnSurface"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/tvPaymentHeaderSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_spacing_xs"
            android:textSize="@dimen/roomkit_text_14"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_20"
            app:cardBackgroundColor="@color/roomkit_slate_100"
            app:cardCornerRadius="@dimen/roomkit_size_20"
            app:cardElevation="@dimen/roomkit_size_0"
            app:strokeWidth="@dimen/roomkit_size_0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/roomkit_size_20">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total to pay"
                    android:textSize="@dimen/roomkit_text_13"
                    android:textColor="@color/roomkit_slate_medium" />

                <TextView
                    android:id="@+id/tvPaymentRemaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_spacing_xs"
                    android:textSize="@dimen/roomkit_text_30"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/roomkit_text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_spacing_xs"
                    android:text="Includes earlier unpaid invoices. Later months are excluded."
                    android:textSize="@dimen/roomkit_text_12"
                    android:textColor="@color/roomkit_slate_medium" />

                <TextView
                    android:id="@+id/tvCarryForwardBreakdown"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_size_12" android:textSize="@dimen/roomkit_text_13"
                    android:lineSpacingExtra="@dimen/roomkit_spacing_xs" android:textColor="@color/roomkit_slate_medium" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/roomkit_stroke_width"
                    android:layout_marginVertical="@dimen/roomkit_size_16"
                    android:background="@color/roomkit_slate_250" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="@dimen/roomkit_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="@dimen/roomkit_size_8"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="This invoice total"
                            android:textSize="@dimen/roomkit_text_12"
                            android:textColor="@color/roomkit_slate_medium" />

                        <TextView
                            android:id="@+id/tvPaymentTotalAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_spacing_xs"
                            android:textSize="@dimen/roomkit_text_15"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/roomkit_text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="@dimen/roomkit_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Paid on this invoice"
                            android:textSize="@dimen/roomkit_text_12"
                            android:textColor="@color/roomkit_slate_medium" />

                        <TextView
                            android:id="@+id/tvPaymentAlreadyPaid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_spacing_xs"
                            android:textSize="@dimen/roomkit_text_15"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/roomkit_green_800" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPaymentAmount"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_24"
            android:hint="Amount received"
            app:suffixText="KHR"
            app:boxCornerRadiusTopStart="@dimen/roomkit_size_16"
            app:boxCornerRadiusTopEnd="@dimen/roomkit_size_16"
            app:boxCornerRadiusBottomStart="@dimen/roomkit_size_16"
            app:boxCornerRadiusBottomEnd="@dimen/roomkit_size_16">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPaymentAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/roomkit_size_68"
                android:inputType="number"
                android:singleLine="true"
                android:textSize="@dimen/roomkit_text_24"
                android:fontFamily="sans-serif-medium"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullBalance"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:minHeight="@dimen/roomkit_touch_target"
            android:text="Use full balance"
            android:textAllCaps="false"
            android:letterSpacing="0" />

        <TextView
            android:id="@+id/tvBalanceAfterPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/roomkit_size_16"
            android:textSize="@dimen/roomkit_text_13"
            android:textColor="?android:attr/textColorSecondary"
            android:accessibilityLiveRegion="polite" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPaymentMethod"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Payment method"
            app:boxCornerRadiusTopStart="@dimen/roomkit_size_16"
            app:boxCornerRadiusTopEnd="@dimen/roomkit_size_16"
            app:boxCornerRadiusBottomStart="@dimen/roomkit_size_16"
            app:boxCornerRadiusBottomEnd="@dimen/roomkit_size_16">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/roomkit_control_height"
                android:inputType="none"
                android:textSize="@dimen/roomkit_text_16" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvBankNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_8"
            android:paddingHorizontal="@dimen/roomkit_spacing_xs"
            android:text="Confirm receipt in your banking app before saving."
            android:textSize="@dimen/roomkit_text_12"
            android:lineSpacingExtra="@dimen/roomkit_size_3"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPaymentDate"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_16"
            android:hint="Payment date"
            app:boxCornerRadiusTopStart="@dimen/roomkit_size_16"
            app:boxCornerRadiusTopEnd="@dimen/roomkit_size_16"
            app:boxCornerRadiusBottomStart="@dimen/roomkit_size_16"
            app:boxCornerRadiusBottomEnd="@dimen/roomkit_size_16"
            app:endIconDrawable="@drawable/ic_calender"
            app:endIconContentDescription="Choose payment date"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPaymentDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/roomkit_control_height"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:inputType="none"
                android:textSize="@dimen/roomkit_text_16" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdditionalDetails"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/roomkit_touch_target"
            android:layout_marginTop="@dimen/roomkit_size_12"
            android:gravity="start|center_vertical"
            android:text="Add reference or note"
            android:textAllCaps="false"
            android:letterSpacing="0" />

        <LinearLayout
            android:id="@+id/additionalDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPaymentReference"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_8"
                android:hint="Payment reference (optional)"
                app:boxCornerRadiusTopStart="@dimen/roomkit_size_16"
                app:boxCornerRadiusTopEnd="@dimen/roomkit_size_16"
                app:boxCornerRadiusBottomStart="@dimen/roomkit_size_16"
                app:boxCornerRadiusBottomEnd="@dimen/roomkit_size_16">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPaymentReference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/roomkit_control_height"
                    android:inputType="text"
                    android:singleLine="true"
                    android:maxLength="100" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPaymentNote"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_16"
                android:hint="Note (optional)"
                app:boxCornerRadiusTopStart="@dimen/roomkit_size_16"
                app:boxCornerRadiusTopEnd="@dimen/roomkit_size_16"
                app:boxCornerRadiusBottomStart="@dimen/roomkit_size_16"
                app:boxCornerRadiusBottomEnd="@dimen/roomkit_size_16">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPaymentNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/roomkit_size_80"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/roomkit_control_height"
            android:layout_marginTop="@dimen/roomkit_size_20"
            android:text="Save payment"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textSize="@dimen/roomkit_text_16"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/roomkit_white"
            android:enabled="false"
            app:backgroundTint="@color/roomkit_text_primary"
            app:cornerRadius="@dimen/roomkit_size_16" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
