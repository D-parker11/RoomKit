<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.RoomKit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/roomkit_spacing_md"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/roomkit_card_padding">

        <!-- Top Header: Building Name & Chevron (Matched to binding.headerContainer) -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBuildingName"
                style="@style/TextAppearance.RoomKit.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Real Madrid Residence" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Open building"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/roomkit_text_muted" />
        </LinearLayout>

        <!-- Address Line with Location Pin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Address"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/roomkit_text_muted" />

            <TextView
                android:id="@+id/tvBuildingAddress"
                style="@style/TextAppearance.RoomKit.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="13sp"
                tools:text="St. 55, Chamkarmon, Phnom Penh" />
        </LinearLayout>

        <!-- Metric Counters Row (Rooms, Occupied, Vacant) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_spacing_lg"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCardRoomsCount"
                    style="@style/TextAppearance.RoomKit.StatValue.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/roomkit_text_primary"
                    tools:text="12" />

                <TextView
                    style="@style/TextAppearance.RoomKit.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Rooms"
                    android:textColor="@color/roomkit_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCardOccupiedCount"
                    style="@style/TextAppearance.RoomKit.StatValue.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/roomkit_text_primary"
                    tools:text="9" />

                <TextView
                    style="@style/TextAppearance.RoomKit.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Occupied"
                    android:textColor="@color/roomkit_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCardVacantCount"
                    style="@style/TextAppearance.RoomKit.StatValue.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/roomkit_text_primary"
                    tools:text="3" />

                <TextView
                    style="@style/TextAppearance.RoomKit.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Vacant"
                    android:textColor="@color/roomkit_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Occupancy Bar & Percent (Matched to binding.tvOccupancyPct) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_spacing_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.RoomKit.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Occupancy"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvOccupancyPct"
                style="@style/TextAppearance.RoomKit.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="75%" />
        </LinearLayout>

        <!-- Progress Bar (Matched to binding.progressOccupancy) -->
        <ProgressBar
            android:id="@+id/progressOccupancy"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressBackgroundTint="@color/roomkit_border"
            android:progressTint="@color/roomkit_primary"
            tools:progress="75" />

        <!-- Actions: View Rooms & Edit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_spacing_lg"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewRooms"
                style="@style/Widget.RoomKit.Button.NeutralSurface"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="View Rooms" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditBuilding"
                style="@style/Widget.RoomKit.Button.OutlinedSmall"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/roomkit_spacing_md"
                android:layout_weight="1"
                android:text="Edit" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>