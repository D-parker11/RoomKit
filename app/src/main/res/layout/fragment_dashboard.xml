<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/roomkit_bottom_safe_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/roomkit_size_20"
        android:paddingTop="@dimen/roomkit_size_20"
        android:paddingBottom="@dimen/roomkit_size_24">

        <!-- Header: Greeting, Title & Property Name -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:textColor="@color/roomkit_text_secondary"
            android:textSize="@dimen/roomkit_text_14"
            tools:text="Good afternoon" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_6"
            android:accessibilityHeading="true"
            android:fontFamily="sans"
            android:text="@string/rd_overview"
            android:textColor="@color/roomkit_text_primary"
            android:textSize="@dimen/roomkit_text_30"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPropertyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_spacing_xs"
            android:fontFamily="sans"
            android:textColor="@color/roomkit_text_secondary"
            android:textSize="@dimen/roomkit_text_16"
            tools:text="Proser" />

        <!-- Dashboard Loading Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/loadingDashboard"
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_spacing_xs"
            android:layout_marginTop="@dimen/roomkit_size_24"
            android:indeterminate="true"
            app:indicatorColor="@color/roomkit_text_primary" />

        <!-- Main Dashboard Content -->
        <LinearLayout
            android:id="@+id/dashboardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Card 1: Period & Financial Overview -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_24"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="@dimen/roomkit_size_20"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_size_20">

                    <!-- Period Title & Month Selector Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPeriodTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/dm_this_month"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_20"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tvMonthYear"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_size_10"
                            android:letterSpacing="0"
                            android:minHeight="@dimen/roomkit_touch_target"
                            android:text="@string/dm_choose_month"
                            android:textAllCaps="false"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_14"
                            app:cornerRadius="@dimen/roomkit_size_12"
                            app:icon="@drawable/ic_calender"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/roomkit_size_10"
                            app:iconSize="@dimen/roomkit_size_20"
                            app:iconTint="@color/roomkit_text_primary"
                            app:strokeColor="@color/roomkit_border" />
                    </LinearLayout>

                    <!-- Outstanding Total -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_16"
                        android:fontFamily="sans"
                        android:text="@string/rd_outstanding"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_14" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvOutstandingAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_6"
                        android:fontFamily="sans"
                        android:maxLines="1"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_30"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="@dimen/roomkit_text_30"
                        app:autoSizeMinTextSize="@dimen/roomkit_text_18"
                        app:autoSizeStepGranularity="@dimen/roomkit_text_1"
                        app:autoSizeTextType="uniform"
                        tools:text="1,746,000 KHR" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/roomkit_stroke_width"
                        android:layout_marginTop="@dimen/roomkit_size_20"
                        android:layout_marginBottom="@dimen/roomkit_size_16"
                        android:background="@color/roomkit_border" />

                    <!-- Billed vs Collected 2-Column Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="@dimen/roomkit_size_12">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:text="@string/rd_billed"
                                android:textColor="@color/roomkit_text_secondary"
                                android:textSize="@dimen/roomkit_text_14" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvBilledAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/roomkit_size_6"
                                android:fontFamily="sans"
                                android:maxLines="1"
                                android:textColor="@color/roomkit_text_primary"
                                android:textSize="@dimen/roomkit_text_18"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="@dimen/roomkit_text_18"
                                app:autoSizeMinTextSize="@dimen/roomkit_text_11"
                                app:autoSizeStepGranularity="@dimen/roomkit_text_1"
                                app:autoSizeTextType="uniform"
                                tools:text="1,746,000 KHR" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/roomkit_stroke_width"
                            android:layout_height="@dimen/roomkit_size_44"
                            android:background="@color/roomkit_border" />

                        <LinearLayout
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/roomkit_size_16">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:text="@string/rd_collected"
                                android:textColor="@color/roomkit_text_secondary"
                                android:textSize="@dimen/roomkit_text_14" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvCollectedAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/roomkit_size_6"
                                android:fontFamily="sans"
                                android:maxLines="1"
                                android:textColor="@color/roomkit_success"
                                android:textSize="@dimen/roomkit_text_18"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="@dimen/roomkit_text_18"
                                app:autoSizeMinTextSize="@dimen/roomkit_text_11"
                                app:autoSizeStepGranularity="@dimen/roomkit_text_1"
                                app:autoSizeTextType="uniform"
                                tools:text="0 KHR" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Collection Progress Bar & Label -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/collectionProgress"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/roomkit_size_8"
                        android:layout_marginTop="@dimen/roomkit_size_22"
                        android:indeterminate="false"
                        android:max="100"
                        app:indicatorColor="@color/roomkit_success"
                        app:trackColor="@color/roomkit_track"
                        app:trackCornerRadius="@dimen/roomkit_spacing_xs"
                        app:trackThickness="@dimen/roomkit_size_8" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCollectionPercent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_6"
                        android:fontFamily="sans"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13"
                        tools:text="0% collected" />

                    <!-- Invoice Status Badges Carousel -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_button_radius_compact"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvUnpaidCountLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/roomkit_size_8"
                                android:background="@drawable/bg_rd_badge_amber"
                                android:drawablePadding="@dimen/roomkit_size_6"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:paddingHorizontal="@dimen/roomkit_size_10"
                                android:paddingVertical="@dimen/roomkit_size_6"
                                android:textColor="@color/roomkit_warning"
                                android:textSize="@dimen/roomkit_text_12"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_rd_status_dot"
                                app:drawableTint="@color/roomkit_warning"
                                tools:text="1 unpaid" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPartialCountLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/roomkit_size_8"
                                android:background="@drawable/bg_rd_badge_amber"
                                android:drawablePadding="@dimen/roomkit_size_6"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:paddingHorizontal="@dimen/roomkit_size_10"
                                android:paddingVertical="@dimen/roomkit_size_6"
                                android:textColor="@color/roomkit_warning"
                                android:textSize="@dimen/roomkit_text_12"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:drawableStartCompat="@drawable/ic_rd_status_dot"
                                app:drawableTint="@color/roomkit_warning"
                                tools:text="1 partial" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvOverdueCountLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/roomkit_size_8"
                                android:background="@drawable/bg_rd_badge_neutral"
                                android:drawablePadding="@dimen/roomkit_size_6"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:paddingHorizontal="@dimen/roomkit_size_10"
                                android:paddingVertical="@dimen/roomkit_size_6"
                                android:textColor="@color/roomkit_text_secondary"
                                android:textSize="@dimen/roomkit_text_12"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_rd_status_dot"
                                app:drawableTint="@color/roomkit_text_secondary"
                                tools:text="0 overdue" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Rooms & Occupancy Summary -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_16"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="@dimen/roomkit_size_20"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_size_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans"
                            android:text="@string/dm_rooms_now"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_20"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewProperty"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/roomkit_touch_target"
                            android:paddingStart="@dimen/roomkit_size_8"
                            android:paddingEnd="@dimen/roomkit_size_0"
                            android:text="@string/rd_view_property"
                            android:textAllCaps="false"
                            android:textColor="@color/roomkit_text_secondary"
                            android:textSize="@dimen/roomkit_text_14"
                            app:icon="@drawable/ref_chvron"
                            app:iconGravity="textEnd"
                            app:iconPadding="@dimen/roomkit_size_6"
                            app:iconSize="@dimen/roomkit_card_radius_medium"
                            app:iconTint="@color/roomkit_text_secondary" />
                    </LinearLayout>

                    <!-- 3-Column Rooms Metric Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_8"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Metric: Total -->
                        <LinearLayout
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/roomkit_size_8">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvTotalRoomsCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:textColor="@color/roomkit_text_primary"
                                android:textSize="@dimen/roomkit_text_26"
                                android:textStyle="bold"
                                tools:text="14" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                                android:fontFamily="sans"
                                android:text="@string/rd_total"
                                android:textColor="@color/roomkit_text_secondary"
                                android:textSize="@dimen/roomkit_text_13" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/roomkit_stroke_width"
                            android:layout_height="@dimen/roomkit_size_42"
                            android:background="@color/roomkit_border" />

                        <!-- Metric: Occupied -->
                        <LinearLayout
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/roomkit_size_8">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvOccupiedRoomsCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:textColor="@color/roomkit_text_primary"
                                android:textSize="@dimen/roomkit_text_26"
                                android:textStyle="bold"
                                tools:text="14" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                                android:fontFamily="sans"
                                android:text="@string/rd_occupied"
                                android:textColor="@color/roomkit_text_secondary"
                                android:textSize="@dimen/roomkit_text_13" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/roomkit_stroke_width"
                            android:layout_height="@dimen/roomkit_size_42"
                            android:background="@color/roomkit_border" />

                        <!-- Metric: Vacant -->
                        <LinearLayout
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/roomkit_size_8">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvVacantRoomsCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:textColor="@color/roomkit_text_primary"
                                android:textSize="@dimen/roomkit_text_26"
                                android:textStyle="bold"
                                tools:text="14" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                                android:fontFamily="sans"
                                android:text="@string/rd_vacant"
                                android:textColor="@color/roomkit_text_secondary"
                                android:textSize="@dimen/roomkit_text_13" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Occupancy Progress Indicator -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_22"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvOccupancyPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/roomkit_size_12"
                            android:fontFamily="sans"
                            android:textColor="@color/roomkit_text_secondary"
                            android:textSize="@dimen/roomkit_text_13"
                            tools:text="93% occupancy" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/occupancyProgress"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="@dimen/roomkit_size_8"
                            android:layout_weight="1"
                            android:indeterminate="false"
                            android:max="100"
                            app:indicatorColor="@color/roomkit_text_primary"
                            app:trackColor="@color/roomkit_track"
                            app:trackCornerRadius="@dimen/roomkit_spacing_xs"
                            app:trackThickness="@dimen/roomkit_size_8" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Needs Attention Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_20"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:fontFamily="sans"
                    android:text="@string/rd_needs_attention"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_20"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewAllAttention"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/roomkit_touch_target"
                    android:paddingStart="@dimen/roomkit_size_8"
                    android:paddingEnd="@dimen/roomkit_size_0"
                    android:text="@string/rd_view_all"
                    android:textAllCaps="false"
                    android:textColor="@color/roomkit_text_secondary"
                    android:textSize="@dimen/roomkit_text_14"
                    app:icon="@drawable/ref_chvron"
                    app:iconGravity="textEnd"
                    app:iconPadding="@dimen/roomkit_size_6"
                    app:iconSize="@dimen/roomkit_card_radius_medium"
                    app:iconTint="@color/roomkit_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAttentionPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/roomkit_spacing_xs"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_12" />

            <!-- Attention Rows Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/attentionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_8"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="@dimen/roomkit_size_20"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:id="@+id/attentionRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Attention Empty State Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tvEmptyAttention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_8"
                android:visibility="gone"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="@dimen/roomkit_size_20"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_size_20">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:text="@string/rd_all_caught_up"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_16"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_6"
                        android:fontFamily="sans"
                        android:text="@string/rd_no_attention"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_14" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>