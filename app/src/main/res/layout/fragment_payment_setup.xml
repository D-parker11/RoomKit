<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?android:attr/colorBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:background="?attr/colorSurface">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
            android:src="@drawable/ic_arrow_back" android:contentDescription="Back" android:background="?attr/selectableItemBackgroundBorderless" app:tint="?attr/colorOnSurface" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Payment setup" android:textSize="@dimen/roomkit_text_20" android:fontFamily="sans-serif-medium" android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Receive rent into your own account" android:textSize="@dimen/roomkit_text_22" android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp" android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add your bank’s reusable KHR receiving QR. It stays saved on this device." android:textSize="@dimen/roomkit_text_14" android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp" android:alpha="0.72" android:layout_marginBottom="24dp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="?attr/colorSurface"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView android:id="@+id/accountStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Not set up" android:textSize="@dimen/roomkit_text_12" android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp" android:alpha="0.65" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/accountTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your receiving QR" android:textSize="@dimen/roomkit_text_20" android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp" android:fontFamily="sans-serif-medium" />
                <ProgressBar android:id="@+id/progress" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:layout_marginTop="16dp" android:visibility="gone" />
                <ImageView android:id="@+id/qrPreview" android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginTop="20dp" android:layout_marginBottom="16dp" android:background="@color/roomkit_white" android:scaleType="fitCenter" android:contentDescription="Receiving KHQR preview" android:visibility="gone" />
                <TextView android:id="@+id/receiverDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Import the receiving QR image saved from your banking app." android:textSize="@dimen/roomkit_text_15" android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp" android:layout_marginTop="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnImport"  android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="16dp" android:text="Import KHQR image" android:textAllCaps="false" android:letterSpacing="0" app:cornerRadius="16dp" />
            </LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="?attr/colorSurface"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView android:id="@+id/invoiceHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Invoice preferences" android:textSize="@dimen/roomkit_text_16" android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp" android:fontFamily="sans-serif-medium" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/includePdf" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="8dp" android:saveEnabled="false" android:text="Show QR on invoice PDFs" android:textSize="@dimen/roomkit_text_15" />
                <TextView android:id="@+id/pdfHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add a receiving QR to enable this option." android:textSize="@dimen/roomkit_text_12" android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp" android:alpha="0.65" />
            </LinearLayout></com.google.android.material.card.MaterialCardView>
            <LinearLayout android:id="@+id/confirmationGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/confirmTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Check your recipient" android:textSize="@dimen/roomkit_text_16" android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp" android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/confirmHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scan this QR in a banking app and check the recipient before saving. RoomKit cannot verify account ownership." android:textSize="@dimen/roomkit_text_13" android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp" android:alpha="0.72" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/confirmReceiver" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:saveEnabled="false" android:text="I checked that this QR receives money into my account." />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSave"  android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="16dp" android:text="Save payment setup" android:textAllCaps="false" android:letterSpacing="0" app:cornerRadius="16dp" />
            </LinearLayout>
            <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="@dimen/roomkit_text_14" android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp" android:accessibilityLiveRegion="polite" android:layout_marginTop="12dp" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRemove" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="?attr/colorError" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="16dp" android:text="Remove receiving QR" android:textAllCaps="false" android:letterSpacing="0" app:cornerRadius="16dp" />
            <TextView android:id="@+id/footerNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RoomKit does not connect to your bank. Confirm received payments in your banking app before recording them." android:textSize="@dimen/roomkit_text_12" android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp" android:alpha="0.65" android:gravity="center" android:layout_marginTop="20dp" android:layout_marginBottom="12dp" />
        </LinearLayout></androidx.core.widget.NestedScrollView></LinearLayout>
