<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/roomkit_size_12"
    android:background="@drawable/bg_card_stroke"
    android:orientation="vertical"
    android:padding="@dimen/roomkit_size_16">

    <!-- Top Row: ROOM 101 & Occupancy Status Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROOM "
                android:textColor="@color/roomkit_gray_500"
                android:textSize="@dimen/roomkit_text_14"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRoomNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_17"
                android:textStyle="bold"
                tools:text="101" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvRoomStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_rd_badge_green"
            android:drawablePadding="@dimen/roomkit_size_6"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/roomkit_size_10"
            android:paddingVertical="@dimen/roomkit_size_5"
            android:text="Occupied"
            android:textColor="@color/roomkit_green_700"
            android:textSize="@dimen/roomkit_text_12"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_rd_status_dot"
            app:drawableTint="@color/roomkit_green_700" />
    </RelativeLayout>

    <!-- Tenant Name (Occupied) OR Available Notice (Vacant) -->
    <TextView
        android:id="@+id/tvTenantOrAvailability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/roomkit_size_8"
        android:textColor="@color/roomkit_text_primary"
        android:textSize="@dimen/roomkit_text_16"
        android:textStyle="bold"
        tools:text="Sokha Chan" />

    <!-- Monthly Rent -->
    <TextView
        android:id="@+id/tvRentAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
        android:textColor="@color/roomkit_gray_500"
        android:textSize="@dimen/roomkit_text_14"
        tools:text="400,000 ៛" />

    <View
        android:id="@+id/dividerMeta"
        android:layout_width="match_parent"
        android:layout_height="@dimen/roomkit_stroke_width"
        android:layout_marginTop="@dimen/roomkit_size_12"
        android:background="@color/roomkit_gray_100" />

    <!-- Meter Readings & Invoice Due Status -->
    <RelativeLayout
        android:id="@+id/layoutMetaInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/roomkit_size_12">

        <LinearLayout
            android:id="@+id/layoutMeters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/roomkit_button_radius_compact"
                android:layout_height="@dimen/roomkit_button_radius_compact"
                android:src="@drawable/ic_bolt"
                app:tint="@color/roomkit_gray_400" />

            <TextView
                android:id="@+id/tvElectricityReading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/roomkit_spacing_xs"
                android:textColor="@color/roomkit_gray_500"
                android:textSize="@dimen/roomkit_text_12"
                tools:text="1,250 kWh" />

            <TextView
                android:id="@+id/tvWaterReading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/roomkit_button_radius_compact"
                android:textColor="@color/roomkit_gray_500"
                android:textSize="@dimen/roomkit_text_12"
                tools:text="112 m³" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutInvoiceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDueDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/roomkit_size_8"
                android:textColor="@color/roomkit_gray_500"
                android:textSize="@dimen/roomkit_text_12"
                tools:text="Due Sep 5" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPaymentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rd_badge_amber"
                android:drawablePadding="@dimen/roomkit_size_5"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingHorizontal="@dimen/roomkit_size_9"
                android:paddingVertical="@dimen/roomkit_spacing_xs"
                android:textColor="@color/roomkit_amber_700"
                android:textSize="@dimen/roomkit_text_11"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_rd_status_dot"
                app:drawableTint="@color/roomkit_amber_700"
                tools:text="Unpaid" />
        </LinearLayout>
    </RelativeLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMoveInRoom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/roomkit_size_42"
        android:layout_marginTop="@dimen/roomkit_button_radius_compact"
        android:backgroundTint="@color/roomkit_text_primary"
        android:insetTop="@dimen/roomkit_size_0"
        android:insetBottom="@dimen/roomkit_size_0"
        android:text="Move In"
        android:textAllCaps="false"
        android:textColor="@color/roomkit_white"
        android:textSize="@dimen/roomkit_text_14"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="@dimen/roomkit_size_10"
        tools:visibility="visible" />

</LinearLayout>