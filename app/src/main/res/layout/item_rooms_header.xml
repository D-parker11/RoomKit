<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/roomkit_size_24"
            android:paddingTop="@dimen/roomkit_size_24">

            <!-- Top Header: Back Button, Building Info, & Circular Add Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/roomkit_size_40"
                    android:layout_height="@dimen/roomkit_size_40"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="@dimen/roomkit_size_8"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/roomkit_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/roomkit_size_8"
                    android:layout_toStartOf="@id/btnAddRoom"
                    android:layout_toEndOf="@id/btnBack"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBuildingName"
                        style="@style/TextAppearance.RoomKit.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Real Madrid Residence" />

                    <TextView
                        android:id="@+id/tvBuildingAddress"
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/roomkit_text_secondary"
                        tools:text="St.55, Chamkarmon, Phnom Penh" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddRoom"
                    android:layout_width="@dimen/roomkit_touch_target"
                    android:layout_height="@dimen/roomkit_touch_target"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Add Room"
                    android:insetLeft="@dimen/roomkit_size_0"
                    android:insetTop="@dimen/roomkit_size_0"
                    android:insetRight="@dimen/roomkit_size_0"
                    android:insetBottom="@dimen/roomkit_size_0"
                    android:padding="@dimen/roomkit_size_0"
                    app:backgroundTint="@color/roomkit_primary"
                    app:cornerRadius="@dimen/roomkit_size_24"
                    app:elevation="@dimen/roomkit_size_0"
                    app:icon="@drawable/ic_plus_white"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/roomkit_size_0"
                    app:iconSize="@dimen/roomkit_size_20"
                    app:iconTint="@color/roomkit_white" />
            </RelativeLayout>

            <!-- 2x2 Summary Metric Cards (Matching Dashboard Architecture) -->
            <!-- Row 1: Rooms & Occupied -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_16"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.RoomKit.Card.Stat"
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/roomkit_size_6"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/roomkit_size_16">

                        <TextView
                            style="@style/TextAppearance.RoomKit.CardLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ROOMS" />

                        <TextView
                            android:id="@+id/tvSummaryTotalRooms"
                            style="@style/TextAppearance.RoomKit.StatValue.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_size_8"
                            tools:text="12" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.RoomKit.Card.Stat"
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/roomkit_size_6"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/roomkit_size_16">

                        <TextView
                            style="@style/TextAppearance.RoomKit.CardLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OCCUPIED" />

                        <TextView
                            android:id="@+id/tvSummaryOccupied"
                            style="@style/TextAppearance.RoomKit.StatValue.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_size_8"
                            android:textColor="@color/roomkit_success"
                            tools:text="9" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2: Vacant & Occupancy % -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_8"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.RoomKit.Card.Stat"
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/roomkit_size_6"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/roomkit_size_16">

                        <TextView
                            style="@style/TextAppearance.RoomKit.CardLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VACANT" />

                        <TextView
                            android:id="@+id/tvSummaryVacant"
                            style="@style/TextAppearance.RoomKit.StatValue.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_size_8"
                            android:textColor="@color/roomkit_text_primary"
                            tools:text="3" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.RoomKit.Card.Stat"
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/roomkit_size_6"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/roomkit_size_16">

                        <TextView
                            style="@style/TextAppearance.RoomKit.CardLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OCCUPANCY" />

                        <TextView
                            android:id="@+id/tvSummaryOccupancyPercent"
                            style="@style/TextAppearance.RoomKit.StatValue.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_size_8"
                            android:textColor="@color/roomkit_primary"
                            tools:text="75%" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearchRooms"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_12"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/roomkit_white"
                app:boxStrokeColor="@color/roomkit_border"
                app:boxStrokeWidth="@dimen/roomkit_stroke_width"
                app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/roomkit_text_muted"
                app:endIconMode="clear_text">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearchRooms"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/roomkit_touch_target"
                    android:hint="@string/rrs_search_hint"
                    android:textSize="@dimen/roomkit_text_14"
                    android:textColor="@color/roomkit_text_primary"
                    android:textColorHint="@color/roomkit_text_muted"
                    android:singleLine="true"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Filter Tabs: All, Occupied, Vacant -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutRoomFilter"
                android:layout_width="match_parent"
                android:layout_height="@dimen/roomkit_size_44"
                android:layout_marginTop="@dimen/roomkit_size_12"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/roomkit_primary"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="@dimen/roomkit_size_2_5"
                app:tabMode="fixed"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="@color/roomkit_primary"
                app:tabTextAppearance="@style/TextAppearance.RoomKit.Tab"
                app:tabTextColor="@color/roomkit_text_muted" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/roomkit_stroke_width"
                android:background="@color/roomkit_divider" />

            <!-- Frame Container for Room List & Empty Feedback -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_12">



                <!-- Polished Empty State -->
                <LinearLayout
                    android:id="@+id/layoutEmptyRooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/roomkit_spacing_xxl"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvEmptyTitle"
                        style="@style/TextAppearance.RoomKit.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/roomkit_text_primary"
                        android:textStyle="bold"
                        tools:text="No rooms yet" />

                    <TextView
                        android:id="@+id/tvEmptySubtitle"
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                        android:text="Add your first room to this building." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyAddRoom"
                        style="@style/Widget.RoomKit.PrimaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/roomkit_size_46"
                        android:layout_marginTop="@dimen/roomkit_size_12"
                        android:paddingHorizontal="@dimen/roomkit_size_24"
                        android:text="Add Room"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
