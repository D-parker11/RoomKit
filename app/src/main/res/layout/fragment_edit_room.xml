<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:orientation="vertical"
    tools:context=".Date.Ui.Room.EditRoomFragment">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/roomkit_size_64"
        android:background="@color/roomkit_white"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/roomkit_size_12">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBackEditRoom"
            android:layout_width="@dimen/roomkit_touch_target"
            android:layout_height="@dimen/roomkit_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back"
            android:padding="@dimen/roomkit_size_12"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="@color/roomkit_text_primary" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="@dimen/roomkit_size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Edit room"
            android:textColor="@color/roomkit_text_primary"
            android:textSize="@dimen/roomkit_text_18" />

        <Space
            android:layout_width="@dimen/roomkit_touch_target"
            android:layout_height="@dimen/roomkit_touch_target" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollEditRoom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/roomkit_size_0"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/roomkit_size_20"
        android:paddingTop="@dimen/roomkit_size_20"
        android:paddingBottom="@dimen/roomkit_size_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Property context: display text, not a disabled field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROPERTY"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_11"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/etBuilding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_6"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_20"
                tools:text="Proser" />

            <!-- Occupied notice -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutOccupiedNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_20"
                android:visibility="gone"
                app:cardBackgroundColor="@color/roomkit_neutral_surface"
                app:cardCornerRadius="@dimen/roomkit_size_16"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeWidth="@dimen/roomkit_size_0"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_size_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Room currently occupied"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_14" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_6"
                        android:lineSpacingExtra="@dimen/roomkit_size_3"
                        android:text="Default rent changes apply to future tenancies. Current tenant charges and past invoices stay unchanged."
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_spacing_xxl"
                android:layout_marginBottom="@dimen/roomkit_size_16"
                android:fontFamily="sans-serif-medium"
                android:text="Room details"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_17" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRoomNumber"
                    style="@style/Widget.RoomKit.Input"
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/roomkit_size_12"
                    android:layout_weight="1"
                    android:hint="Room number *">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRoomNumber"
                        style="@style/Widget.RoomKit.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapCharacters"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFloor"
                    style="@style/Widget.RoomKit.Input"
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Floor">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFloor"
                        style="@style/Widget.RoomKit.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRoomType"
                style="@style/Widget.RoomKit.Input.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_16"
                android:hint="Room type">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvRoomType"
                    style="@style/Widget.RoomKit.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNotes"
                style="@style/Widget.RoomKit.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_16"
                android:hint="Notes · optional">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotes"
                    style="@style/Widget.RoomKit.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_8"
                android:text="Private notes for your reference."
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_spacing_xxl"
                android:fontFamily="sans-serif-medium"
                android:text="Default pricing"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_17" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_6"
                android:layout_marginBottom="@dimen/roomkit_size_16"
                android:text="Used when creating a new tenancy."
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_13" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMonthlyRent"
                style="@style/Widget.RoomKit.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Monthly rent *"
                app:suffixText="KHR"
                app:suffixTextColor="@color/roomkit_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMonthlyRent"
                    style="@style/Widget.RoomKit.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Read-only status -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_24"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="@dimen/roomkit_size_16"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/roomkit_size_16">

                    <LinearLayout
                        android:layout_width="@dimen/roomkit_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Occupancy"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_14" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_spacing_xs"
                            android:text="Managed by tenancy"
                            android:textColor="@color/roomkit_text_secondary"
                            android:textSize="@dimen/roomkit_text_12" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/etOccupancy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/roomkit_size_12"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/roomkit_success_dark"
                        android:textSize="@dimen/roomkit_text_14"
                        tools:text="Occupied" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_spacing_xxl"
                android:fontFamily="sans-serif-medium"
                android:text="Room management"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_17" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_6"
                android:layout_marginBottom="@dimen/roomkit_size_12"
                android:lineSpacingExtra="@dimen/roomkit_size_3"
                android:text="Archive to keep the room’s history. Rooms with tenancy or billing history cannot be deleted."
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_13" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnArchiveRoom"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/roomkit_control_height"
                android:insetTop="@dimen/roomkit_size_0"
                android:insetBottom="@dimen/roomkit_size_0"
                android:letterSpacing="0"
                android:text="Archive room"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_14"
                app:backgroundTint="@color/roomkit_white"
                app:cornerRadius="@dimen/roomkit_button_radius_compact"
                app:strokeColor="@color/roomkit_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteRoom"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/roomkit_action_height"
                android:insetTop="@dimen/roomkit_size_0"
                android:insetBottom="@dimen/roomkit_size_0"
                android:layout_marginTop="@dimen/roomkit_size_8"
                android:letterSpacing="0"
                android:text="Delete room"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_error_dark"
                android:textSize="@dimen/roomkit_text_14"
                app:backgroundTint="@color/roomkit_white"
                app:cornerRadius="@dimen/roomkit_button_radius_compact" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_12"
                android:accessibilityLiveRegion="polite"
                android:lineSpacingExtra="@dimen/roomkit_size_3"
                android:textColor="@color/roomkit_error_dark"
                android:textSize="@dimen/roomkit_text_14"
                android:visibility="gone"
                tools:text="Please check the room details."
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Save stays visible while the form scrolls -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/roomkit_white"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_stroke_width"
            android:background="@color/roomkit_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveChanges"
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_control_height"
            android:layout_marginHorizontal="@dimen/roomkit_size_20"
            android:layout_marginVertical="@dimen/roomkit_size_12"
            android:fontFamily="sans-serif-medium"
            android:insetTop="@dimen/roomkit_size_0"
            android:insetBottom="@dimen/roomkit_size_0"
            android:letterSpacing="0"
            android:text="Save changes"
            android:textAllCaps="false"
            android:textColor="@color/roomkit_white"
            android:textSize="@dimen/roomkit_text_16"
            app:backgroundTint="@color/roomkit_primary"
            app:cornerRadius="@dimen/roomkit_size_16"
            app:elevation="@dimen/roomkit_size_0" />
    </LinearLayout>
</LinearLayout>