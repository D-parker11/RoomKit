<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/roomkit_touch_target"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/roomkit_size_16">

    <!-- Selected Checkmark Icon -->
    <ImageView
        android:id="@+id/ivCheckmark"
        android:layout_width="@dimen/roomkit_card_radius_medium"
        android:layout_height="@dimen/roomkit_card_radius_medium"
        android:layout_marginEnd="@dimen/roomkit_size_10"
        android:src="@drawable/ic_check"
        android:visibility="invisible"
        app:tint="@color/roomkit_white"
        tools:visibility="visible" />

    <!-- Room Label: Room 204 — $300/mo -->
    <TextView
        android:id="@+id/tvRoomOptionText"
        android:layout_width="@dimen/roomkit_size_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/roomkit_white"
        android:textSize="@dimen/roomkit_text_15"
        android:textStyle="normal"
        tools:text="400,000 ៛" />

</LinearLayout>