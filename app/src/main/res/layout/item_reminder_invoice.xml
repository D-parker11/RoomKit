<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.RoomKit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/roomkit_size_12"
    app:cardCornerRadius="@dimen/roomkit_card_radius_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Content Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/roomkit_size_16">

            <!-- Room, Tenant & Status Badges Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/roomkit_size_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReminderRoom"
                        style="@style/TextAppearance.RoomKit.Body.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/roomkit_text_16"
                        android:textStyle="bold"
                        tools:text="Room 09 · Proser" />

                    <TextView
                        android:id="@+id/tvReminderTenant"
                        style="@style/TextAppearance.RoomKit.Caption.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_spacing_xs"
                        tools:text="GMengz · Invoice #0020" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvReminderPaymentBadge"
                        style="@style/TextAppearance.RoomKit.Caption.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/roomkit_size_6"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="@dimen/roomkit_size_10"
                        android:paddingVertical="@dimen/roomkit_size_5"
                        android:textSize="@dimen/roomkit_text_12"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_rd_status_dot"
                        tools:background="@drawable/bg_rd_badge_amber"
                        tools:drawableTint="@color/roomkit_warning"
                        tools:text="Unpaid"
                        tools:textColor="@color/roomkit_warning" />

                    <TextView
                        android:id="@+id/tvReminderDueBadge"
                        style="@style/TextAppearance.RoomKit.Caption.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/roomkit_size_6"
                        android:drawablePadding="@dimen/roomkit_size_6"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="@dimen/roomkit_size_10"
                        android:paddingVertical="@dimen/roomkit_size_5"
                        android:textSize="@dimen/roomkit_text_12"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_rd_status_dot"
                        tools:background="@drawable/bg_rd_badge_red"
                        tools:drawableTint="@color/roomkit_error"
                        tools:text="Overdue"
                        tools:textColor="@color/roomkit_error" />
                </LinearLayout>
            </LinearLayout>

            <!-- Outstanding Balance -->
            <TextView
                style="@style/TextAppearance.RoomKit.Caption.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_16"
                android:text="@string/rr_balance" />

            <TextView
                android:id="@+id/tvReminderBalance"
                style="@style/TextAppearance.RoomKit.Body.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_spacing_xs"
                android:fontFamily="sans-serif-medium"
                android:textSize="@dimen/roomkit_text_29"
                android:textStyle="bold"
                tools:text="400,000 ៛" />

            <!-- Due Date & Next Trigger Schedule Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_16"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.RoomKit.Caption.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rr_due_label" />

                    <TextView
                        android:id="@+id/tvReminderDue"
                        style="@style/TextAppearance.RoomKit.Body.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_spacing_xs"
                        android:textSize="@dimen/roomkit_text_13"
                        tools:text="Nov 5, 2026" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/roomkit_stroke_width"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/roomkit_button_radius_compact"
                    android:background="@color/roomkit_border" />

                <LinearLayout
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.25"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.RoomKit.Caption.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rr_next_label" />

                    <TextView
                        android:id="@+id/tvReminderNext"
                        style="@style/TextAppearance.RoomKit.Body.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_spacing_xs"
                        android:textSize="@dimen/roomkit_text_13"
                        tools:text="Nov 2 · 9:00 AM" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_stroke_width"
            android:background="@color/roomkit_border" />

        <!-- Open Invoice Action Row -->
        <LinearLayout
            android:id="@+id/btnOpenReminderInvoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/rr_open"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/roomkit_action_height"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/roomkit_size_16"
            android:paddingVertical="@dimen/roomkit_size_12">

            <ImageView
                android:layout_width="@dimen/roomkit_size_22"
                android:layout_height="@dimen/roomkit_size_22"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_billing" />

            <TextView
                style="@style/TextAppearance.RoomKit.Body.Primary"
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/roomkit_size_12"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:text="@string/rr_open"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="@dimen/roomkit_card_radius_medium"
                android:layout_height="@dimen/roomkit_card_radius_medium"
                android:importantForAccessibility="no"
                android:src="@drawable/ref_chvron"
                app:tint="@color/roomkit_text_secondary" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>