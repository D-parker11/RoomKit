<?xml version="1.0" encoding="utf-8"?>
<com.example.roomkit.Date.Ui.Common.BoundedDialogLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/roomkit_size_0"
        android:layout_weight="1"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/roomkit_size_24">
            <TextView
                android:id="@+id/reviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.RoomKit.SectionTitle" />
            <TextView
                android:id="@+id/reviewDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_8"
                android:textAppearance="@style/TextAppearance.RoomKit.Body" />
            <LinearLayout
                android:id="@+id/reviewSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/roomkit_stroke_width"
        android:layout_marginHorizontal="@dimen/roomkit_size_24"
        android:background="@color/roomkit_divider" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/roomkit_size_24"
        android:paddingTop="@dimen/roomkit_size_12"
        android:paddingEnd="@dimen/roomkit_size_24"
        android:paddingBottom="@dimen/roomkit_size_16">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewConfirm"
            style="@style/Widget.RoomKit.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0"
            android:singleLine="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewCancel"
            style="@style/Widget.RoomKit.Button.TextMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_spacing_xs"
            android:singleLine="false"
            android:text="@android:string/cancel" />
    </LinearLayout>
</com.example.roomkit.Date.Ui.Common.BoundedDialogLayout>
