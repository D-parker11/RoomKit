<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/roomkit_size_24"
        android:paddingTop="@dimen/roomkit_size_20"
        android:paddingBottom="@dimen/roomkit_size_12">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/roomkit_touch_target"
            android:layout_height="@dimen/roomkit_touch_target"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mu_roomkit_back"
            android:padding="@dimen/roomkit_size_8"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/roomkit_primary" />

        <TextView
            style="@style/TextAppearance.RoomKit.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/roomkit_size_12"
            android:layout_toEndOf="@id/btnBack"
            android:text="@string/mu_move_out_title"
            android:textColor="@color/roomkit_text_primary"
            android:textSize="@dimen/roomkit_text_22" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/roomkit_size_0"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/roomkit_bottom_safe_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/roomkit_size_24"
            android:paddingTop="@dimen/roomkit_size_8"
            android:paddingBottom="@dimen/roomkit_size_24">

            <!-- Dynamic Messages / Alerts -->
            <TextView
                android:id="@+id/tvExistingInvoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/roomkit_size_12"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSavedSettlement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/roomkit_size_12"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnReloadMoveOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/roomkit_size_12"
                android:text="@string/mu_reload"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvMoveOutMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/roomkit_size_12"
                android:visibility="gone" />

            <!-- Rental Summary Section -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/roomkit_size_8"
                android:text="@string/mu_section_rental_summary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/roomkit_size_16"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <TextView
                        android:id="@+id/tvSummaryTenantName"
                        style="@style/TextAppearance.RoomKit.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_18"
                        android:textStyle="bold"
                        tools:text="Davith Sok" />

                    <TextView
                        android:id="@+id/tvSummaryRoomBuilding"
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_spacing_xs"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_14"
                        tools:text="Room 01 · Barce Residence" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/roomkit_stroke_width"
                        android:layout_marginVertical="@dimen/roomkit_size_12"
                        android:background="@color/roomkit_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.RoomKit.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mu_label_deposit_held"
                                android:textColor="@color/roomkit_text_muted"
                                android:textSize="@dimen/roomkit_text_12" />

                            <TextView
                                android:id="@+id/tvSummaryDeposit"
                                style="@style/TextAppearance.RoomKit.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                                android:textColor="@color/roomkit_text_primary"
                                android:textSize="@dimen/roomkit_text_16"
                                android:textStyle="bold"
                                tools:text="800,000៛" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.RoomKit.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mu_label_unpaid_balance"
                                android:textColor="@color/roomkit_text_muted"
                                android:textSize="@dimen/roomkit_text_12" />

                            <TextView
                                android:id="@+id/tvSummaryUnpaidBalance"
                                style="@style/TextAppearance.RoomKit.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                                android:textColor="@color/roomkit_error_dark"
                                android:textSize="@dimen/roomkit_text_16"
                                android:textStyle="bold"
                                tools:text="0៛" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Move-Out Date Section -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_20"
                android:layout_marginBottom="@dimen/roomkit_size_8"
                android:text="@string/mu_section_move_out_date" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/roomkit_size_16"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMoveOutDate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/mu_hint_move_out_date"
                        app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:endIconMode="none">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMoveOutDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:inputType="date"
                            android:minHeight="@dimen/roomkit_control_height"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_15" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Final Meters Section -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_20"
                android:layout_marginBottom="@dimen/roomkit_size_8"
                android:text="@string/mu_section_final_meters" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/roomkit_size_16"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <!-- Electricity -->
                    <TextView
                        style="@style/TextAppearance.RoomKit.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mu_label_electricity_meter"
                        android:textColor="@color/roomkit_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvElecBilledBaseline"
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13"
                        tools:text="Last billed reading: 1,200 kWh" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFinalElectricity"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_10"
                        android:hint="@string/mu_hint_final_electricity_reading"
                        app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:suffixText="kWh">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFinalElectricity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:minHeight="@dimen/roomkit_control_height"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_15" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/roomkit_stroke_width"
                        android:layout_marginVertical="@dimen/roomkit_size_16"
                        android:background="@color/roomkit_divider" />

                    <!-- Water -->
                    <TextView
                        style="@style/TextAppearance.RoomKit.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mu_label_water_meter"
                        android:textColor="@color/roomkit_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWaterBilledBaseline"
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13"
                        tools:text="Last billed reading: 60 m³" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFinalWater"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_10"
                        android:hint="@string/mu_hint_final_water_reading"
                        app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:suffixText="m³">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFinalWater"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:minHeight="@dimen/roomkit_control_height"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_15" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvWaterFixedNote"
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_8"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13"
                        android:visibility="gone"
                        tools:text="Water is billed at fixed monthly rate (40,000៛ / mo)."
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Additional Charges Section -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_20"
                android:layout_marginBottom="@dimen/roomkit_size_8"
                android:text="@string/mu_section_additional_charges" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/roomkit_size_16"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <TextView
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/roomkit_size_12"
                        android:text="@string/mu_helper_additional_charges"
                        android:textColor="@color/roomkit_text_muted"
                        android:textSize="@dimen/roomkit_text_12" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilAdditionalRent"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/roomkit_size_6"
                            android:layout_weight="1"
                            android:hint="@string/mu_hint_additional_rent"
                            app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                            app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                            app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                            app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                            app:boxStrokeColor="@color/roomkit_primary"
                            app:prefixText="៛ ">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAdditionalRent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:minHeight="@dimen/roomkit_control_height"
                                android:textColor="@color/roomkit_text_primary"
                                android:textSize="@dimen/roomkit_text_15" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilOtherFees"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/roomkit_size_6"
                            android:layout_weight="1"
                            android:hint="@string/mu_hint_other_fees"
                            app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                            app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                            app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                            app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                            app:boxStrokeColor="@color/roomkit_primary"
                            app:prefixText="៛ ">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etOtherFees"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:minHeight="@dimen/roomkit_control_height"
                                android:textColor="@color/roomkit_text_primary"
                                android:textSize="@dimen/roomkit_text_15" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilChargeExplanation"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_12"
                        android:hint="@string/mu_hint_charge_explanation"
                        android:visibility="gone"
                        app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                        app:boxStrokeColor="@color/roomkit_primary"
                        tools:visibility="visible">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etChargeExplanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:minHeight="@dimen/roomkit_control_height"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_15" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Deposit Settlement Section -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_20"
                android:layout_marginBottom="@dimen/roomkit_size_8"
                android:text="@string/mu_section_deposit_settlement" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/roomkit_size_16"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <TextView
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/roomkit_size_12"
                        android:text="@string/mu_helper_deposit_allocation"
                        android:textColor="@color/roomkit_text_muted"
                        android:textSize="@dimen/roomkit_text_12" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDepositApplied"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/roomkit_size_16"
                        android:hint="@string/mu_apply_deposit"
                        app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:prefixText="៛ ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDepositApplied"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:minHeight="@dimen/roomkit_control_height" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDeductions"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/mu_hint_deposit_deductions"
                        app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:prefixText="៛ ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDeductions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:minHeight="@dimen/roomkit_control_height"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_15" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDeductionReason"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_12"
                        android:hint="@string/mu_hint_deduction_reason"
                        android:visibility="gone"
                        app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                        app:boxStrokeColor="@color/roomkit_primary"
                        tools:visibility="visible">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDeductionReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:minHeight="@dimen/roomkit_control_height"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_15" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Refund Paid Container -->
            <LinearLayout
                android:id="@+id/layoutRefundPaidContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <CheckBox
                    android:id="@+id/cbRefundPaid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mu_label_refund_paid_checkbox"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_14" />
            </LinearLayout>

            <!-- Review Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReviewSummary"
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_20"
                android:visibility="gone"
                app:cardBackgroundColor="@color/roomkit_surface_subtle"
                app:cardCornerRadius="@dimen/roomkit_size_16"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_primary"
                app:strokeWidth="@dimen/roomkit_size_1_5"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <TextView
                        style="@style/TextAppearance.RoomKit.ScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mu_title_settlement_review"
                        android:textColor="@color/roomkit_primary"
                        android:textSize="@dimen/roomkit_text_18" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/roomkit_stroke_width"
                        android:layout_marginVertical="@dimen/roomkit_size_12"
                        android:background="@color/roomkit_divider" />

                    <include
                        android:id="@+id/rowFinalInvoice"
                        layout="@layout/item_summary_row" />

                    <include
                        android:id="@+id/rowExistingDebt"
                        layout="@layout/item_summary_row" />

                    <include
                        android:id="@+id/rowDepositApplied"
                        layout="@layout/item_summary_row" />

                    <include
                        android:id="@+id/rowDeductions"
                        layout="@layout/item_summary_row" />

                    <include
                        android:id="@+id/rowRefundDue"
                        layout="@layout/item_summary_row" />

                    <include
                        android:id="@+id/rowDebtRemaining"
                        layout="@layout/item_summary_row" />

                    <TextView
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_12"
                        android:text="@string/mu_helper_remaining_debt_acknowledgement"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_12" />

                    <CheckBox
                        android:id="@+id/cbAcknowledge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/roomkit_touch_target"
                        android:text="@string/mu_ack" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/roomkit_white"
        android:elevation="@dimen/roomkit_size_8"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/roomkit_size_24"
        android:paddingTop="@dimen/roomkit_size_12"
        android:paddingBottom="@dimen/roomkit_size_20">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimaryAction"
            style="@style/Widget.RoomKit.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_control_height"
            android:text="@string/mu_action_review_settlement"
            android:textAllCaps="false"
            android:textColor="@color/roomkit_white"
            android:textSize="@dimen/roomkit_text_16"
            android:textStyle="bold"
            app:backgroundTint="@color/roomkit_primary"
            app:cornerRadius="@dimen/roomkit_card_radius_medium" />
    </LinearLayout>

</LinearLayout>