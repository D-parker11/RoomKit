<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/roomkit_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="@dimen/roomkit_size_12" android:background="@color/roomkit_white">
        <ImageButton android:id="@+id/settingsBack" android:layout_width="@dimen/roomkit_touch_target" android:layout_height="@dimen/roomkit_touch_target" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_arrow_back" android:contentDescription="@string/rks2_back" app:tint="@color/roomkit_text_primary" />
        <LinearLayout android:layout_width="@dimen/roomkit_size_0" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="@dimen/roomkit_size_8">
            <TextView android:id="@+id/pageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rks2_month" android:textColor="@color/roomkit_text_primary" android:textSize="@dimen/roomkit_text_26" android:textStyle="bold" android:accessibilityHeading="true" />
            <TextView android:id="@+id/pageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/roomkit_size_3" android:text="@string/rks2_month_subtitle" android:textColor="@color/roomkit_text_secondary" android:textSize="@dimen/roomkit_text_12" />
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="@dimen/roomkit_size_0" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/roomkit_size_20" android:paddingBottom="@dimen/roomkit_size_40">
            <LinearLayout android:id="@+id/toolsMonthlySection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView style="@style/Widget.RoomKit.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/roomkit_size_20">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rks2_review_title" android:textColor="@color/roomkit_text_primary" android:textSize="@dimen/roomkit_text_20" android:lineSpacingExtra="@dimen/roomkit_size_3" android:layout_marginBottom="@dimen/roomkit_size_12" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rks2_review_body" android:textColor="@color/roomkit_text_secondary" android:textSize="@dimen/roomkit_text_14" android:lineSpacingExtra="@dimen/roomkit_size_3" android:layout_marginBottom="@dimen/roomkit_size_12" />
                            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.RoomKit.Input.Settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/rks2_month_hint" android:layout_marginBottom="@dimen/roomkit_size_16">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/toolsMonth" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" android:maxLength="7" android:saveEnabled="false" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.button.MaterialButton android:id="@+id/toolsReview" style="@style/Widget.RoomKit.Button.OutlinedRounded" android:text="@string/rks2_review" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/toolsClose" style="@style/Widget.RoomKit.Button.Rounded" android:text="@string/rks2_close" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/toolsReopen" style="@style/Widget.RoomKit.Button.OutlinedRounded" android:text="@string/rks2_reopen" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rks2_reopen_note" android:textColor="@color/roomkit_text_secondary" android:textSize="@dimen/roomkit_text_12" android:lineSpacingExtra="@dimen/roomkit_size_3" android:layout_marginBottom="@dimen/roomkit_size_12" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:id="@+id/toolsBackupSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView style="@style/Widget.RoomKit.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/roomkit_size_20">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rks2_save_title" android:textColor="@color/roomkit_text_primary" android:textSize="@dimen/roomkit_text_20" android:lineSpacingExtra="@dimen/roomkit_size_3" android:layout_marginBottom="@dimen/roomkit_size_12" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rks2_save_body" android:textColor="@color/roomkit_text_secondary" android:textSize="@dimen/roomkit_text_14" android:lineSpacingExtra="@dimen/roomkit_size_3" android:layout_marginBottom="@dimen/roomkit_size_12" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/toolsExport" style="@style/Widget.RoomKit.Button.Rounded" android:text="@string/rks2_save_backup" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <Space android:layout_width="@dimen/roomkit_stroke_width" android:layout_height="@dimen/roomkit_size_16" />
                <com.google.android.material.card.MaterialCardView style="@style/Widget.RoomKit.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/roomkit_size_20">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rks2_restore_title" android:textColor="@color/roomkit_text_primary" android:textSize="@dimen/roomkit_text_20" android:lineSpacingExtra="@dimen/roomkit_size_3" android:layout_marginBottom="@dimen/roomkit_size_12" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rks2_restore_body" android:textColor="@color/roomkit_text_secondary" android:textSize="@dimen/roomkit_text_14" android:lineSpacingExtra="@dimen/roomkit_size_3" android:layout_marginBottom="@dimen/roomkit_size_12" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/toolsRestore" style="@style/Widget.RoomKit.Button.OutlinedRounded" android:text="@string/rks2_restore" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rks2_restore_warning" android:textColor="@color/roomkit_error" android:textSize="@dimen/roomkit_text_12" android:lineSpacingExtra="@dimen/roomkit_size_3" android:layout_marginBottom="@dimen/roomkit_size_12" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rks2_backup_note" android:textColor="@color/roomkit_text_secondary" android:textSize="@dimen/roomkit_text_12" android:lineSpacingExtra="@dimen/roomkit_size_3" android:layout_marginBottom="@dimen/roomkit_size_12" />
            </LinearLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/toolsProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" android:layout_marginTop="@dimen/roomkit_size_16" app:indicatorColor="@color/roomkit_text_primary" />
            <TextView android:id="@+id/toolsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/roomkit_size_16" android:padding="@dimen/roomkit_size_16" android:textColor="@color/roomkit_text_primary" android:textSize="@dimen/roomkit_text_13" android:lineSpacingExtra="@dimen/roomkit_spacing_xs" android:accessibilityLiveRegion="polite" android:visibility="gone" android:textIsSelectable="true" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>