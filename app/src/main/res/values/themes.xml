<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RoomKit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/roomkit_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/rko_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.RoomKit</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.RoomKit" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/roomkit_primary</item>
        <item name="colorPrimaryVariant">@color/roomkit_primary_dark</item>
        <item name="colorOnPrimary">@color/roomkit_white</item>
        <item name="android:colorBackground">@color/roomkit_background</item>
        <item name="colorSurface">@color/roomkit_white</item>
        <item name="colorOnSurface">@color/roomkit_text_primary</item>
        <item name="android:statusBarColor">@color/roomkit_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="ThemeOverlay.RoomKit.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.RoomKit.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.RoomKit.Button.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.RoomKit.Button.TextMedium</item>
    </style>
</resources>
