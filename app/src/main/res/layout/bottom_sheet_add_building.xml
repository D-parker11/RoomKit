<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/scrollForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false" android:clipToPadding="false" android:background="@drawable/rkp_sheet" android:focusableInTouchMode="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <View android:id="@+id/dragHandle" android:layout_width="32dp" android:layout_height="4dp" android:layout_marginTop="10dp" android:background="@drawable/rkp_handle" android:importantForAccessibility="no" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
            <ImageView android:id="@+id/propertyHeaderIcon" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="20dp" android:layout_marginTop="22dp" android:background="@drawable/rkp_icon_tile" android:padding="10dp" android:src="@drawable/rkp_building" android:importantForAccessibility="no" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/dragHandle" />
            <TextView android:id="@+id/tvBuildingTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:fontFamily="sans-serif-medium" android:text="@string/rk_property_setup" android:textSize="22sp" android:textColor="@color/rkp_text" android:accessibilityHeading="true" app:layout_constraintStart_toEndOf="@id/propertyHeaderIcon" app:layout_constraintEnd_toStartOf="@id/btnCloseAddBuilding" app:layout_constraintTop_toTopOf="@id/propertyHeaderIcon" app:layout_constraintBottom_toBottomOf="@id/propertyHeaderIcon" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnCloseAddBuilding" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:padding="14dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/rkp_close" android:contentDescription="@string/rk_property_close" app:tint="@color/rkp_muted" app:layout_constraintTop_toTopOf="@id/propertyHeaderIcon" app:layout_constraintEnd_toEndOf="parent" />
            <TextView android:id="@+id/tvBuildingSubtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="14dp" android:text="@string/rkp_intro" android:textSize="14sp" android:lineSpacingExtra="3dp" android:textColor="@color/rkp_muted" app:layout_constraintTop_toBottomOf="@id/tvBuildingTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="20dp">
            <TextView style="@style/RkpSection" android:text="@string/rk_property_details" />
            <com.google.android.material.card.MaterialCardView style="@style/RkpCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilBuildingName" style="@style/RkpInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/rk_property_name">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBuildingName" style="@style/RkpEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionNext" android:inputType="textCapWords" android:maxLines="1" android:minHeight="56dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView style="@style/RkpSection" android:text="@string/rk_property_location" />
            <com.google.android.material.card.MaterialCardView style="@style/RkpCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilStreetAddress" style="@style/RkpInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/rk_property_street">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etStreetAddress" style="@style/RkpEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionNext" android:inputType="textPostalAddress" android:maxLines="1" android:minHeight="56dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <View android:layout_width="match_parent" android:layout_height="12dp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilDistrict" style="@style/RkpDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/rk_property_district">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/actvDistrict" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="none" android:maxLines="1" style="@style/RkpEditText" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <View android:layout_width="match_parent" android:layout_height="12dp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilCity" style="@style/RkpInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/rk_property_city">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCity" style="@style/RkpEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionNext" android:inputType="textCapWords" android:maxLines="1" android:text="@string/rk_property_default_city" android:minHeight="56dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView style="@style/RkpSection" android:text="@string/rk_property_capacity" />
            <com.google.android.material.card.MaterialCardView style="@style/RkpCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilFloors" style="@style/RkpInput" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:layout_height="wrap_content" android:hint="@string/rk_property_floors">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFloors" style="@style/RkpEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionNext" android:inputType="number" android:maxLines="1" android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilTotalRooms" style="@style/RkpInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="@string/rk_property_room_capacity">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTotalRooms" style="@style/RkpEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionDone" android:inputType="number" android:maxLines="1" android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/tvCapacityHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/rkp_capacity_help" android:textColor="@color/rkp_muted" android:textSize="12sp" android:lineSpacingExtra="3dp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilContactPhone" style="@style/RkpInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/rk_property_phone" android:visibility="gone">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etContactPhone" style="@style/RkpEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionDone" android:inputType="phone" android:maxLines="1" android:minHeight="56dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:id="@+id/layoutBottomAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@android:color/transparent" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:layout_marginTop="20dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCreateBuilding" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="16dp" android:paddingBottom="16dp" android:text="@string/rk_property_create" android:textAllCaps="false" android:letterSpacing="0" android:fontFamily="sans-serif-medium" android:textSize="16sp" android:textColor="#FFFFFF" app:backgroundTint="@color/rkp_button" app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>