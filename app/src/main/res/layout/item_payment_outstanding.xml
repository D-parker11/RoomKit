<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.RoomKit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/roomkit_spacing_md"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/roomkit_card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal">

            <!-- Left Info Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/roomkit_spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDueDate"
                    style="@style/TextAppearance.RoomKit.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/roomkit_text_muted"
                    tools:text="Due Oct 5, 2026" />

                <TextView
                    android:id="@+id/tvTenantName"
                    style="@style/TextAppearance.RoomKit.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="17sp"
                    tools:text="Visal Nhem" />

                <TextView
                    android:id="@+id/tvRoomBuilding"
                    style="@style/TextAppearance.RoomKit.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="13sp"
                    tools:text="Room 103 · Campus Residence" />
            </LinearLayout>

            <!-- Right Balance Due & Status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRemainingBalance"
                    style="@style/TextAppearance.RoomKit.StatValue.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/roomkit_error"
                    android:textSize="22sp"
                    tools:text="400,000 ៛" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    style="@style/TextAppearance.RoomKit.Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    tools:background="@drawable/bg_badge_overdue_pill"
                    tools:text="Overdue"
                    tools:textColor="@color/roomkit_error_dark" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/roomkit_spacing_lg"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewInvoice"
                style="@style/Widget.RoomKit.Button.NeutralSurface"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/roomkit_spacing_xs"
                android:layout_weight="1"
                android:text="View Invoice" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordPayment"
                style="@style/Widget.RoomKit.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/roomkit_spacing_xs"
                android:layout_weight="1"
                android:text="Record Payment" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>