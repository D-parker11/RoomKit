<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollBuildings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:clipToPadding="false"
    android:descendantFocusability="beforeDescendants"
    android:fillViewport="true"
    android:paddingBottom="@dimen/roomkit_size_16">

    <LinearLayout
        android:id="@+id/propertyPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/roomkit_size_20"
        android:paddingTop="@dimen/roomkit_button_radius_compact"
        android:paddingBottom="@dimen/roomkit_size_16">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:text="@string/rp_title"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_30"
                android:textStyle="bold" />


        </LinearLayout>

        <!-- Main Property Content Container -->
        <LinearLayout
            android:id="@+id/propertyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: Property Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_card_radius_medium"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.10"
                        android:text="@string/rp_your_property"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_11"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_16"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/roomkit_size_64"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/roomkit_selected_soft"
                            app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
                            app:cardElevation="@dimen/roomkit_size_0"
                            app:strokeColor="@color/roomkit_border"
                            app:strokeWidth="@dimen/roomkit_size_0">

                            <ImageView
                                android:layout_width="@dimen/roomkit_size_32"
                                android:layout_height="@dimen/roomkit_size_32"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/roomkit_size_16"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_rp_building"
                                app:tint="@color/roomkit_text_primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/roomkit_size_16"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPropertyName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:textColor="@color/roomkit_text_primary"
                                android:textSize="@dimen/roomkit_text_25"
                                android:textStyle="bold"
                                tools:text="Proser" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/roomkit_size_7"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/roomkit_size_16"
                                    android:layout_height="@dimen/roomkit_size_16"
                                    android:layout_gravity="top"
                                    android:layout_marginTop="@dimen/roomkit_stroke_width"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_rr_pin"
                                    app:tint="@color/roomkit_text_primary" />

                                <TextView
                                    android:id="@+id/tvPropertyAddress"
                                    android:layout_width="@dimen/roomkit_size_0"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/roomkit_size_6"
                                    android:layout_weight="1"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false"
                                    android:textColor="@color/roomkit_text_secondary"
                                    android:textSize="@dimen/roomkit_text_13"
                                    tools:text="St. 305, Chamkarmon, Phnom Penh" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Room Overview Section Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_24"
                android:accessibilityHeading="true"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:text="@string/rp_room_overview"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_20"
                android:textStyle="bold" />

            <!-- 3-Column Metrics Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_button_radius_compact"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Metric 1: Total Rooms -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/roomkit_white"
                    app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
                    app:cardElevation="@dimen/roomkit_size_0"
                    app:strokeColor="@color/roomkit_border"
                    app:strokeWidth="@dimen/roomkit_stroke_width">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/roomkit_size_16">

                        <TextView
                            android:id="@+id/tvTotalRooms"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_28"
                            android:textStyle="bold"
                            tools:text="14" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_size_7"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:text="@string/rp_total_rooms"
                            android:textColor="@color/roomkit_text_secondary"
                            android:textSize="@dimen/roomkit_text_12" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Metric 2: Occupied Rooms -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/roomkit_size_12"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/roomkit_white"
                    app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
                    app:cardElevation="@dimen/roomkit_size_0"
                    app:strokeColor="@color/roomkit_border"
                    app:strokeWidth="@dimen/roomkit_stroke_width">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/roomkit_size_16">

                        <TextView
                            android:id="@+id/tvOccupiedRooms"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:textColor="@color/roomkit_success"
                            android:textSize="@dimen/roomkit_text_28"
                            android:textStyle="bold"
                            tools:text="13" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_size_7"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:text="@string/rp_occupied"
                            android:textColor="@color/roomkit_text_secondary"
                            android:textSize="@dimen/roomkit_text_12" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Metric 3: Vacant Rooms -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/roomkit_size_12"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/roomkit_white"
                    app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
                    app:cardElevation="@dimen/roomkit_size_0"
                    app:strokeColor="@color/roomkit_border"
                    app:strokeWidth="@dimen/roomkit_stroke_width">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/roomkit_size_16">

                        <TextView
                            android:id="@+id/tvVacantRooms"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:textColor="@color/roomkit_warning"
                            android:textSize="@dimen/roomkit_text_28"
                            android:textStyle="bold"
                            tools:text="1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_size_7"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:text="@string/rp_vacant"
                            android:textColor="@color/roomkit_text_secondary"
                            android:textSize="@dimen/roomkit_text_12" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Card 2: Occupancy Percentage -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_16"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:text="@string/rp_occupancy"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_16"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOccupancyPercent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_button_radius_compact"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_34"
                        android:textStyle="bold"
                        tools:text="93%" />

                    <TextView
                        android:id="@+id/tvOccupancyDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_7"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13"
                        tools:text="13 of 14 rooms occupied" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/occupancyProgress"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/roomkit_size_8"
                        android:layout_marginTop="@dimen/roomkit_size_16"
                        android:indeterminate="false"
                        android:max="100"
                        app:indicatorColor="@color/roomkit_text_primary"
                        app:trackColor="@color/roomkit_track"
                        app:trackCornerRadius="@dimen/roomkit_spacing_xs"
                        app:trackThickness="@dimen/roomkit_size_8" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: View Rooms Button Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnViewRooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_card_radius_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/roomkit_text_primary"
                app:cardCornerRadius="@dimen/roomkit_button_radius_compact"
                app:cardElevation="@dimen/roomkit_size_0"
                app:rippleColor="@color/roomkit_ripple"
                app:strokeWidth="@dimen/roomkit_size_0">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/roomkit_action_height"
                    android:paddingHorizontal="@dimen/roomkit_size_20"
                    android:paddingVertical="@dimen/roomkit_size_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="@dimen/roomkit_spacing_xxl"
                        android:text="@string/rp_view_rooms"
                        android:textColor="@color/roomkit_white"
                        android:textSize="@dimen/roomkit_text_16"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="@dimen/roomkit_size_22"
                        android:layout_height="@dimen/roomkit_size_22"
                        android:layout_gravity="end|center_vertical"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_rp_arrow"
                        app:tint="@color/roomkit_white" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Actions Section Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_22"
                android:accessibilityHeading="true"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:text="@string/rp_quick_actions"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_20"
                android:textStyle="bold" />

            <!-- Card 4: Quick Action Items -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_button_radius_compact"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Action: View Vacant Rooms -->
                    <LinearLayout
                        android:id="@+id/btnViewVacantRooms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:baselineAligned="false"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/roomkit_size_78"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/roomkit_card_radius_medium"
                        android:paddingVertical="@dimen/roomkit_size_16">

                        <ImageView
                            android:layout_width="@dimen/roomkit_size_26"
                            android:layout_height="@dimen/roomkit_size_26"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rr_bed"
                            app:tint="@color/roomkit_text_primary" />

                        <LinearLayout
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/roomkit_card_radius_medium"
                            android:layout_marginEnd="@dimen/roomkit_size_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:text="@string/rr_view_vacant"
                                android:textColor="@color/roomkit_text_primary"
                                android:textSize="@dimen/roomkit_text_16"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAvailability"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/roomkit_size_5"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:textColor="@color/roomkit_text_secondary"
                                android:textSize="@dimen/roomkit_text_13"
                                tools:text="1 room available" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/roomkit_card_radius_medium"
                            android:layout_height="@dimen/roomkit_card_radius_medium"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ref_chvron"
                            app:tint="@color/roomkit_text_secondary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/roomkit_stroke_width"
                        android:layout_marginHorizontal="@dimen/roomkit_card_radius_medium"
                        android:background="@color/roomkit_border" />

                    <!-- Action: Assign Tenant -->
                    <LinearLayout
                        android:id="@+id/btnAssignTenant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:baselineAligned="false"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/roomkit_size_78"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/roomkit_card_radius_medium"
                        android:paddingVertical="@dimen/roomkit_size_16">

                        <ImageView
                            android:layout_width="@dimen/roomkit_size_26"
                            android:layout_height="@dimen/roomkit_size_26"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rp_person_add"
                            app:tint="@color/roomkit_text_primary" />

                        <LinearLayout
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/roomkit_card_radius_medium"
                            android:layout_marginEnd="@dimen/roomkit_size_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:text="@string/rp_assign_tenant"
                                android:textColor="@color/roomkit_text_primary"
                                android:textSize="@dimen/roomkit_text_16"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAssignHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/roomkit_size_5"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:text="@string/rr_choose_vacant"
                                android:textColor="@color/roomkit_text_secondary"
                                android:textSize="@dimen/roomkit_text_13" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/roomkit_card_radius_medium"
                            android:layout_height="@dimen/roomkit_card_radius_medium"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ref_chvron"
                            app:tint="@color/roomkit_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Edit Property Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProperty"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_card_radius_medium"
                android:fontFamily="sans"
                android:insetTop="@dimen/roomkit_size_0"
                android:insetBottom="@dimen/roomkit_size_0"
                android:letterSpacing="0"
                android:minHeight="@dimen/roomkit_touch_target"
                android:stateListAnimator="@null"
                android:text="@string/rp_edit_property"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_16"
                android:textStyle="bold"
                app:backgroundTint="@color/roomkit_background"
                app:cornerRadius="@dimen/roomkit_size_12"
                app:elevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_text_secondary"
                app:strokeWidth="@dimen/roomkit_stroke_width" />
        </LinearLayout>

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_20"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_size_24">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:text="@string/rp_setup_title"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_22"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_12"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:text="@string/rp_setup_description"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_14" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetupProperty"
                        style="@style/Widget.RoomKit.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_20"
                        android:text="@string/rp_setup_button" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>