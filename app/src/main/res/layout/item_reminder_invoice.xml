<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/RRCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Content Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Room, Tenant & Status Badges Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReminderRoom"
                        style="@style/RRBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Room 09 · Proser" />

                    <TextView
                        android:id="@+id/tvReminderTenant"
                        style="@style/RRCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="GMengz · Invoice #0020" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvReminderPaymentBadge"
                        style="@style/RRCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="Unpaid" />

                    <TextView
                        android:id="@+id/tvReminderDueBadge"
                        style="@style/RRCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="Upcoming" />
                </LinearLayout>
            </LinearLayout>

            <!-- Outstanding Balance -->
            <TextView
                style="@style/RRCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/rr_balance" />

            <TextView
                android:id="@+id/tvReminderBalance"
                style="@style/RRBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="29sp"
                android:textStyle="bold"
                tools:text="400,000 ៛" />

            <!-- Due Date & Next Trigger Schedule Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RRCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rr_due_label" />

                    <TextView
                        android:id="@+id/tvReminderDue"
                        style="@style/RRBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        tools:text="Nov 5, 2026" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="14dp"
                    android:background="@color/rr_border" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.25"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RRCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rr_next_label" />

                    <TextView
                        android:id="@+id/tvReminderNext"
                        style="@style/RRBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        tools:text="Nov 2 · 9:00 AM" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rr_border" />

        <!-- Open Invoice Action Row -->
        <LinearLayout
            android:id="@+id/btnOpenReminderInvoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/rr_open"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_billing" />

            <TextView
                style="@style/RRBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:text="@string/rr_open"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ref_chvron"
                app:tint="@color/rr_muted" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>