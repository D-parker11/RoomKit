<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Row Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="@dimen/roomkit_size_80"
        android:orientation="horizontal"
        android:padding="@dimen/roomkit_size_16">

        <ImageView
            android:layout_width="@dimen/roomkit_size_24"
            android:layout_height="@dimen/roomkit_size_24"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_rd_door"
            app:tint="@color/roomkit_text_primary" />

        <LinearLayout
            android:layout_width="@dimen/roomkit_size_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/roomkit_button_radius_compact"
            android:layout_marginEnd="@dimen/roomkit_size_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAttentionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_16"
                android:textStyle="bold"
                tools:text="Room 01" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAttentionSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_spacing_xs"
                android:fontFamily="sans"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_13"
                tools:text="Payment unpaid" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAttentionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_rd_amber"
            android:fontFamily="sans"
            android:paddingHorizontal="@dimen/roomkit_size_10"
            android:paddingVertical="@dimen/roomkit_size_5"
            android:textColor="@color/roomkit_warning"
            android:textSize="@dimen/roomkit_text_12"
            android:textStyle="bold"
            tools:text="Unpaid" />

        <ImageView
            android:layout_width="@dimen/roomkit_card_radius_medium"
            android:layout_height="@dimen/roomkit_card_radius_medium"
            android:layout_marginStart="@dimen/roomkit_size_10"
            android:importantForAccessibility="no"
            android:src="@drawable/ref_chvron"
            app:tint="@color/roomkit_text_secondary" />
    </LinearLayout>

    <!-- Row Divider -->
    <View
        android:id="@+id/rowDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/roomkit_stroke_width"
        android:layout_marginHorizontal="@dimen/roomkit_size_16"
        android:background="@color/roomkit_border" />

</LinearLayout>