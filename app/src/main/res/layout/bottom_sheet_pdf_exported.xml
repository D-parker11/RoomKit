<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/roomkit_white"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                app:cardBackgroundColor="@color/roomkit_border"
                app:cardCornerRadius="2dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/rk_pdf_ready_title"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_24" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/rk_pdf_ready_description"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_14" />

            <!-- Invoice context -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/roomkit_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/invoice_detail_pdf_label"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_11" />

                    <TextView
                        android:id="@+id/tvInvoiceContext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_15" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenPdf"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:text="@string/invoice_detail_open_pdf"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_white"
                android:textSize="@dimen/roomkit_text_16"
                app:backgroundTint="@color/roomkit_primary"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrintPdf"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:text="@string/rk_pdf_print_invoice"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_16"
                app:backgroundTint="@color/roomkit_white"
                app:cornerRadius="16dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:letterSpacing="0"
                android:text="@string/invoice_detail_done"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_14"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>