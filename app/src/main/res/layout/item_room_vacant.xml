<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.RoomKit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/roomkit_size_12"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/roomkit_size_20">

        <!-- Top Header: Room Number, Vacant Badge, and Chevron -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRoomNumber"
                style="@style/TextAppearance.RoomKit.SectionTitle"
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/roomkit_text_18"
                tools:text="ROOM 02" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/TextAppearance.RoomKit.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rd_badge_neutral"
                android:drawablePadding="@dimen/roomkit_size_6"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingHorizontal="@dimen/roomkit_size_10"
                android:paddingVertical="@dimen/roomkit_size_5"
                android:text="Vacant"
                android:textColor="@color/roomkit_slate_500"
                android:textSize="@dimen/roomkit_text_12"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_rd_status_dot"
                app:drawableTint="@color/roomkit_slate_500" />

            <ImageView
                android:layout_width="@dimen/roomkit_card_radius_medium"
                android:layout_height="@dimen/roomkit_card_radius_medium"
                android:layout_marginStart="@dimen/roomkit_size_8"
                android:contentDescription="Open details"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/roomkit_text_muted" />
        </LinearLayout>

        <!-- Subtitle & Rent -->
        <TextView
            style="@style/TextAppearance.RoomKit.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_spacing_xs"
            android:text="No active tenant"
            android:textColor="@color/roomkit_text_muted" />

        <TextView
            android:id="@+id/tvMonthlyRent"
            style="@style/TextAppearance.RoomKit.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
            android:textColor="@color/roomkit_text_secondary"
            tools:text="400,000 ៛" />

        <!-- Assign Tenant Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAssignTenant"
            style="@style/Widget.RoomKit.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_touch_target"
            android:layout_marginTop="@dimen/roomkit_size_16"
            android:text="Assign Tenant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>