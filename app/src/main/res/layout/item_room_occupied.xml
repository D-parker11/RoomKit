<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.RoomKit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/roomkit_size_12"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/roomkit_size_20">

        <!-- Top Header: Room Number, Occupied Badge, and Chevron -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRoomNumber"
                style="@style/TextAppearance.RoomKit.SectionTitle"
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/roomkit_text_18"
                tools:text="ROOM 01" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/TextAppearance.RoomKit.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rd_badge_green"
                android:drawablePadding="@dimen/roomkit_size_6"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingHorizontal="@dimen/roomkit_size_10"
                android:paddingVertical="@dimen/roomkit_size_5"
                android:text="Occupied"
                android:textColor="@color/roomkit_green_700"
                android:textSize="@dimen/roomkit_text_12"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_rd_status_dot"
                app:drawableTint="@color/roomkit_green_700" />

            <ImageView
                android:layout_width="@dimen/roomkit_card_radius_medium"
                android:layout_height="@dimen/roomkit_card_radius_medium"
                android:layout_marginStart="@dimen/roomkit_size_8"
                android:contentDescription="Open details"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/roomkit_text_muted" />
        </LinearLayout>

        <!-- Tenant Name & Monthly Rent -->
        <TextView
            android:id="@+id/tvTenantName"
            style="@style/TextAppearance.RoomKit.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_spacing_xs"
            android:textColor="@color/roomkit_text_primary"
            android:textSize="@dimen/roomkit_text_16"
            android:textStyle="bold"
            tools:text="Davith Sok" />

        <TextView
            android:id="@+id/tvMonthlyRent"
            style="@style/TextAppearance.RoomKit.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
            android:textColor="@color/roomkit_text_secondary"
            tools:text="400,000 ៛" />

        <!-- Utility Readings Container (Structured 2 Columns) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_12"
            android:background="@color/roomkit_slate_50"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/roomkit_size_12"
            android:paddingVertical="@dimen/roomkit_size_10">

            <!-- Electricity -->
            <LinearLayout
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/roomkit_size_16"
                    android:layout_height="@dimen/roomkit_size_16"
                    android:contentDescription="Electricity"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/roomkit_text_muted" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/roomkit_size_8"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Electricity"
                        android:textSize="@dimen/roomkit_text_11" />

                    <TextView
                        android:id="@+id/tvElectricityUsage"
                        style="@style/TextAppearance.RoomKit.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_13"
                        android:textStyle="bold"
                        tools:text="140 kWh" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="@dimen/roomkit_stroke_width"
                android:layout_height="@dimen/roomkit_size_24"
                android:layout_gravity="center_vertical"
                android:background="@color/roomkit_divider" />

            <!-- Water -->
            <LinearLayout
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/roomkit_size_12"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/roomkit_size_16"
                    android:layout_height="@dimen/roomkit_size_16"
                    android:contentDescription="Water"
                    android:src="@drawable/ic_water"
                    app:tint="@color/roomkit_text_muted" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/roomkit_size_8"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Water"
                        android:textSize="@dimen/roomkit_text_11" />

                    <TextView
                        android:id="@+id/tvWaterUsage"
                        style="@style/TextAppearance.RoomKit.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_13"
                        android:textStyle="bold"
                        tools:text="12 m³" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Footer Divider & Payment / Due Day Status -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_stroke_width"
            android:layout_marginTop="@dimen/roomkit_button_radius_compact"
            android:background="@color/roomkit_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_10"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDueDay"
                style="@style/TextAppearance.RoomKit.Caption"
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/roomkit_text_secondary"
                tools:text="Due on day 5" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvInvoiceStatusBadge"
                style="@style/TextAppearance.RoomKit.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rd_badge_green"
                android:drawablePadding="@dimen/roomkit_size_6"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingHorizontal="@dimen/roomkit_size_10"
                android:paddingVertical="@dimen/roomkit_size_5"
                android:textColor="@color/roomkit_green_700"
                android:textSize="@dimen/roomkit_text_12"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_rd_status_dot"
                app:drawableTint="@color/roomkit_green_700"
                tools:text="Occupied" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>