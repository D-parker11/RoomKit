<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:orientation="vertical">

    <!-- Top Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/roomkit_surface"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnBackMoveIn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/roomkit_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/btnBackMoveIn"
            android:gravity="start|center_vertical"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.RoomKit.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Move in tenant"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="24sp" />

            <TextView
                style="@style/TextAppearance.RoomKit.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Choose a room and review the rental terms"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Scrollable Form Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMoveIn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Error Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/roomkit_error_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:padding="14dp"
                    android:textColor="@color/roomkit_error_dark"
                    android:textSize="13sp"
                    tools:text="Please complete all required fields." />
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 01: Tenant and Room -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0"
                android:text="01  Tenant and room"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Tenant Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTenant"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tenant"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:endIconContentDescription="Choose an available tenant"
                        app:endIconDrawable="@drawable/mtrl_dropdown_arrow"
                        app:endIconMode="custom"
                        app:hintTextColor="@color/roomkit_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/actvTenant"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:maxLines="2"
                            android:minHeight="58dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:singleLine="false"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Property Dropdown -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBuilding"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Property"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/roomkit_text_secondary">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvBuilding"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:maxLines="2"
                            android:minHeight="58dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:singleLine="false"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Room Dropdown -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRoom"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Vacant room"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/roomkit_text_secondary">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvRoom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:maxLines="2"
                            android:minHeight="58dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:singleLine="false"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Move-In Date Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMoveInDate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Move-In Date"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:endIconDrawable="@drawable/ic_calender"
                        app:endIconMode="custom"
                        app:helperText="The date this tenancy starts"
                        app:hintTextColor="@color/roomkit_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMoveInDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:minHeight="58dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 02: Rent and Deposit -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0"
                android:text="02  Rent and deposit"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMonthlyRent"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Monthly Rent"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:helperText="Whole Cambodian riel per month"
                        app:hintTextColor="@color/roomkit_text_secondary"
                        app:prefixText="៛ ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMonthlyRent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1"
                            android:minHeight="58dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDeposit"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Deposit"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:helperText="Enter 0 if no deposit is held"
                        app:hintTextColor="@color/roomkit_text_secondary"
                        app:prefixText="៛ ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDeposit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1"
                            android:minHeight="58dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 03: Billing Schedule -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0"
                android:text="03  Billing schedule"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:weightSum="2">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBillingDay"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Billing Day"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:helperText="Billing cycle starts on day 1–31"
                        app:hintTextColor="@color/roomkit_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBillingDay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="2"
                            android:maxLines="1"
                            android:minHeight="58dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDueDay"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Due Day"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:helperText="Payment due: day 1–28"
                        app:hintTextColor="@color/roomkit_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDueDay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="2"
                            android:maxLines="1"
                            android:minHeight="58dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 04: Utility Rates -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0"
                android:text="04  Utility rates"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilElectricityRate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Electricity Rate"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/roomkit_text_secondary"
                        app:suffixText="៛ / kWh">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etElectricityRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1"
                            android:minHeight="58dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Water Billing Method"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgWaterMethod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <RadioButton
                            android:id="@+id/rbWaterFixed"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:checked="true"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:text="Fixed monthly"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="13sp"
                            app:buttonTint="@color/roomkit_primary" />

                        <RadioButton
                            android:id="@+id/rbWaterMetered"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:text="Metered (m³)"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="13sp"
                            app:buttonTint="@color/roomkit_primary" />
                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWaterFee"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Water Fee"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/roomkit_text_secondary"
                        app:suffixText="៛ / month">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaterFee"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1"
                            android:minHeight="58dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWaterRate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Water Rate"
                        android:visibility="gone"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/roomkit_text_secondary"
                        app:suffixText="៛ / m³">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaterRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1"
                            android:minHeight="58dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRubbishFee"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Rubbish / Waste Fee"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/roomkit_text_secondary"
                        app:suffixText="៛ / month">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRubbishFee"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1"
                            android:minHeight="58dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 05: Opening Meter Readings -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0"
                android:text="05  Opening meter readings"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="These are the starting readings for this tenancy."
                        android:textColor="@color/roomkit_text_muted"
                        android:textSize="12sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilInitialElectricity"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Initial Electricity Reading"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:helperText="Use the meter value at move-in"
                        app:hintTextColor="@color/roomkit_text_secondary"
                        app:suffixText="kWh">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etInitialElectricity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1"
                            android:minHeight="58dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilInitialWater"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Initial Water Reading"
                        android:visibility="gone"
                        app:boxBackgroundColor="@color/roomkit_surface"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/roomkit_text_secondary"
                        app:suffixText="m³">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etInitialWater"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1"
                            android:minHeight="58dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/roomkit_surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="@color/roomkit_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmMoveIn"
            style="@style/Widget.RoomKit.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:letterSpacing="0"
            android:text="Review move-in"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />
    </LinearLayout>

</LinearLayout>