<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rd_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/roomkit_bottom_safe_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Header: Greeting, Title & Property Name -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:textColor="@color/rd_muted"
            android:textSize="14sp"
            tools:text="Good afternoon" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityHeading="true"
            android:fontFamily="sans"
            android:text="@string/rd_overview"
            android:textColor="@color/rd_ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPropertyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans"
            android:textColor="@color/rd_muted"
            android:textSize="16sp"
            tools:text="Proser" />

        <!-- Dashboard Loading Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/loadingDashboard"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="24dp"
            android:indeterminate="true"
            app:indicatorColor="@color/rd_ink" />

        <!-- Main Dashboard Content -->
        <LinearLayout
            android:id="@+id/dashboardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Card 1: Period & Financial Overview -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/rd_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/rd_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Period Title & Month Selector Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPeriodTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/dm_this_month"
                            android:textColor="@color/rd_ink"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tvMonthYear"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:letterSpacing="0"
                            android:minHeight="48dp"
                            android:text="@string/dm_choose_month"
                            android:textAllCaps="false"
                            android:textColor="@color/rd_ink"
                            android:textSize="14sp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_calender"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp"
                            app:iconSize="20dp"
                            app:iconTint="@color/rd_ink"
                            app:strokeColor="@color/rd_border" />
                    </LinearLayout>

                    <!-- Outstanding Total -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans"
                        android:text="@string/rd_outstanding"
                        android:textColor="@color/rd_muted"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvOutstandingAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans"
                        android:maxLines="1"
                        android:textColor="@color/rd_ink"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="30sp"
                        app:autoSizeMinTextSize="18sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        tools:text="1,746,000 KHR" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/rd_border" />

                    <!-- Billed vs Collected 2-Column Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="12dp">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:text="@string/rd_billed"
                                android:textColor="@color/rd_muted"
                                android:textSize="14sp" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvBilledAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="sans"
                                android:maxLines="1"
                                android:textColor="@color/rd_ink"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="18sp"
                                app:autoSizeMinTextSize="11sp"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeTextType="uniform"
                                tools:text="1,746,000 KHR" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="44dp"
                            android:background="@color/rd_border" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="16dp">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:text="@string/rd_collected"
                                android:textColor="@color/rd_muted"
                                android:textSize="14sp" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvCollectedAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="sans"
                                android:maxLines="1"
                                android:textColor="@color/rd_green"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="18sp"
                                app:autoSizeMinTextSize="11sp"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeTextType="uniform"
                                tools:text="0 KHR" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Collection Progress Bar & Label -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/collectionProgress"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="22dp"
                        android:indeterminate="false"
                        android:max="100"
                        app:indicatorColor="@color/rd_green"
                        app:trackColor="@color/rd_track"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCollectionPercent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans"
                        android:textColor="@color/rd_muted"
                        android:textSize="13sp"
                        tools:text="0% collected" />

                    <!-- Invoice Status Badges Carousel -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvUnpaidCountLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/ic_rd_amber"
                                android:fontFamily="sans"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="7dp"
                                android:textColor="@color/rd_amber"
                                android:textSize="13sp"
                                tools:text="2 unpaid" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPartialCountLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/ic_rd_amber"
                                android:fontFamily="sans"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="7dp"
                                android:textColor="@color/rd_amber"
                                android:textSize="13sp"
                                android:visibility="gone"
                                tools:text="1 partial" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvOverdueCountLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_rd_green"
                                android:fontFamily="sans"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="7dp"
                                android:textColor="@color/rd_green"
                                android:textSize="13sp"
                                tools:text="0 overdue" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Rooms & Occupancy Summary -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/rd_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/rd_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans"
                            android:text="@string/dm_rooms_now"
                            android:textColor="@color/rd_ink"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewProperty"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp"
                            android:text="@string/rd_view_property"
                            android:textAllCaps="false"
                            android:textColor="@color/rd_muted"
                            android:textSize="14sp"
                            app:icon="@drawable/ref_chvron"
                            app:iconGravity="textEnd"
                            app:iconPadding="6dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/rd_muted" />
                    </LinearLayout>

                    <!-- 3-Column Rooms Metric Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Metric: Total -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvTotalRoomsCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:textColor="@color/rd_ink"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="14" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans"
                                android:text="@string/rd_total"
                                android:textColor="@color/rd_muted"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="42dp"
                            android:background="@color/rd_border" />

                        <!-- Metric: Occupied -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvOccupiedRoomsCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:textColor="@color/rd_ink"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="14" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans"
                                android:text="@string/rd_occupied"
                                android:textColor="@color/rd_muted"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="42dp"
                            android:background="@color/rd_border" />

                        <!-- Metric: Vacant -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvVacantRoomsCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans"
                                android:textColor="@color/rd_ink"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="14" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans"
                                android:text="@string/rd_vacant"
                                android:textColor="@color/rd_muted"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Occupancy Progress Indicator -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvOccupancyPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:fontFamily="sans"
                            android:textColor="@color/rd_muted"
                            android:textSize="13sp"
                            tools:text="93% occupancy" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/occupancyProgress"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:indeterminate="false"
                            android:max="100"
                            app:indicatorColor="@color/rd_ink"
                            app:trackColor="@color/rd_track"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Needs Attention Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:fontFamily="sans"
                    android:text="@string/rd_needs_attention"
                    android:textColor="@color/rd_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewAllAttention"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="0dp"
                    android:text="@string/rd_view_all"
                    android:textAllCaps="false"
                    android:textColor="@color/rd_muted"
                    android:textSize="14sp"
                    app:icon="@drawable/ref_chvron"
                    app:iconGravity="textEnd"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/rd_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAttentionPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textColor="@color/rd_muted"
                android:textSize="12sp" />

            <!-- Attention Rows Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/attentionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/rd_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/rd_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/attentionRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Attention Empty State Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tvEmptyAttention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/rd_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/rd_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:text="@string/rd_all_caught_up"
                        android:textColor="@color/rd_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans"
                        android:text="@string/rd_no_attention"
                        android:textColor="@color/rd_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>