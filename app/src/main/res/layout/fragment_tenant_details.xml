<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/roomkit_size_16"
        android:paddingTop="@dimen/roomkit_button_radius_compact"
        android:paddingBottom="@dimen/roomkit_size_10">

        <ImageButton
            android:id="@+id/btnBackTenantDetails"
            android:layout_width="@dimen/roomkit_size_36"
            android:layout_height="@dimen/roomkit_size_36"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/roomkit_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/roomkit_size_8"
            android:layout_toEndOf="@id/btnBackTenantDetails"
            android:text="Tenant Details"
            android:textColor="@color/roomkit_text_primary"
            android:textSize="@dimen/roomkit_text_18"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/roomkit_size_16"
            android:paddingBottom="@dimen/roomkit_size_40">

            <!-- Profile Overview Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_stroke"
                android:orientation="vertical"
                android:padding="@dimen/roomkit_size_16">

                <TextView
                    android:id="@+id/tvDetailsFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_20"
                    android:textStyle="bold"
                    tools:text="Sokha Chan" />

                <TextView
                    android:id="@+id/tvDetailsPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_spacing_xs"
                    android:textColor="@color/roomkit_gray_500"
                    android:textSize="@dimen/roomkit_text_14"
                    tools:text="+855 12 345 678" />

                <TextView
                    android:id="@+id/tvDetailsIdOrPassport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                    android:textColor="@color/roomkit_gray_400"
                    android:textSize="@dimen/roomkit_text_12"
                    tools:text="ID: N12345678" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditTenant"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_12"
                android:fontFamily="sans-serif-medium"
                android:insetTop="@dimen/roomkit_size_0"
                android:insetBottom="@dimen/roomkit_size_0"
                android:letterSpacing="0"
                android:minHeight="@dimen/roomkit_size_50"
                android:text="@string/qa_edit_tenant"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_14"
                android:textStyle="bold"
                app:backgroundTint="@color/roomkit_white"
                app:cornerRadius="@dimen/roomkit_size_16"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/roomkit_size_8"
                app:iconSize="@dimen/roomkit_card_radius_medium"
                app:iconTint="@color/roomkit_text_primary"
                app:rippleColor="@color/roomkit_border"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width" />

            <!-- Current Tenancy Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_20"
                android:text="Current Tenancy"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_16"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutActiveTenancyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_8"
                android:background="@drawable/bg_card_stroke"
                android:orientation="vertical"
                android:padding="@dimen/roomkit_size_16">

                <TextView
                    android:id="@+id/tvActiveBuildingRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_16"
                    android:textStyle="bold"
                    tools:text="Campus Residence A • Room 101" />

                <TextView
                    android:id="@+id/tvActiveRentDeposit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_size_6"
                    android:textColor="@color/roomkit_gray_600"
                    android:textSize="@dimen/roomkit_text_13"
                    tools:text="Rent: 1,000,000 KHR • Deposit: 1,000,000 KHR" />

                <TextView
                    android:id="@+id/tvActiveMoveInDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_spacing_xs"
                    android:textColor="@color/roomkit_gray_500"
                    android:textSize="@dimen/roomkit_text_13"
                    tools:text="Moved in: 29 Sep 2026" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/roomkit_size_40"
                    android:layout_marginTop="@dimen/roomkit_button_radius_compact"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAssignedRoom"
                        android:layout_width="@dimen/roomkit_size_0"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/roomkit_size_6"
                        android:layout_weight="1"
                        android:backgroundTint="@color/roomkit_gray_100"
                        android:insetTop="@dimen/roomkit_size_0"
                        android:insetBottom="@dimen/roomkit_size_0"
                        android:text="View Room"
                        android:textAllCaps="false"
                        android:textColor="@color/roomkit_text_primary"
                        app:cornerRadius="@dimen/roomkit_size_10" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMoveOutTenant"
                        android:layout_width="@dimen/roomkit_size_0"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/roomkit_size_6"
                        android:layout_weight="1"
                        android:backgroundTint="@color/roomkit_red_100"
                        android:insetTop="@dimen/roomkit_size_0"
                        android:insetBottom="@dimen/roomkit_size_0"
                        android:text="Move Out"
                        android:textAllCaps="false"
                        android:textColor="@color/roomkit_red_600"
                        app:cornerRadius="@dimen/roomkit_size_10" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoActiveTenancy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_8"
                android:background="@drawable/bg_card_stroke"
                android:padding="@dimen/roomkit_size_16"
                android:text="No active tenancy. Tenant is not assigned to any room."
                android:textColor="@color/roomkit_gray_500"
                android:textSize="@dimen/roomkit_text_14"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAssignRoom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/roomkit_size_44"
                android:layout_marginTop="@dimen/roomkit_size_10"
                android:backgroundTint="@color/roomkit_text_primary"
                android:text="Assign Room"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_white"
                android:visibility="gone"
                app:cornerRadius="@dimen/roomkit_size_10" />

            <!-- Rental History Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_24"
                android:text="Rental History"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_16"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTenancyHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_8"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>