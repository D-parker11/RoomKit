<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/roomkit_white"
    app:cardCornerRadius="@dimen/roomkit_size_24"
    app:cardElevation="@dimen/roomkit_size_0"
    app:strokeWidth="@dimen/roomkit_size_0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/roomkit_size_12"
        android:paddingBottom="@dimen/roomkit_size_24">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/roomkit_size_36"
            android:layout_height="@dimen/roomkit_spacing_xs"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            app:cardBackgroundColor="@color/roomkit_border"
            app:cardCornerRadius="@dimen/roomkit_stroke_width_focused"
            app:cardElevation="@dimen/roomkit_size_0"
            app:strokeWidth="@dimen/roomkit_size_0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_12"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/roomkit_size_24"
            android:paddingEnd="@dimen/roomkit_size_12">

            <TextView
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/rk_room_detail_manage"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_22" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/roomkit_touch_target"
                android:minWidth="@dimen/roomkit_size_64"
                android:letterSpacing="0"
                android:text="@string/rk_room_detail_cancel"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_secondary"
                app:cornerRadius="@dimen/roomkit_size_24" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTenancyContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/roomkit_size_24"
            android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
            android:layout_marginBottom="@dimen/roomkit_size_20"
            android:textColor="@color/roomkit_text_secondary"
            android:textSize="@dimen/roomkit_text_14" />

        <LinearLayout
            android:id="@+id/actionViewProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/roomkit_size_84"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/roomkit_size_24"
            android:paddingVertical="@dimen/roomkit_size_16">

            <LinearLayout
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/rk_room_detail_profile"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_16" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_size_5"
                    android:lineSpacingExtra="@dimen/roomkit_stroke_width_focused"
                    android:text="@string/rk_manage_profile_description"
                    android:textColor="@color/roomkit_text_secondary"
                    android:textSize="@dimen/roomkit_text_13" />
            </LinearLayout>

            <TextView
                android:layout_width="@dimen/roomkit_size_24"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/roomkit_size_12"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="›"
                android:textColor="@color/roomkit_text_muted"
                android:textSize="@dimen/roomkit_text_28" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_stroke_width"
            android:layout_marginHorizontal="@dimen/roomkit_size_24"
            android:background="@color/roomkit_divider" />

        <LinearLayout
            android:id="@+id/actionMoveOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/roomkit_size_84"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/roomkit_size_24"
            android:paddingVertical="@dimen/roomkit_size_16">

            <LinearLayout
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/rk_room_detail_move_out"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_16" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_size_5"
                    android:lineSpacingExtra="@dimen/roomkit_stroke_width_focused"
                    android:text="@string/rk_manage_move_out_description"
                    android:textColor="@color/roomkit_text_secondary"
                    android:textSize="@dimen/roomkit_text_13" />
            </LinearLayout>

            <TextView
                android:layout_width="@dimen/roomkit_size_24"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/roomkit_size_12"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="›"
                android:textColor="@color/roomkit_text_muted"
                android:textSize="@dimen/roomkit_text_28" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>