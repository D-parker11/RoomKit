<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:orientation="vertical">

    <!-- =========================================================
         HEADER
         ========================================================= -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/roomkit_surface"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnBackMoveIn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/roomkit_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.RoomKit.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Move In Tenant"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="22sp" />

            <TextView
                style="@style/TextAppearance.RoomKit.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Set up tenancy and monthly billing"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </RelativeLayout>


    <!-- =========================================================
         SCROLLABLE FORM
         ========================================================= -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMoveIn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">


            <!-- =================================================
                 ERROR
                 ================================================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/roomkit_error_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:textColor="@color/roomkit_error_dark"
                    android:textSize="13sp"
                    tools:text="Please complete all required fields." />

            </com.google.android.material.card.MaterialCardView>


            <!-- =================================================
                 1. TENANT & ROOM
                 ================================================= -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="8dp"
                android:text="TENANT &amp; ROOM" />


            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">


                    <!-- Tenant -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTenant"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Select Tenant"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp">

                        <AutoCompleteTextView
                            android:id="@+id/actvTenant"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="none"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- Building -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBuilding"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Select Building"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp">

                        <AutoCompleteTextView
                            android:id="@+id/actvBuilding"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="none"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- Available Room -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRoom"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Select Available Room"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp">

                        <AutoCompleteTextView
                            android:id="@+id/actvRoom"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="none"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- Move-In Date -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMoveInDate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Move-In Date"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:endIconDrawable="@drawable/ic_calender"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMoveInDate"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- =================================================
                 2. RENT & DEPOSIT
                 ================================================= -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="RENT &amp; DEPOSIT" />


            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:weightSum="2">


                    <!-- Monthly Rent -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMonthlyRent"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Monthly Rent"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:prefixText="៛ ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMonthlyRent"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- Deposit -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDeposit"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Deposit"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:prefixText="៛ ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDeposit"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- =================================================
                 3. BILLING SCHEDULE
                 ================================================= -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="BILLING SCHEDULE" />


            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:weightSum="2">


                    <!-- Billing Day -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBillingDay"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Billing Day"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:helperText="Starts each month">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBillingDay"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="number"
                            android:maxLength="2"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- Due Day -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDueDay"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Due Day"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:helperText="Payment due: day 1–28">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDueDay"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="number"
                            android:maxLength="2"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- =================================================
                 4. UTILITY RATES
                 ================================================= -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="UTILITY RATES" />


            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">


                    <!-- Electricity -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilElectricityRate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Electricity Rate"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:suffixText="៛ / kWh">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etElectricityRate"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- Water Method Label -->
                    <TextView
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Water Billing Method"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                    <!-- Water Method -->
                    <RadioGroup
                        android:id="@+id/rgWaterMethod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <RadioButton
                            android:id="@+id/rbWaterFixed"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:checked="true"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:text="Fixed monthly"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="13sp"
                            app:buttonTint="@color/roomkit_primary" />

                        <RadioButton
                            android:id="@+id/rbWaterMetered"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:text="Metered (m³)"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="13sp"
                            app:buttonTint="@color/roomkit_primary" />

                    </RadioGroup>


                    <!-- Fixed Water Fee -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWaterFee"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Water Fee"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:suffixText="៛ / month">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaterFee"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- Metered Water Rate -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWaterRate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Water Rate"
                        android:visibility="gone"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:suffixText="៛ / m³"
                        tools:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaterRate"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- Rubbish -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRubbishFee"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Rubbish / Waste Fee"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:suffixText="៛ / month">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRubbishFee"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- =================================================
                 5. INITIAL METER READINGS
                 ================================================= -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="INITIAL METER READINGS" />


            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="These are the starting readings for this tenancy."
                        android:textColor="@color/roomkit_text_muted"
                        android:textSize="12sp" />


                    <!-- Initial Electricity -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilInitialElectricity"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Initial Electricity Reading"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:suffixText="kWh">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etInitialElectricity"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- Initial Water -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilInitialWater"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Initial Water Reading"
                        android:visibility="gone"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/roomkit_border"
                        app:suffixText="m³"
                        tools:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etInitialWater"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

