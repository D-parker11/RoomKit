<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_slate_50">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="@dimen/roomkit_size_0"
        android:layout_height="@dimen/roomkit_size_72"
        android:background="@color/roomkit_white"
        android:paddingHorizontal="@dimen/roomkit_size_16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnCancelAddRoom"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/roomkit_touch_target"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="@dimen/roomkit_size_64"
            android:paddingHorizontal="@dimen/roomkit_size_8"
            android:text="@string/ar_cancel"
            android:textColor="@color/roomkit_slate_600"
            android:textSize="@dimen/roomkit_text_15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="@dimen/roomkit_size_80"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ar_title"
                android:textColor="@color/roomkit_primary"
                android:textSize="@dimen/roomkit_text_20"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderBuildingName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_3"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/roomkit_slate_500"
                android:textSize="@dimen/roomkit_text_13"
                tools:text="Proser" />
        </LinearLayout>

        <!-- Retained for existing Fragment binding. -->
        <TextView
            android:id="@+id/btnHeaderSave"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/roomkit_touch_target"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:text="@string/ar_create"
            android:visibility="gone" />
    </RelativeLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="@dimen/roomkit_size_0"
        android:layout_height="@dimen/roomkit_stroke_width"
        android:background="@color/roomkit_slate_200"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable form -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="@dimen/roomkit_size_0"
        android:layout_height="@dimen/roomkit_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/dividerHeader"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomAction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/roomkit_size_20">

            <TextView
                android:id="@+id/tvGeneralError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/roomkit_size_16"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_badge_overdue_pill"
                android:padding="@dimen/roomkit_button_radius_compact"
                android:textColor="@color/roomkit_red_700"
                android:textSize="@dimen/roomkit_text_14"
                android:visibility="gone"
                tools:text="This room number already exists." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ar_details"
                android:textColor="@color/roomkit_primary"
                android:textSize="@dimen/roomkit_text_18"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_5"
                android:layout_marginBottom="@dimen/roomkit_size_20"
                android:text="@string/ar_intro"
                android:textColor="@color/roomkit_slate_500"
                android:textSize="@dimen/roomkit_text_14" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRoomNumber"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ar_room_number"
                app:boxBackgroundColor="@color/roomkit_white"
                app:boxCornerRadiusTopStart="@dimen/roomkit_size_12"
                app:boxCornerRadiusTopEnd="@dimen/roomkit_size_12"
                app:boxCornerRadiusBottomStart="@dimen/roomkit_size_12"
                app:boxCornerRadiusBottomEnd="@dimen/roomkit_size_12"
                app:placeholderText="@string/ar_room_example">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRoomNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/roomkit_control_height"
                    android:imeOptions="actionNext"
                    android:inputType="textCapCharacters"
                    android:singleLine="true"
                    android:textColor="@color/roomkit_primary"
                    android:textSize="@dimen/roomkit_text_16" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFloor"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_16"
                android:hint="@string/ar_floor"
                app:boxBackgroundColor="@color/roomkit_white"
                app:boxCornerRadiusTopStart="@dimen/roomkit_size_12"
                app:boxCornerRadiusTopEnd="@dimen/roomkit_size_12"
                app:boxCornerRadiusBottomStart="@dimen/roomkit_size_12"
                app:boxCornerRadiusBottomEnd="@dimen/roomkit_size_12"
                app:placeholderText="@string/ar_floor_example">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFloor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/roomkit_control_height"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords"
                    android:singleLine="true"
                    android:textColor="@color/roomkit_primary"
                    android:textSize="@dimen/roomkit_text_16" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRoomType"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_16"
                android:hint="@string/ar_type"
                app:boxBackgroundColor="@color/roomkit_white"
                app:boxCornerRadiusTopStart="@dimen/roomkit_size_12"
                app:boxCornerRadiusTopEnd="@dimen/roomkit_size_12"
                app:boxCornerRadiusBottomStart="@dimen/roomkit_size_12"
                app:boxCornerRadiusBottomEnd="@dimen/roomkit_size_12">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvRoomType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/roomkit_control_height"
                    android:inputType="none"
                    android:singleLine="true"
                    android:textColor="@color/roomkit_primary"
                    android:textSize="@dimen/roomkit_text_16" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_spacing_xxl"
                android:layout_marginBottom="@dimen/roomkit_size_16"
                android:text="@string/ar_pricing"
                android:textColor="@color/roomkit_primary"
                android:textSize="@dimen/roomkit_text_18"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMonthlyRent"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ar_monthly_rent"
                app:boxBackgroundColor="@color/roomkit_white"
                app:boxCornerRadiusTopStart="@dimen/roomkit_size_12"
                app:boxCornerRadiusTopEnd="@dimen/roomkit_size_12"
                app:boxCornerRadiusBottomStart="@dimen/roomkit_size_12"
                app:boxCornerRadiusBottomEnd="@dimen/roomkit_size_12"
                app:helperText="@string/ar_rent_helper"
                app:placeholderText="@string/ar_rent_example"
                app:suffixText="@string/ar_rent_suffix">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMonthlyRent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/roomkit_control_height"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textColor="@color/roomkit_primary"
                    android:textSize="@dimen/roomkit_text_18" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNotes"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_20"
                android:hint="@string/ar_notes"
                app:boxBackgroundColor="@color/roomkit_white"
                app:boxCornerRadiusTopStart="@dimen/roomkit_size_12"
                app:boxCornerRadiusTopEnd="@dimen/roomkit_size_12"
                app:boxCornerRadiusBottomStart="@dimen/roomkit_size_12"
                app:boxCornerRadiusBottomEnd="@dimen/roomkit_size_12"
                app:placeholderText="@string/ar_notes_example">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:textColor="@color/roomkit_primary"
                    android:textSize="@dimen/roomkit_text_16" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Informational status, not an editable field. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_24"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_vacant_pill"
                    android:paddingHorizontal="@dimen/roomkit_size_12"
                    android:paddingVertical="@dimen/roomkit_size_6"
                    android:text="@string/ar_vacant"
                    android:textColor="@color/roomkit_slate_600"
                    android:textSize="@dimen/roomkit_text_12"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/roomkit_size_12"
                    android:layout_weight="1"
                    android:text="@string/ar_status_helper"
                    android:textColor="@color/roomkit_slate_500"
                    android:textSize="@dimen/roomkit_text_13" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Single primary action -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="@dimen/roomkit_size_0"
        android:layout_height="wrap_content"
        android:background="@color/roomkit_white"
        android:elevation="@dimen/roomkit_spacing_xs"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/roomkit_size_20"
        android:paddingTop="@dimen/roomkit_size_16"
        android:paddingBottom="@dimen/roomkit_size_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAndAddRoom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_control_height"
            android:insetTop="@dimen/roomkit_size_0"
            android:insetBottom="@dimen/roomkit_size_0"
            android:text="@string/ar_create"
            android:textAllCaps="false"
            android:textColor="@color/roomkit_white"
            android:textSize="@dimen/roomkit_text_16"
            android:textStyle="bold"
            app:backgroundTint="@color/roomkit_primary"
            app:cornerRadius="@dimen/roomkit_button_radius_compact" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>