<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:orientation="vertical">

    <!-- Seamless Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnBackPaymentQr"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/roomkit_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="Payment QR"
            android:textColor="@color/roomkit_text_primary"
            android:textSize="@dimen/roomkit_text_26"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="88dp">

            <!-- Hero Card: Invoice Summary -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/invoiceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="INVOICE SUMMARY"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_11"
                        android:textStyle="bold" />

                    <!-- Room & Tenant Row with Rounded Icon Tile -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="@color/roomkit_background"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_calender"
                                app:tint="@color/roomkit_text_primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRoomTenantPill"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:textColor="@color/roomkit_text_primary"
                                android:textSize="@dimen/roomkit_text_20"
                                android:textStyle="bold"
                                tools:text="Room 02 · Mann Vanda" />

                            <TextView
                                android:id="@+id/tvBillingPeriod"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:textColor="@color/roomkit_text_secondary"
                                android:textSize="@dimen/roomkit_text_13"
                                tools:text="Nov 2026 · #INV-0034" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/roomkit_border" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="Amount due"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13" />

                    <TextView
                        android:id="@+id/tvAmountDue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_32"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="@dimen/roomkit_text_32"
                        app:autoSizeMinTextSize="@dimen/roomkit_text_20"
                        app:autoSizeStepGranularity="@dimen/roomkit_text_1"
                        app:autoSizeTextType="uniform"
                        tools:text="900,000 ៛" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="For this invoice only"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_12" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressQr"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginTop="28dp"
                android:indeterminateTint="@color/roomkit_text_primary"
                android:visibility="gone" />

            <!-- Receiving QR Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/paymentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvStateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:text="Scan to pay"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_18"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivQrCode"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/roomkit_white"
                        android:contentDescription="Receiving KHQR"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvReceiver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_17"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="CHANNDAVITH SOVANN"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvPaymentNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="First, import your receiving KHQR image in:\n\nMore → Settings → Payment setup\n\nOnce saved, your QR will appear here automatically."
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13"
                        android:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:letterSpacing="0"
                        android:minHeight="54dp"
                        android:stateListAnimator="@null"
                        android:text="Set up payment QR"
                        android:textAllCaps="false"
                        android:textColor="@color/roomkit_white"
                        android:textSize="@dimen/roomkit_text_15"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:backgroundTint="@color/roomkit_text_primary"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Primary & Secondary Actions -->
            <LinearLayout
                android:id="@+id/shareActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareQr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:minHeight="54dp"
                    android:stateListAnimator="@null"
                    android:text="Share payment QR"
                    android:textAllCaps="false"
                    android:textColor="@color/roomkit_white"
                    android:textSize="@dimen/roomkit_text_15"
                    android:textStyle="bold"
                    app:backgroundTint="@color/roomkit_text_primary"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/roomkit_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveImage"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:minHeight="54dp"
                    android:stateListAnimator="@null"
                    android:text="Save image"
                    android:textAllCaps="false"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_15"
                    android:textStyle="bold"
                    app:backgroundTint="@color/roomkit_white"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/roomkit_text_primary"
                    app:strokeColor="@color/roomkit_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Manual Verification Footer Notice -->
            <TextView
                android:id="@+id/manualNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="8dp"
                android:text="After payment, check your banking app and record the payment in RoomKit."
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_12" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>