<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/roomkit_size_24"
        android:paddingTop="@dimen/roomkit_size_20">

        <!-- Header: Back Button, Title & Circular Add Tenant Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btnAddTenant"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/roomkit_size_40"
                    android:layout_height="@dimen/roomkit_size_40"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="@dimen/roomkit_size_8"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/roomkit_primary" />

                <TextView
                    style="@style/TextAppearance.RoomKit.ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/roomkit_size_8"
                    android:text="Tenants"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_28" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddTenant"
                android:layout_width="@dimen/roomkit_touch_target"
                android:layout_height="@dimen/roomkit_touch_target"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="Add Tenant"
                android:insetLeft="@dimen/roomkit_size_0"
                android:insetTop="@dimen/roomkit_size_0"
                android:insetRight="@dimen/roomkit_size_0"
                android:insetBottom="@dimen/roomkit_size_0"
                android:padding="@dimen/roomkit_size_0"
                app:backgroundTint="@color/roomkit_primary"
                app:cornerRadius="@dimen/roomkit_size_24"
                app:elevation="@dimen/roomkit_size_0"
                app:icon="@drawable/ic_plus_white"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/roomkit_size_0"
                app:iconSize="@dimen/roomkit_size_20"
                app:iconTint="@color/roomkit_white" />
        </RelativeLayout>

        <!-- Search Field Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_button_radius_compact"
            app:cardBackgroundColor="@color/roomkit_white"
            app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
            app:cardElevation="@dimen/roomkit_size_0"
            app:strokeColor="@color/roomkit_border"
            app:strokeWidth="@dimen/roomkit_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/roomkit_button_radius_compact">

                <ImageView
                    android:layout_width="@dimen/roomkit_size_22"
                    android:layout_height="@dimen/roomkit_size_22"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/roomkit_text_primary" />

                <EditText
                    android:id="@+id/etSearchTenant"
                    android:layout_width="@dimen/roomkit_size_0"
                    android:layout_height="@dimen/roomkit_action_height"
                    android:layout_marginStart="@dimen/roomkit_size_10"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/roomkit_text_primary"
                    android:textColorHint="@color/roomkit_text_secondary"
                    android:textSize="@dimen/roomkit_text_15" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Filter Tabs: All, Active, Moved Out -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutTenantFilter"
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_size_44"
            android:layout_marginTop="@dimen/roomkit_size_16"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/roomkit_primary"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="@dimen/roomkit_size_2_5"
            app:tabMode="fixed"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/roomkit_primary"
            app:tabTextAppearance="@style/TextAppearance.RoomKit.Tab"
            app:tabTextColor="@color/roomkit_text_muted" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_stroke_width"
            android:background="@color/roomkit_divider" />

        <!-- List & Empty State Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/roomkit_size_12">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTenants"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/roomkit_bottom_safe_padding"
                tools:listitem="@layout/item_tenant_card" />

            <!-- Polished Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyTenants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/roomkit_touch_target"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    style="@style/TextAppearance.RoomKit.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_16"
                    android:textStyle="bold"
                    tools:text="No tenants yet" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    style="@style/TextAppearance.RoomKit.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_spacing_xs"
                    android:textColor="@color/roomkit_text_secondary"
                    android:textSize="@dimen/roomkit_text_13"
                    tools:text="Add your first tenant to get started." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyAddTenant"
                    style="@style/Widget.RoomKit.PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/roomkit_size_46"
                    android:layout_marginTop="@dimen/roomkit_size_16"
                    android:paddingHorizontal="@dimen/roomkit_size_24"
                    android:text="Add Tenant"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>
</LinearLayout>