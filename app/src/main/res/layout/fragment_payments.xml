<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rpay_background">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/paymentsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Screen Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Payments"
                android:textColor="@color/rpay_ink"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:text="Track collections and balances."
                android:textColor="@color/rpay_muted"
                android:textSize="15sp" />

            <!-- Month Navigation Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/rpay_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/rpay_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="48dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Previous month"
                        android:padding="13dp"
                        android:src="@drawable/ic_rb_left"
                        app:tint="@color/rpay_ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_calender"
                            app:tint="@color/rpay_ink" />

                        <TextView
                            android:id="@+id/tvSelectedMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="November 2026"
                            android:textColor="@color/rpay_ink"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnNextMonth"
                        android:layout_width="48dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next month"
                        android:padding="13dp"
                        android:src="@drawable/ic_rb_right"
                        app:tint="@color/rpay_ink" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Summary Totals Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/rpay_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/rpay_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Outstanding balance"
                        android:textColor="@color/rpay_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvSummaryOutstanding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="1,746,000 KHR"
                        android:textColor="@color/rpay_ink"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="30sp"
                        app:autoSizeMinTextSize="18sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/rpay_border" />

                    <!-- Collected vs Overdue Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Collected -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Collected"
                                android:textColor="@color/rpay_muted"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvSummaryCollected"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif"
                                android:text="0 KHR"
                                android:textColor="@color/rpay_green"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="20dp"
                            android:background="@color/rpay_border" />

                        <!-- Overdue -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Overdue"
                                android:textColor="@color/rpay_muted"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvSummaryOverdue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif"
                                android:text="0 KHR"
                                android:textColor="@color/rpay_muted"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search Field Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/rpay_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/rpay_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="@color/rpay_ink" />

                    <EditText
                        android:id="@+id/etSearchPayments"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/rpay_ink"
                        android:textColorHint="@color/rpay_muted"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter Chips Carousel -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:checkable="true"
                        android:text="All 2"
                        android:textColor="@color/rb_filter_text"
                        android:textSize="14sp"
                        app:checkedIconVisible="false"
                        app:chipBackgroundColor="@color/rb_filter_background"
                        app:chipCornerRadius="20dp"
                        app:chipMinHeight="36dp"
                        app:chipMinTouchTargetSize="48dp"
                        app:chipStrokeColor="@color/rpay_border"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipUnpaid"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:checkable="true"
                        android:text="Unpaid 2"
                        android:textColor="@color/rb_filter_text"
                        android:textSize="14sp"
                        app:checkedIconVisible="false"
                        app:chipBackgroundColor="@color/rb_filter_background"
                        app:chipCornerRadius="20dp"
                        app:chipMinHeight="36dp"
                        app:chipMinTouchTargetSize="48dp"
                        app:chipStrokeColor="@color/rpay_border"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPaid"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:checkable="true"
                        android:text="Paid 0"
                        android:textColor="@color/rb_filter_text"
                        android:textSize="14sp"
                        app:checkedIconVisible="false"
                        app:chipBackgroundColor="@color/rb_filter_background"
                        app:chipCornerRadius="20dp"
                        app:chipMinHeight="36dp"
                        app:chipMinTouchTargetSize="48dp"
                        app:chipStrokeColor="@color/rpay_border"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMore"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:checkable="true"
                        android:text="More"
                        android:textColor="@color/rb_filter_text"
                        android:textSize="14sp"
                        app:checkedIconVisible="false"
                        app:chipBackgroundColor="@color/rb_filter_background"
                        app:chipCornerRadius="20dp"
                        app:chipMinHeight="36dp"
                        app:chipMinTouchTargetSize="48dp"
                        app:chipStrokeColor="@color/rpay_border"
                        app:chipStrokeWidth="1dp"
                        app:closeIcon="@drawable/rc_rb_down"
                        app:closeIconTint="@color/rb_filter_text"
                        app:closeIconVisible="true"
                        app:ensureMinTouchTargetSize="true" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Payment Collection Section -->
            <LinearLayout
                android:id="@+id/collectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="Payment collection"
                    android:textColor="@color/rpay_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCollectionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/rpay_muted"
                    android:textSize="13sp"
                    tools:text="2 invoices" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPaymentActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Payment History Section -->
            <LinearLayout
                android:id="@+id/historyHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="Payment history"
                    android:textColor="@color/rpay_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHistoryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/rpay_muted"
                    android:textSize="13sp"
                    tools:text="0 records" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPaymentHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Empty Payments State -->
            <LinearLayout
                android:id="@+id/layoutEmptyPayments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="36dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="No records in this view"
                    android:textColor="@color/rpay_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="Try another month or filter."
                    android:textColor="@color/rpay_muted"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressPayments"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/rpay_ink"
        android:visibility="gone" />

</FrameLayout>