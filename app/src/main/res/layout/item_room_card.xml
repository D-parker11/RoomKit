<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_stroke"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: ROOM 101 & Status Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROOM "
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRoomNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#111827"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="101" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRoomStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_occupied"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:text="Occupied"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Tenant Name (Occupied) OR Available Notice (Vacant) -->
    <TextView
        android:id="@+id/tvTenantOrAvailability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#111827"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Sokha Chan" />

    <!-- Monthly Rent -->
    <TextView
        android:id="@+id/tvRentAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#6B7280"
        android:textSize="14sp"
        tools:text="400,000 ៛" />

    <View
        android:id="@+id/dividerMeta"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#F3F4F6" />

    <!-- Meter Readings & Invoice Due Status -->
    <RelativeLayout
        android:id="@+id/layoutMetaInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/layoutMeters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_bolt"
                app:tint="#9CA3AF" />

            <TextView
                android:id="@+id/tvElectricityReading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#6B7280"
                android:textSize="12sp"
                tools:text="1,250 kWh" />

            <TextView
                android:id="@+id/tvWaterReading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="#6B7280"
                android:textSize="12sp"
                tools:text="112 m³" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutInvoiceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDueDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="#6B7280"
                android:textSize="12sp"
                tools:text="Due Sep 5" />

            <TextView
                android:id="@+id/tvPaymentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_unpaid"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="#D97706"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Unpaid" />
        </LinearLayout>
    </RelativeLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMoveInRoom"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#111827"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Move In"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="10dp"
        tools:visibility="visible" />

</LinearLayout>