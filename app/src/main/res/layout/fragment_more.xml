<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMore"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/roomkit_bottom_safe_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/roomkit_screen_padding_horizontal"
            android:paddingTop="@dimen/roomkit_screen_padding_top">

            <!-- Header -->
            <TextView
                style="@style/TextAppearance.RoomKit.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="More" />

            <TextView
                style="@style/TextAppearance.RoomKit.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tenants, reports &amp; settings"
                android:textColor="@color/roomkit_text_secondary" />

            <!-- Menu Cards Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_spacing_xl"
                android:orientation="vertical">

                <!-- 1. Tenants Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTenants"
                    style="@style/Widget.RoomKit.Card.Menu"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="@dimen/roomkit_spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/roomkit_spacing_lg"
                        android:paddingVertical="@dimen/roomkit_spacing_lg">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_more_icon_container">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="Tenants"
                                android:src="@drawable/ic_tenants"
                                app:tint="@color/roomkit_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/roomkit_spacing_lg"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.RoomKit.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tenants"
                                android:textColor="@color/roomkit_text_primary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTenantsSubtitle"
                                style="@style/TextAppearance.RoomKit.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/roomkit_text_secondary"
                                tools:text="18 active tenants" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Open Tenants"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/roomkit_text_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Reports Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReports"
                    style="@style/Widget.RoomKit.Card.Menu"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="@dimen/roomkit_spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/roomkit_spacing_lg"
                        android:paddingVertical="@dimen/roomkit_spacing_lg">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_more_icon_container">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="Reports"
                                android:src="@drawable/ic_trending_up"
                                app:tint="@color/roomkit_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/roomkit_spacing_lg"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.RoomKit.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reports"
                                android:textColor="@color/roomkit_text_primary"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/TextAppearance.RoomKit.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Revenue &amp; occupancy analytics"
                                android:textColor="@color/roomkit_text_secondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Open Reports"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/roomkit_text_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Reminders Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReminders"
                    style="@style/Widget.RoomKit.Card.Menu"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="@dimen/roomkit_spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/roomkit_spacing_lg"
                        android:paddingVertical="@dimen/roomkit_spacing_lg">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_more_icon_container">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="Reminders"
                                android:src="@drawable/ic_notifications"
                                app:tint="@color/roomkit_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/roomkit_spacing_lg"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.RoomKit.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reminders"
                                android:textColor="@color/roomkit_text_primary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRemindersSubtitle"
                                style="@style/TextAppearance.RoomKit.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/roomkit_text_secondary"
                                tools:text="4 items need attention" />
                        </LinearLayout>

                        <!-- Notification Count Badge -->
                        <TextView
                            android:id="@+id/tvReminderBadge"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="@dimen/roomkit_spacing_sm"
                            android:background="@drawable/bg_badge_notification_circle"
                            android:gravity="center"
                            android:textColor="@color/roomkit_on_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="4"
                            tools:visibility="visible" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Open Reminders"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/roomkit_text_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Settings Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSettings"
                    style="@style/Widget.RoomKit.Card.Menu"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="@dimen/roomkit_spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/roomkit_spacing_lg"
                        android:paddingVertical="@dimen/roomkit_spacing_lg">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_more_icon_container">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="Settings"
                                android:src="@drawable/ic_settings"
                                app:tint="@color/roomkit_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/roomkit_spacing_lg"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.RoomKit.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Settings"
                                android:textColor="@color/roomkit_text_primary"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/TextAppearance.RoomKit.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rates, billing, and app preferences"
                                android:textColor="@color/roomkit_text_secondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Open Settings"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/roomkit_text_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- App Information Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_spacing_xxl"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/roomkit_spacing_md">

                <TextView
                    style="@style/TextAppearance.RoomKit.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RoomKit"
                    android:textColor="@color/roomkit_text_secondary"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.RoomKit.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Version 1.0.0 · Offline Management"
                    android:textColor="@color/roomkit_text_muted" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>