<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_stroke"
    android:orientation="vertical"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvHistoryRoomBuilding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Room 101 • Campus Residence A" />

        <TextView
            android:id="@+id/tvHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="ENDED" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvHistoryDates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#4B5563"
        android:textSize="12sp"
        tools:text="15 Jan 2026 - 30 Jun 2026" />

    <TextView
        android:id="@+id/tvHistoryRent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#6B7280"
        android:textSize="12sp"
        tools:text="1,000,000 KHR / month" />
<Button android:id="@+id/btnHistorySettlement"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:text="@string/move_out_history"
    android:textAllCaps="false" />
</LinearLayout>