<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mr_background"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mr_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBackMeterReading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mr_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/mr_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/MRHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mr_title"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvBillingMonthSubtitle"
                style="@style/MRCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="November 2026" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvRoomTenantBanner"
                style="@style/MRHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                tools:text="Room 13 · Jaydee" />

            <TextView
                style="@style/MRHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mr_monthly"
                android:textSize="20sp" />

            <TextView
                style="@style/MRCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/mr_monthly_hint" />

            <ProgressBar
                android:id="@+id/progressMeters"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/mr_accent" />

            <TextView
                android:id="@+id/tvGlobalError"
                style="@style/MRCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/mr_notice_background"
                android:padding="12dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReloadMeters"
                style="@style/MRTextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mr_retry"
                android:visibility="gone" />

            <!-- Electricity Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/MRCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/ic_title"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/mr_bolt" />

                        <TextView
                            style="@style/MRHeading"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/mr_electricity" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/MRCaption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mr_previous" />

                        <TextView
                            android:id="@+id/tvElecPreviousValue"
                            style="@style/MRHeading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="3" />

                        <TextView
                            style="@style/MRCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="kWh" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/MRInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/mr_current"
                        app:suffixText="kWh">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCurrentElectricity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:minHeight="56dp"
                            android:paddingHorizontal="16dp"
                            android:saveEnabled="false"
                            android:textColor="@color/mr_text"
                            android:textSize="18sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvElecUsageLive"
                        style="@style/MRBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/mr_usage_background"
                        android:padding="10dp"
                        android:textColor="@color/mr_success"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvElecError"
                        style="@style/MRCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/mr_error"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Water Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWaterMeter"
                style="@style/MRCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/mr_icon_title"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/mr_drop" />

                        <TextView
                            style="@style/MRHeading"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/mr_water" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutWaterMeterBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/MRCaption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/mr_previous" />

                            <TextView
                                android:id="@+id/tvWaterPreviousValue"
                                style="@style/MRHeading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="3" />

                            <TextView
                                style="@style/MRCaption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="m³" />
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/MRInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/mr_current"
                            app:suffixText="m³">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCurrentWater"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:minHeight="56dp"
                                android:paddingHorizontal="16dp"
                                android:saveEnabled="false"
                                android:textColor="@color/mr_text"
                                android:textSize="18sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tvWaterUsageLive"
                            style="@style/MRBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/mr_usage_background"
                            android:padding="10dp"
                            android:textColor="@color/mr_success"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvWaterError"
                            style="@style/MRCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:accessibilityLiveRegion="polite"
                            android:textColor="@color/mr_error"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvWaterFixedNotice"
                        style="@style/MRCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Rubbish Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/MRCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/MRBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mr_rubbish" />

                        <TextView
                            android:id="@+id/tvRubbishFeeAmount"
                            style="@style/MRHeading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="10,000 ៛" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Replacement Section Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/MRCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleReplacement"
                        style="@style/MRTextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:paddingHorizontal="0dp"
                        android:text="@string/mr_replace"
                        app:icon="@drawable/ic_arrow"
                        app:iconGravity="end" />

                    <LinearLayout
                        android:id="@+id/layoutReplacementBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/MRCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mr_replace_note" />

                        <RadioGroup
                            android:id="@+id/rgReplacementType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:checkedButton="@id/rbReplaceElectricity"
                            android:orientation="horizontal">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rbReplaceElectricity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/mr_radio_tint"
                                android:minHeight="48dp"
                                android:text="@string/mr_electricity"
                                android:textColor="@color/mr_text" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rbReplaceWater"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/mr_radio_tint"
                                android:minHeight="48dp"
                                android:text="@string/mr_water"
                                android:textColor="@color/mr_text" />
                        </RadioGroup>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/MRInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/mr_old_closing">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etReplacementClosing"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:minHeight="56dp"
                                android:paddingHorizontal="16dp"
                                android:saveEnabled="false"
                                android:textColor="@color/mr_text"
                                android:textSize="18sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/MRInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/mr_new_opening">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etReplacementOpening"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:minHeight="56dp"
                                android:paddingHorizontal="16dp"
                                android:saveEnabled="false"
                                android:textColor="@color/mr_text"
                                android:textSize="18sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/MRInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/mr_reason">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etReplacementReason"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="textCapSentences|textMultiLine"
                                android:minHeight="56dp"
                                android:paddingHorizontal="16dp"
                                android:saveEnabled="false"
                                android:textColor="@color/mr_text"
                                android:textSize="18sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReplaceMeter"
                            style="@style/MRPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="52dp"
                            android:text="@string/mr_review" />

                        <TextView
                            android:id="@+id/tvReplacementError"
                            style="@style/MRCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:accessibilityLiveRegion="polite"
                            android:textColor="@color/mr_error"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- History Section Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/MRCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/mr_icon_title"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/mr_history" />

                        <TextView
                            style="@style/MRHeading"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/mr_history" />
                    </LinearLayout>

                    <TextView
                        style="@style/MRCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/mr_history_hint" />

                    <TextView
                        android:id="@+id/tvMeterHistory"
                        style="@style/MRCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/mr_history_empty" />

                    <LinearLayout
                        android:id="@+id/layoutHistoryRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHistoryMore"
                        style="@style/MRTextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mr_show_less"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mr_surface"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveMeterReading"
            style="@style/MRPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:text="@string/mr_save" />
    </LinearLayout>

</LinearLayout>