<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/settingsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/rks_back"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/rks2_defaults"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_24"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/rks2_defaults_body"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_13" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Hero Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/roomkit_teal_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/rks_hero"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_20"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/rks_hero_body"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_14" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Billing Defaults -->
            <TextView
                style="@style/TextAppearance.RoomKit.Label.Uppercase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rks_billing" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/rks_currency"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_16"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/rks_currency_body"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/rks_scope"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13" />

                    <!-- Due Day Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.RoomKit.Input.Settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/rks_due">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/settingsDue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:minHeight="56dp"
                            android:saveEnabled="false"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_16" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Electricity Rate Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.RoomKit.Input.Settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/rks_electricity">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/settingsElectricity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:minHeight="56dp"
                            android:saveEnabled="false"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_16" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Water Settings Header & Controls -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/rks_water"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_15"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/settingsMetered"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingEnd="4dp"
                        android:saveEnabled="false"
                        android:text="@string/rks_metered"
                        android:textColor="@color/roomkit_text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/rks_water_help"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13" />

                    <!-- Fixed Water Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.RoomKit.Input.Settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/rks_fixed">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/settingsFixedWater"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:minHeight="56dp"
                            android:saveEnabled="false"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_16" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Water Rate Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.RoomKit.Input.Settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/rks_rate">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/settingsWaterRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:minHeight="56dp"
                            android:saveEnabled="false"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_16" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Rubbish Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.RoomKit.Input.Settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/rks_rubbish">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/settingsRubbish"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:minHeight="56dp"
                            android:saveEnabled="false"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_16" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Status Message Banner -->
                    <TextView
                        android:id="@+id/settingsMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:accessibilityLiveRegion="polite"
                        android:visibility="gone" />

                    <!-- Save Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsSave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:minHeight="56dp"
                        android:text="@string/rks_save"
                        android:textAllCaps="false"
                        android:textColor="@color/roomkit_white"
                        app:backgroundTint="@color/roomkit_text_primary"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>