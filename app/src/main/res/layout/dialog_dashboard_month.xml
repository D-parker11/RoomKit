<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/roomkit_size_20"
        android:paddingTop="@dimen/roomkit_size_12"
        android:paddingBottom="@dimen/roomkit_size_24">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/roomkit_size_36"
            android:layout_height="@dimen/roomkit_spacing_xs"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            app:cardBackgroundColor="@color/roomkit_border"
            app:cardCornerRadius="@dimen/roomkit_stroke_width_focused"
            app:cardElevation="@dimen/roomkit_size_0"
            app:strokeWidth="@dimen/roomkit_size_0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_16"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/dm_choose_month"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_22" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/roomkit_touch_target"
                android:letterSpacing="0"
                android:text="@string/dm_cancel"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_secondary"
                app:cornerRadius="@dimen/roomkit_size_24" />
        </LinearLayout>

        <!-- Selected billing period -->
        <TextView
            android:id="@+id/tvSelectedPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_spacing_xs"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/roomkit_text_secondary"
            android:textSize="@dimen/roomkit_text_14" />

        <!-- Optional caller context; hidden for the dashboard. -->
        <TextView
            android:id="@+id/tvMonthHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_12"
            android:textAppearance="@style/TextAppearance.RoomKit.Caption.Standard"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_24"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviousYear"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="@dimen/roomkit_touch_target"
                android:layout_height="@dimen/roomkit_touch_target"
                android:minWidth="@dimen/roomkit_size_0"
                android:padding="@dimen/roomkit_size_0"
                android:text="‹"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_28"
                app:cornerRadius="@dimen/roomkit_size_24" />

            <TextView
                android:id="@+id/tvYear"
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_20" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextYear"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="@dimen/roomkit_touch_target"
                android:layout_height="@dimen/roomkit_touch_target"
                android:minWidth="@dimen/roomkit_size_0"
                android:padding="@dimen/roomkit_size_0"
                android:text="›"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_28"
                app:cornerRadius="@dimen/roomkit_size_24" />
        </LinearLayout>

        <!-- Four rows of three months, populated in Kotlin -->
        <LinearLayout
            android:id="@+id/monthGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_12"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThisMonth"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/roomkit_touch_target"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/roomkit_size_12"
            android:letterSpacing="0"
            android:text="@string/dm_this_month"
            android:textAllCaps="false"
            android:textColor="@color/roomkit_primary"
            app:cornerRadius="@dimen/roomkit_size_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_control_height"
            android:layout_marginTop="@dimen/roomkit_size_12"
            android:insetTop="@dimen/roomkit_size_0"
            android:insetBottom="@dimen/roomkit_size_0"
            android:letterSpacing="0"
            android:text="@string/dm_apply"
            android:textAllCaps="false"
            android:textColor="@color/roomkit_white"
            android:textSize="@dimen/roomkit_text_16"
            app:backgroundTint="@color/roomkit_primary"
            app:cornerRadius="@dimen/roomkit_size_16" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>