<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/roomkit_white"
    app:cardCornerRadius="@dimen/roomkit_size_24"
    app:cardElevation="@dimen/roomkit_size_0"
    app:strokeWidth="@dimen/roomkit_size_0">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/roomkit_size_24"
            android:paddingTop="@dimen/roomkit_size_12"
            android:paddingBottom="@dimen/roomkit_size_24">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/roomkit_size_36"
                android:layout_height="@dimen/roomkit_spacing_xs"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                app:cardBackgroundColor="@color/roomkit_border"
                app:cardCornerRadius="@dimen/roomkit_stroke_width_focused"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeWidth="@dimen/roomkit_size_0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_spacing_xxl"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/rk_pdf_ready_title"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_24" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_8"
                android:lineSpacingExtra="@dimen/roomkit_size_3"
                android:text="@string/rk_pdf_ready_description"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_14" />

            <!-- Invoice context -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_24"
                app:cardBackgroundColor="@color/roomkit_background"
                app:cardCornerRadius="@dimen/roomkit_size_16"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_size_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/invoice_detail_pdf_label"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_11" />

                    <TextView
                        android:id="@+id/tvInvoiceContext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_6"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_15" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenPdf"
                android:layout_width="match_parent"
                android:layout_height="@dimen/roomkit_control_height"
                android:layout_marginTop="@dimen/roomkit_size_24"
                android:fontFamily="sans-serif-medium"
                android:insetTop="@dimen/roomkit_size_0"
                android:insetBottom="@dimen/roomkit_size_0"
                android:letterSpacing="0"
                android:text="@string/invoice_detail_open_pdf"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_white"
                android:textSize="@dimen/roomkit_text_16"
                app:backgroundTint="@color/roomkit_primary"
                app:cornerRadius="@dimen/roomkit_size_16" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrintPdf"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/roomkit_control_height"
                android:layout_marginTop="@dimen/roomkit_size_12"
                android:insetTop="@dimen/roomkit_size_0"
                android:insetBottom="@dimen/roomkit_size_0"
                android:letterSpacing="0"
                android:text="@string/rk_pdf_print_invoice"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_16"
                app:backgroundTint="@color/roomkit_white"
                app:cornerRadius="@dimen/roomkit_size_16"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/roomkit_touch_target"
                android:layout_marginTop="@dimen/roomkit_size_8"
                android:letterSpacing="0"
                android:text="@string/invoice_detail_done"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_14"
                app:cornerRadius="@dimen/roomkit_size_16" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>