<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/roomkit_size_12"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="@dimen/roomkit_size_16"
    app:cardElevation="@dimen/roomkit_size_0"
    app:strokeColor="@color/roomkit_gray_200"
    app:strokeWidth="@dimen/roomkit_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/roomkit_size_16">

        <FrameLayout
            android:id="@+id/layoutIconContainer"
            android:layout_width="@dimen/roomkit_size_40"
            android:layout_height="@dimen/roomkit_size_40">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="@dimen/roomkit_size_20"
                android:layout_height="@dimen/roomkit_size_20"
                android:layout_gravity="center"
                android:contentDescription="Status icon"
                android:src="@drawable/ic_alert_circle" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="@dimen/roomkit_size_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/roomkit_button_radius_compact"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_15"
                android:textStyle="bold"
                tools:text="Room 101 · Campus A" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                android:textColor="@color/roomkit_gray_500"
                android:textSize="@dimen/roomkit_text_13"
                tools:text="Payment unpaid" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/roomkit_size_12"
            android:paddingVertical="@dimen/roomkit_spacing_xs"
            android:textSize="@dimen/roomkit_text_12"
            android:textStyle="bold"
            tools:text="Unpaid" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>