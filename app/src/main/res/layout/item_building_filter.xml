<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardFilter"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/roomkit_size_38"
    android:layout_marginEnd="@dimen/roomkit_size_8"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/roomkit_size_19"
    app:cardElevation="@dimen/roomkit_size_0"
    app:strokeWidth="@dimen/roomkit_stroke_width">

    <TextView
        android:id="@+id/tvFilterName"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingHorizontal="@dimen/roomkit_size_16"
        android:textSize="@dimen/roomkit_text_13"
        android:textStyle="bold"
        tools:text="All Buildings" />
</com.google.android.material.card.MaterialCardView>