<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.RoomKit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/roomkit_spacing_md"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/roomkit_card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal">

            <!-- Left Info Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/roomkit_spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPaymentDate"
                    style="@style/TextAppearance.RoomKit.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/roomkit_text_muted"
                    tools:text="Oct 21, 2026" />

                <TextView
                    android:id="@+id/tvTenantName"
                    style="@style/TextAppearance.RoomKit.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="17sp"
                    tools:text="Bopha Ly" />

                <TextView
                    android:id="@+id/tvRoomBuilding"
                    style="@style/TextAppearance.RoomKit.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="13sp"
                    tools:text="Room 102 · Campus Residence" />
            </LinearLayout>

            <!-- Right Amount & Badges -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPaymentAmount"
                    style="@style/TextAppearance.RoomKit.StatValue.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="22sp"
                    tools:text="400,000 ៛" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    style="@style/TextAppearance.RoomKit.Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    tools:background="@drawable/bg_badge_paid_pill"
                    tools:text="Paid"
                    tools:textColor="@color/roomkit_success_dark" />

                <TextView
                    android:id="@+id/tvPaymentMethod"
                    style="@style/TextAppearance.RoomKit.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/roomkit_text_muted"
                    tools:text="KHQR" />
            </LinearLayout>
        </LinearLayout>

        <!-- Partial Payment Detail Footer -->
        <LinearLayout
            android:id="@+id/layoutPartialFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:background="@color/roomkit_divider" />

            <TextView
                android:id="@+id/tvPartialBreakdown"
                style="@style/TextAppearance.RoomKit.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/roomkit_warning_dark"
                android:textStyle="bold"
                tools:text="400,000 ៛" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>