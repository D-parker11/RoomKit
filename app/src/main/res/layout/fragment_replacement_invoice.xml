<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/replacement_background"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/replacement_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/replacement_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEditorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/replacement_title"
                android:textColor="@color/replacement_navy"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/replacement_subtitle"
                android:textColor="@color/replacement_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Loading Indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressLoading"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/replacement_blue"
        app:trackColor="@color/replacement_blue_bg" />

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card 1: Summary & Navigation -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ReplacementCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvRoom"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/replacement_navy"
                            android:textSize="22sp"
                            tools:text="Room 04" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/replacement_draft_pill"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="@string/replacement_draft"
                            android:textColor="@color/replacement_amber"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTenant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/replacement_muted"
                        android:textSize="14sp"
                        tools:text="Ngoun Channdevith" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPeriod"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/replacement_text"
                            android:textSize="13sp"
                            tools:text="October 2026" />

                        <TextView
                            android:id="@+id/tvDue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/replacement_muted"
                            android:textSize="13sp"
                            tools:text="Due Nov 5, 2026" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/replacement_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDraftNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/replacement_muted"
                            android:textSize="13sp"
                            tools:text="Draft #0012" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOriginal"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0"
                            android:minHeight="48dp"
                            android:textAllCaps="false"
                            android:textColor="@color/replacement_blue"
                            android:textSize="13sp"
                            tools:text="View original #0011" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEditorNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/replacement_info_bg"
                        android:padding="12dp"
                        android:text="@string/replacement_note"
                        android:textColor="@color/replacement_blue"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAbout"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:letterSpacing="0"
                        android:minHeight="48dp"
                        android:text="@string/replacement_details"
                        android:textAllCaps="false"
                        android:textColor="@color/replacement_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Rent Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ReplacementCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/ReplacementSectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/replacement_rent_title" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRent"
                        style="@style/ReplacementField"
                        android:hint="@string/replacement_rent_hint"
                        app:suffixText="@string/replacement_khr">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRent"
                            style="@style/ReplacementInput" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Electricity Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ReplacementCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/ReplacementSectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/replacement_electricity_title" />

                        <TextView
                            android:id="@+id/tvElectricityCharge"
                            style="@style/ReplacementSectionTitle"
                            android:textColor="@color/replacement_blue"
                            tools:text="7,000 ៛" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilElectricityPrevious"
                            style="@style/ReplacementField"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/replacement_previous"
                            app:suffixText="@string/replacement_kwh">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etElectricityPrevious"
                                style="@style/ReplacementInput" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="1dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilElectricityCurrent"
                            style="@style/ReplacementField"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/replacement_current"
                            app:suffixText="@string/replacement_kwh">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etElectricityCurrent"
                                style="@style/ReplacementInput" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilElectricityRate"
                        style="@style/ReplacementField"
                        android:hint="@string/replacement_rate"
                        app:suffixText="@string/replacement_rate_khr">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etElectricityRate"
                            style="@style/ReplacementInput" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvElectricityUsage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/replacement_muted"
                        android:textSize="13sp"
                        tools:text="7 kWh used" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Water Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ReplacementCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/ReplacementSectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/replacement_water_title" />

                        <TextView
                            android:id="@+id/tvWaterCharge"
                            style="@style/ReplacementSectionTitle"
                            android:textColor="@color/replacement_blue"
                            tools:text="7,000 ៛" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvWaterMethod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/replacement_water_fixed"
                        android:textColor="@color/replacement_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/rowWaterReadings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilWaterPrevious"
                            style="@style/ReplacementField"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/replacement_previous"
                            app:suffixText="@string/replacement_m3">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etWaterPrevious"
                                style="@style/ReplacementInput" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="1dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilWaterCurrent"
                            style="@style/ReplacementField"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/replacement_current"
                            app:suffixText="@string/replacement_m3">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etWaterCurrent"
                                style="@style/ReplacementInput" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWaterRate"
                        style="@style/ReplacementField"
                        android:hint="@string/replacement_fixed_fee"
                        app:suffixText="@string/replacement_khr">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaterRate"
                            style="@style/ReplacementInput" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvWaterUsage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/replacement_muted"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="3 m³ used" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Fees & Adjustments Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ReplacementCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/ReplacementSectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/replacement_fees_title" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRubbish"
                        style="@style/ReplacementField"
                        android:hint="@string/replacement_rubbish"
                        app:suffixText="@string/replacement_khr">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRubbish"
                            style="@style/ReplacementInput" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilOther"
                            style="@style/ReplacementField"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/replacement_other"
                            app:suffixText="@string/replacement_khr">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etOther"
                                style="@style/ReplacementInput" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="1dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDiscount"
                            style="@style/ReplacementField"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/replacement_discount"
                            app:suffixText="@string/replacement_khr">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDiscount"
                                style="@style/ReplacementInput" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDiscountReason"
                        style="@style/ReplacementField"
                        android:hint="@string/if_discount_reason_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDiscountReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="500"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/if_currency_khr"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delete Draft Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteDraft"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rd_delete"
                android:textAllCaps="false"
                android:textColor="#B42318"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/replacement_border" />

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/replacement_surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="8dp"
            android:textColor="@color/replacement_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/replacement_total"
                    android:textColor="@color/replacement_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSaveState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/replacement_ready"
                    android:textColor="@color/replacement_success"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/replacement_navy"
                android:textSize="25sp"
                tools:text="437,000 ៛" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0"
                android:minHeight="52dp"
                android:text="@string/replacement_save"
                android:textAllCaps="false"
                android:textColor="@color/replacement_navy"
                app:cornerRadius="14dp"
                app:strokeColor="@color/replacement_border" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIssue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:letterSpacing="0"
                android:minHeight="52dp"
                android:text="@string/replacement_issue"
                android:textAllCaps="false"
                android:textColor="@color/replacement_surface"
                app:backgroundTint="@color/replacement_navy"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>