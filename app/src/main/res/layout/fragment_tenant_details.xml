<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnBackTenantDetails"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#111827" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/btnBackTenantDetails"
            android:text="Tenant Details"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="40dp">

            <!-- Profile Overview Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_stroke"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvDetailsFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#111827"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Sokha Chan" />

                <TextView
                    android:id="@+id/tvDetailsPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    tools:text="+855 12 345 678" />

                <TextView
                    android:id="@+id/tvDetailsIdOrPassport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    tools:text="ID: N12345678" />
            </LinearLayout>

            <!-- Current Tenancy Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Current Tenancy"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutActiveTenancyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_stroke"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvActiveBuildingRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Campus Residence A • Room 101" />

                <TextView
                    android:id="@+id/tvActiveRentDeposit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#4B5563"
                    android:textSize="13sp"
                    tools:text="Rent: 1,000,000 KHR • Deposit: 1,000,000 KHR" />

                <TextView
                    android:id="@+id/tvActiveMoveInDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    tools:text="Moved in: 29 Sep 2026" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAssignedRoom"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#F3F4F6"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="View Room"
                        android:textAllCaps="false"
                        android:textColor="#111827"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMoveOutTenant"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FEE2E2"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Move Out"
                        android:textAllCaps="false"
                        android:textColor="#DC2626"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoActiveTenancy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_stroke"
                android:padding="16dp"
                android:text="No active tenancy. Tenant is not assigned to any room."
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAssignRoom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#111827"
                android:text="Assign Room"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                app:cornerRadius="10dp" />

            <!-- Rental History Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Rental History"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTenancyHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>