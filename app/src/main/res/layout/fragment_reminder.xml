<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rr_background"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btnRemindersBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/rr_back"
        android:src="@drawable/ic_arrow_back" />

    <!-- Title & Subtitle -->
    <TextView
        style="@style/RRBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/rr_title"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        style="@style/RRCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="16dp"
        android:text="@string/rr_subtitle"
        android:textSize="13sp" />

    <!-- Notification Permission / Settings Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/RRCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:cardCornerRadius="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ic_title"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_notifications" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReminderPermission"
                    style="@style/RRBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    tools:text="Notifications enabled" />

                <TextView
                    android:id="@+id/tvReminderPermissionHint"
                    style="@style/RRCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    tools:text="9:00 AM · Cambodia time" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnReminderSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/rr_settings"
                android:padding="15dp"
                android:src="@drawable/ref_chvron" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Filter Chips Carousel -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/reminderFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Filter 1: Overdue -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipOverdue"
                style="@style/RRCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvFilterOverdue"
                        style="@style/RRBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/rr_overdue"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCountOverdue"
                        style="@style/RRBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:minWidth="22dp"
                        android:minHeight="22dp"
                        android:paddingHorizontal="4dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter 2: Today -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipToday"
                style="@style/RRCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvFilterToday"
                        style="@style/RRBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/rr_today"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCountToday"
                        style="@style/RRBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:minWidth="22dp"
                        android:minHeight="22dp"
                        android:paddingHorizontal="4dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter 3: Upcoming -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipUpcoming"
                style="@style/RRCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvFilterUpcoming"
                        style="@style/RRBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/rr_upcoming"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCountUpcoming"
                        style="@style/RRBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:minWidth="22dp"
                        android:minHeight="22dp"
                        android:paddingHorizontal="4dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Sorted Indicator Label -->
    <TextView
        style="@style/RRCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:text="@string/rr_sorted_short" />

    <!-- Main List Container & Feedback States -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listReminders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingBottom="12dp" />

        <ProgressBar
            android:id="@+id/progressReminders"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layoutReminderEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvReminderEmptyTitle"
                style="@style/RRBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReminderEmptyBody"
                style="@style/RRCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReminderRetry"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/rr_retry"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- Schedule Info Footer Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/RRCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ic_title"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_calender" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RRBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rr_schedule_title"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/RRCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/rr_schedule"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>