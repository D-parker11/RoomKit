<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/roomkit_size_12"
    app:cardBackgroundColor="@color/roomkit_white"
    app:cardCornerRadius="@dimen/roomkit_card_radius_medium"
    app:cardElevation="@dimen/roomkit_size_0"
    app:strokeColor="@color/roomkit_border"
    app:strokeWidth="@dimen/roomkit_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/roomkit_size_16">

        <!-- Header: Avatar, Tenant Name & Room/Building -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="@dimen/roomkit_size_44"
                android:layout_height="@dimen/roomkit_size_44"
                android:background="@color/roomkit_selected_soft"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_18"
                android:textStyle="bold"
                tools:text="CS" />

            <LinearLayout
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/roomkit_size_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTenantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="2"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_17"
                    android:textStyle="bold"
                    tools:text="Channdavith Sovann" />

                <TextView
                    android:id="@+id/tvRoomBuilding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_size_3"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/roomkit_text_secondary"
                    android:textSize="@dimen/roomkit_text_13"
                    tools:text="Room 01 · Proser" />
            </LinearLayout>
        </LinearLayout>

        <!-- Balance Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_button_radius_compact"
            android:fontFamily="sans-serif"
            android:text="Balance due"
            android:textColor="@color/roomkit_text_secondary"
            android:textSize="@dimen/roomkit_text_13" />

        <!-- Remaining Balance & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRemainingBalance"
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_25"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="@dimen/roomkit_text_25"
                app:autoSizeMinTextSize="@dimen/roomkit_text_18"
                app:autoSizeStepGranularity="@dimen/roomkit_text_1"
                app:autoSizeTextType="uniform"
                tools:text="846,000 KHR" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/roomkit_size_8"
                android:fontFamily="sans-serif"
                android:paddingHorizontal="@dimen/roomkit_size_10"
                android:paddingVertical="@dimen/roomkit_size_5"
                android:textColor="@color/roomkit_warning"
                android:textSize="@dimen/roomkit_text_12"
                android:textStyle="bold"
                tools:text="Unpaid" />
        </LinearLayout>

        <!-- Due Date & Partial Breakdown -->
        <TextView
            android:id="@+id/tvDueDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_spacing_xs"
            android:fontFamily="sans-serif"
            android:textColor="@color/roomkit_text_secondary"
            android:textSize="@dimen/roomkit_text_13"
            tools:text="Due 05 Dec 2026" />

        <TextView
            android:id="@+id/tvPartialBreakdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_6"
            android:fontFamily="sans-serif"
            android:textColor="@color/roomkit_text_secondary"
            android:textSize="@dimen/roomkit_text_12"
            android:visibility="gone"
            tools:text="Paid: 400,000 KHR · Remaining: 446,000 KHR" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_stroke_width"
            android:layout_marginVertical="@dimen/roomkit_size_12"
            android:background="@color/roomkit_border" />

        <!-- Card Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewInvoice"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:elevation="@dimen/roomkit_size_0"
                android:insetTop="@dimen/roomkit_size_0"
                android:insetBottom="@dimen/roomkit_size_0"
                android:letterSpacing="0"
                android:minHeight="@dimen/roomkit_touch_target"
                android:paddingHorizontal="@dimen/roomkit_size_8"
                android:stateListAnimator="@null"
                android:text="View invoice"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_13"
                android:textStyle="bold"
                app:backgroundTint="@color/roomkit_white"
                app:cornerRadius="@dimen/roomkit_size_10"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width" />

            <Space
                android:layout_width="@dimen/roomkit_size_8"
                android:layout_height="@dimen/roomkit_stroke_width" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordPayment"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:elevation="@dimen/roomkit_size_0"
                android:insetTop="@dimen/roomkit_size_0"
                android:insetBottom="@dimen/roomkit_size_0"
                android:letterSpacing="0"
                android:minHeight="@dimen/roomkit_touch_target"
                android:paddingHorizontal="@dimen/roomkit_size_8"
                android:stateListAnimator="@null"
                android:text="Record payment"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_white"
                android:textSize="@dimen/roomkit_text_13"
                android:textStyle="bold"
                app:backgroundTint="@color/roomkit_text_primary"
                app:cornerRadius="@dimen/roomkit_size_10"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_size_0" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>