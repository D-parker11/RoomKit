<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Void Header Icon -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_rvi_icon"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_rvi_void" />

        <!-- Title & Explanations -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/rvi_title"
            android:textColor="@color/rvi_ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/rvi_explanation"
            android:textColor="@color/rvi_muted"
            android:textSize="14sp" />

        <!-- Policy / Payment Rule Info Banner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rvi_info"
            android:padding="12dp"
            android:text="@string/rvi_payment_rule"
            android:textColor="@color/rvi_muted"
            android:textSize="13sp" />

        <!-- Reason Input Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVoidReason"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="@string/rvi_reason"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:helperText="@string/rvi_helper"
            app:placeholderText="@string/rvi_placeholder">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVoidReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minHeight="112dp"
                android:minLines="3"
                android:textColor="@color/rvi_ink"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Live Validation Error -->
        <TextView
            android:id="@+id/tvVoidError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/rvi_red"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeepInvoice"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/rvi_keep"
                android:textAllCaps="false"
                android:textColor="@color/rvi_ink"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/rvi_border" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoidInvoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:elevation="0dp"
                android:enabled="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:stateListAnimator="@null"
                android:text="@string/rvi_confirm"
                android:textAllCaps="false"
                android:textColor="@color/rvi_action_text"
                android:textSize="13sp"
                app:backgroundTint="@color/rvi_action_background"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>