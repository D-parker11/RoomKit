<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollRoomContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/roomkit_bottom_safe_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/roomkit_screen_padding_horizontal"
            android:paddingTop="@dimen/roomkit_screen_padding_top">

            <!-- Top Header: Back Button, Building Info, & Circular Add Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/roomkit_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/roomkit_spacing_sm"
                    android:layout_toStartOf="@id/btnAddRoom"
                    android:layout_toEndOf="@id/btnBack"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBuildingName"
                        style="@style/TextAppearance.RoomKit.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Real Madrid Residence" />

                    <TextView
                        android:id="@+id/tvBuildingAddress"
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/roomkit_text_secondary"
                        tools:text="St.55, Chamkarmon, Phnom Penh" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddRoom"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Add Room"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/roomkit_primary"
                    app:cornerRadius="24dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_plus_white"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/roomkit_on_primary" />
            </RelativeLayout>

            <!-- 2x2 Summary Metric Cards (Matching Dashboard Architecture) -->
            <!-- Row 1: Rooms & Occupied -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_spacing_lg"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.RoomKit.Card.Stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/roomkit_card_padding_compact">

                        <TextView
                            style="@style/TextAppearance.RoomKit.CardLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ROOMS" />

                        <TextView
                            android:id="@+id/tvSummaryTotalRooms"
                            style="@style/TextAppearance.RoomKit.StatValue.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_spacing_sm"
                            tools:text="12" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.RoomKit.Card.Stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/roomkit_card_padding_compact">

                        <TextView
                            style="@style/TextAppearance.RoomKit.CardLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OCCUPIED" />

                        <TextView
                            android:id="@+id/tvSummaryOccupied"
                            style="@style/TextAppearance.RoomKit.StatValue.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_spacing_sm"
                            android:textColor="@color/roomkit_success"
                            tools:text="9" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2: Vacant & Occupancy % -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_spacing_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.RoomKit.Card.Stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/roomkit_card_padding_compact">

                        <TextView
                            style="@style/TextAppearance.RoomKit.CardLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VACANT" />

                        <TextView
                            android:id="@+id/tvSummaryVacant"
                            style="@style/TextAppearance.RoomKit.StatValue.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_spacing_sm"
                            android:textColor="@color/roomkit_text_primary"
                            tools:text="3" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.RoomKit.Card.Stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/roomkit_card_padding_compact">

                        <TextView
                            style="@style/TextAppearance.RoomKit.CardLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OCCUPANCY" />

                        <TextView
                            android:id="@+id/tvSummaryOccupancyPercent"
                            style="@style/TextAppearance.RoomKit.StatValue.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/roomkit_spacing_sm"
                            android:textColor="@color/roomkit_primary"
                            tools:text="75%" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearchRooms"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/rrs_search_surface"
                app:boxStrokeColor="@color/rrs_search_border"
                app:boxStrokeWidth="1dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/roomkit_text_muted"
                app:endIconMode="clear_text">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearchRooms"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/rrs_search_hint"
                    android:textSize="14sp"
                    android:textColor="@color/roomkit_text_primary"
                    android:textColorHint="@color/roomkit_text_muted"
                    android:singleLine="true"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Filter Tabs: All, Occupied, Vacant -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutRoomFilter"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/roomkit_primary"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="2.5dp"
                app:tabMode="fixed"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="@color/roomkit_primary"
                app:tabTextAppearance="@style/TextAppearance.RoomKit.Tab"
                app:tabTextColor="@color/roomkit_text_muted" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/roomkit_divider" />

            <!-- Frame Container for Room List & Empty Feedback -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_spacing_md">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_room_occupied" />

                <!-- Polished Empty State -->
                <LinearLayout
                    android:id="@+id/layoutEmptyRooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/roomkit_spacing_xxl"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvEmptyTitle"
                        style="@style/TextAppearance.RoomKit.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/roomkit_text_primary"
                        android:textStyle="bold"
                        tools:text="No rooms yet" />

                    <TextView
                        android:id="@+id/tvEmptySubtitle"
                        style="@style/TextAppearance.RoomKit.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Add your first room to this building." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyAddRoom"
                        style="@style/Widget.RoomKit.PrimaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginTop="@dimen/roomkit_spacing_md"
                        android:paddingHorizontal="24dp"
                        android:text="Add Room"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
