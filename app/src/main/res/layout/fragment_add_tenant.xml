<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/roomkit_size_24"
        android:paddingTop="@dimen/roomkit_size_20"
        android:paddingBottom="@dimen/roomkit_size_12">

        <ImageView
            android:id="@+id/btnBackAddTenant"
            android:layout_width="@dimen/roomkit_size_40"
            android:layout_height="@dimen/roomkit_size_40"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="@dimen/roomkit_size_8"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/roomkit_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/roomkit_size_12"
            android:layout_toEndOf="@id/btnBackAddTenant"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTenantFormTitle"
                style="@style/TextAppearance.RoomKit.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Tenant"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_22" />

            <TextView
                android:id="@+id/tvTenantFormSubtitle"
                style="@style/TextAppearance.RoomKit.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                android:text="Create a tenant profile"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_13" />
        </LinearLayout>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/roomkit_bottom_safe_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/roomkit_size_24"
            android:paddingTop="@dimen/roomkit_size_8"
            android:paddingBottom="@dimen/roomkit_size_24">

            <!-- PERSONAL INFORMATION SECTION -->
            <TextView
                style="@style/TextAppearance.RoomKit.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/roomkit_size_8"
                android:text="PERSONAL INFORMATION" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/roomkit_size_20"
                app:cardElevation="@dimen/roomkit_size_0"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="@dimen/roomkit_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_size_20">

                    <!-- Full Name Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFullName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full Name"
                        app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="@dimen/roomkit_stroke_width"
                        app:boxStrokeWidthFocused="@dimen/roomkit_stroke_width_focused"
                        app:errorEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFullName"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/roomkit_button_height"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_15" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Phone Number Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPhoneNumber"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_8"
                        android:hint="Phone Number"
                        app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="@dimen/roomkit_stroke_width"
                        app:boxStrokeWidthFocused="@dimen/roomkit_stroke_width_focused"
                        app:errorEnabled="true"
                        app:helperText="Used to find this tenant later"
                        app:startIconDrawable="@drawable/ic_phone"
                        app:startIconTint="@color/roomkit_text_muted">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhoneNumber"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/roomkit_button_height"
                            android:imeOptions="actionNext"
                            android:inputType="phone"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_15" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- ID / Passport Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilIdOrPassport"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_8"
                        android:hint="ID / Passport"
                        app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="@dimen/roomkit_stroke_width"
                        app:boxStrokeWidthFocused="@dimen/roomkit_stroke_width_focused"
                        app:helperText="Optional but useful for duplicate checking">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etIdPassport"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/roomkit_button_height"
                            android:imeOptions="actionNext"
                            android:inputType="textCapCharacters"
                            android:maxLines="1"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_15" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Notes / Remarks Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNotes"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_8"
                        android:hint="Notes / Remarks"
                        app:boxCornerRadiusBottomEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusBottomStart="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopEnd="@dimen/roomkit_button_radius_compact"
                        app:boxCornerRadiusTopStart="@dimen/roomkit_button_radius_compact"
                        app:boxStrokeColor="@color/roomkit_primary"
                        app:boxStrokeWidth="@dimen/roomkit_stroke_width"
                        app:boxStrokeWidthFocused="@dimen/roomkit_stroke_width_focused">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNote"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/roomkit_size_110"
                            android:gravity="top|start"
                            android:imeOptions="actionDone"
                            android:inputType="textMultiLine"
                            android:paddingTop="@dimen/roomkit_size_12"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_15" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save Tenant Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTenant"
                style="@style/Widget.RoomKit.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/roomkit_control_height"
                android:layout_marginTop="@dimen/roomkit_spacing_xxl"
                android:text="Save Tenant"
                android:textAllCaps="false"
                android:textSize="@dimen/roomkit_text_16"
                android:textStyle="bold"
                app:cornerRadius="@dimen/roomkit_card_radius_medium" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>