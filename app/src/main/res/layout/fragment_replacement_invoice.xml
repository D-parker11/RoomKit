<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/roomkit_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/roomkit_size_12"
        android:paddingTop="@dimen/roomkit_size_12"
        android:paddingEnd="@dimen/roomkit_size_20"
        android:paddingBottom="@dimen/roomkit_size_12">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/roomkit_touch_target"
            android:layout_height="@dimen/roomkit_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/replacement_back"
            android:padding="@dimen/roomkit_size_12"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="@dimen/roomkit_size_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/roomkit_size_6"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEditorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/replacement_title"
                android:textColor="@color/roomkit_primary"
                android:textSize="@dimen/roomkit_text_20" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/roomkit_size_3"
                android:text="@string/replacement_subtitle"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_12" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Loading Indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressLoading"
        android:layout_width="match_parent"
        android:layout_height="@dimen/roomkit_size_3"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/roomkit_partial"
        app:trackColor="@color/roomkit_partial_bg" />

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/roomkit_size_0"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/roomkit_size_20">

            <!-- Card 1: Summary & Navigation -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/roomkit_size_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvRoom"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/roomkit_primary"
                            android:textSize="@dimen/roomkit_text_22"
                            tools:text="Room 04" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_info_soft"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="@dimen/roomkit_size_12"
                            android:paddingVertical="@dimen/roomkit_size_6"
                            android:text="@string/replacement_draft"
                            android:textColor="@color/roomkit_warning"
                            android:textSize="@dimen/roomkit_text_12" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTenant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_5"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_14"
                        tools:text="Ngoun Channdevith" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_16"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPeriod"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_13"
                            tools:text="October 2026" />

                        <TextView
                            android:id="@+id/tvDue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/roomkit_text_secondary"
                            android:textSize="@dimen/roomkit_text_13"
                            tools:text="Due Nov 5, 2026" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/roomkit_stroke_width"
                        android:layout_marginTop="@dimen/roomkit_size_16"
                        android:background="@color/roomkit_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDraftNumber"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/roomkit_text_secondary"
                            android:textSize="@dimen/roomkit_text_13"
                            tools:text="Draft #0012" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOriginal"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0"
                            android:minHeight="@dimen/roomkit_touch_target"
                            android:textAllCaps="false"
                            android:textColor="@color/roomkit_partial"
                            android:textSize="@dimen/roomkit_text_13"
                            tools:text="View original #0011" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEditorNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_info_soft"
                        android:padding="@dimen/roomkit_size_12"
                        android:text="@string/replacement_note"
                        android:textColor="@color/roomkit_partial"
                        android:textSize="@dimen/roomkit_text_13" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAbout"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:letterSpacing="0"
                        android:minHeight="@dimen/roomkit_touch_target"
                        android:text="@string/replacement_details"
                        android:textAllCaps="false"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_12" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Rent Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/roomkit_size_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.RoomKit.SectionLabel"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_weight="1"
                            android:text="@string/replacement_rent_title" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRent"
                        style="@style/Widget.RoomKit.Field"
                        android:hint="@string/replacement_rent_hint"
                        app:suffixText="@string/replacement_khr">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRent"
                            style="@style/Widget.RoomKit.EditText.Compact" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Electricity Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/roomkit_size_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.RoomKit.SectionLabel"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_weight="1"
                            android:text="@string/replacement_electricity_title" />

                        <TextView
                            android:id="@+id/tvElectricityCharge"
                            style="@style/TextAppearance.RoomKit.SectionLabel"
                            android:textColor="@color/roomkit_partial"
                            tools:text="7,000 ៛" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilElectricityPrevious"
                            style="@style/Widget.RoomKit.Field"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_weight="1"
                            android:hint="@string/replacement_previous"
                            app:suffixText="@string/replacement_kwh">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etElectricityPrevious"
                                style="@style/Widget.RoomKit.EditText.Compact" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Space
                            android:layout_width="@dimen/roomkit_size_12"
                            android:layout_height="@dimen/roomkit_stroke_width" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilElectricityCurrent"
                            style="@style/Widget.RoomKit.Field"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_weight="1"
                            android:hint="@string/replacement_current"
                            app:suffixText="@string/replacement_kwh">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etElectricityCurrent"
                                style="@style/Widget.RoomKit.EditText.Compact" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilElectricityRate"
                        style="@style/Widget.RoomKit.Field"
                        android:hint="@string/replacement_rate"
                        app:suffixText="@string/replacement_rate_khr">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etElectricityRate"
                            style="@style/Widget.RoomKit.EditText.Compact" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvElectricityUsage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_12"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13"
                        tools:text="7 kWh used" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Water Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/roomkit_size_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.RoomKit.SectionLabel"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_weight="1"
                            android:text="@string/replacement_water_title" />

                        <TextView
                            android:id="@+id/tvWaterCharge"
                            style="@style/TextAppearance.RoomKit.SectionLabel"
                            android:textColor="@color/roomkit_partial"
                            tools:text="7,000 ៛" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvWaterMethod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_spacing_xs"
                        android:text="@string/replacement_water_fixed"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13" />

                    <LinearLayout
                        android:id="@+id/rowWaterReadings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilWaterPrevious"
                            style="@style/Widget.RoomKit.Field"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_weight="1"
                            android:hint="@string/replacement_previous"
                            app:suffixText="@string/replacement_m3">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etWaterPrevious"
                                style="@style/Widget.RoomKit.EditText.Compact" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Space
                            android:layout_width="@dimen/roomkit_size_12"
                            android:layout_height="@dimen/roomkit_stroke_width" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilWaterCurrent"
                            style="@style/Widget.RoomKit.Field"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_weight="1"
                            android:hint="@string/replacement_current"
                            app:suffixText="@string/replacement_m3">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etWaterCurrent"
                                style="@style/Widget.RoomKit.EditText.Compact" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWaterRate"
                        style="@style/Widget.RoomKit.Field"
                        android:hint="@string/replacement_fixed_fee"
                        app:suffixText="@string/replacement_khr">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWaterRate"
                            style="@style/Widget.RoomKit.EditText.Compact" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvWaterUsage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_12"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_13"
                        android:visibility="gone"
                        tools:text="3 m³ used" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Fees & Adjustments Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.RoomKit.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/roomkit_size_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/roomkit_card_radius_medium">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.RoomKit.SectionLabel"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_weight="1"
                            android:text="@string/replacement_fees_title" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRubbish"
                        style="@style/Widget.RoomKit.Field"
                        android:hint="@string/replacement_rubbish"
                        app:suffixText="@string/replacement_khr">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRubbish"
                            style="@style/Widget.RoomKit.EditText.Compact" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilOther"
                            style="@style/Widget.RoomKit.Field"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_weight="1"
                            android:hint="@string/replacement_other"
                            app:suffixText="@string/replacement_khr">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etOther"
                                style="@style/Widget.RoomKit.EditText.Compact" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Space
                            android:layout_width="@dimen/roomkit_size_12"
                            android:layout_height="@dimen/roomkit_stroke_width" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDiscount"
                            style="@style/Widget.RoomKit.Field"
                            android:layout_width="@dimen/roomkit_size_0"
                            android:layout_weight="1"
                            android:hint="@string/replacement_discount"
                            app:suffixText="@string/replacement_khr">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDiscount"
                                style="@style/Widget.RoomKit.EditText.Compact" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDiscountReason"
                        style="@style/Widget.RoomKit.Field"
                        android:hint="@string/if_discount_reason_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDiscountReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="500"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/roomkit_size_8"
                        android:text="@string/if_currency_khr"
                        android:textColor="@color/roomkit_slate_500"
                        android:textSize="@dimen/roomkit_text_12" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delete Draft Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteDraft"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/roomkit_touch_target"
                android:text="@string/rd_delete"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_error"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/roomkit_stroke_width"
        android:background="@color/roomkit_border" />

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/roomkit_white"
        android:orientation="vertical"
        android:paddingStart="@dimen/roomkit_size_20"
        android:paddingTop="@dimen/roomkit_size_12"
        android:paddingEnd="@dimen/roomkit_size_20"
        android:paddingBottom="@dimen/roomkit_size_12">

        <TextView
            android:id="@+id/tvNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="@dimen/roomkit_size_8"
            android:textColor="@color/roomkit_error"
            android:textSize="@dimen/roomkit_text_13"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/replacement_total"
                    android:textColor="@color/roomkit_text_secondary"
                    android:textSize="@dimen/roomkit_text_13" />

                <TextView
                    android:id="@+id/tvSaveState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_size_3"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/replacement_ready"
                    android:textColor="@color/roomkit_success"
                    android:textSize="@dimen/roomkit_text_11" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/roomkit_primary"
                android:textSize="@dimen/roomkit_text_25"
                tools:text="437,000 ៛" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_10"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0"
                android:minHeight="@dimen/roomkit_action_height"
                android:text="@string/replacement_save"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_primary"
                app:cornerRadius="@dimen/roomkit_button_radius_compact"
                app:strokeColor="@color/roomkit_border" />

            <Space
                android:layout_width="@dimen/roomkit_size_12"
                android:layout_height="@dimen/roomkit_stroke_width" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIssue"
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:letterSpacing="0"
                android:minHeight="@dimen/roomkit_action_height"
                android:text="@string/replacement_issue"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_white"
                app:backgroundTint="@color/roomkit_primary"
                app:cornerRadius="@dimen/roomkit_button_radius_compact" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>