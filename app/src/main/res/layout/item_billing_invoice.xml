<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/rb_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/rb_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Room/Building & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvInvoiceRoomBuilding"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:textColor="@color/rb_ink"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Room 01" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvInvoiceStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="@color/rb_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Unpaid" />
        </LinearLayout>

        <!-- Tenant Name -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvInvoiceTenantName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/rb_muted"
            android:textSize="13sp"
            tools:text="Channdavith Sovann" />

        <!-- Total Amount & Forward Arrow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvInvoiceTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/rb_ink"
                android:textSize="23sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="23sp"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                tools:text="846,000 KHR" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rb_right"
                app:tint="@color/rb_muted" />
        </LinearLayout>

        <!-- Due Date Info -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvInvoicePeriodDueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:textColor="@color/rb_muted"
            android:textSize="13sp"
            tools:text="Due 05 Dec 2026" />

        <!-- Optional Payment / Cancellation Detail -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvInvoicePaymentDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:textColor="@color/rb_muted"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Cancelled · No payment due" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>