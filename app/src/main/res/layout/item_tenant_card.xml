<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.RoomKit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/roomkit_size_12"
    app:cardCornerRadius="@dimen/roomkit_size_20"
    app:cardElevation="@dimen/roomkit_size_0"
    app:strokeColor="@color/roomkit_border"
    app:strokeWidth="@dimen/roomkit_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/roomkit_card_radius_medium">

        <!-- Top Row: Tenant Name & Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/fullName"
                style="@style/TextAppearance.RoomKit.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/tvTenantStatusBadge"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_18"
                android:textStyle="bold"
                tools:text="Davith Sok" />

            <TextView
                android:id="@+id/tvTenantStatusBadge"
                style="@style/TextAppearance.RoomKit.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:paddingHorizontal="@dimen/roomkit_size_12"
                android:paddingVertical="@dimen/roomkit_spacing_xs"
                tools:background="@drawable/bg_badge_paid_pill"
                tools:text="Active"
                tools:textColor="@color/roomkit_success_dark" />
        </RelativeLayout>

        <!-- Phone Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/roomkit_size_15"
                android:layout_height="@dimen/roomkit_size_15"
                android:contentDescription="Phone"
                android:src="@drawable/ic_phone"
                app:tint="@color/roomkit_text_muted" />

            <TextView
                android:id="@+id/tvTenantPhone"
                style="@style/TextAppearance.RoomKit.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/roomkit_size_6"
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_13"
                tools:text="+855 12 345 678" />
        </LinearLayout>

        <!-- Room / Property Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/roomkit_size_15"
                android:layout_height="@dimen/roomkit_size_15"
                android:contentDescription="Room"
                android:src="@drawable/ic_home"
                app:tint="@color/roomkit_primary" />

            <TextView
                android:id="@+id/tvRoomAndBuilding"
                style="@style/TextAppearance.RoomKit.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/roomkit_size_6"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_14"
                android:textStyle="bold"
                tools:text="Room 01 · Barce Residence" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/roomkit_stroke_width"
            android:layout_marginVertical="@dimen/roomkit_button_radius_compact"
            android:background="@color/roomkit_divider" />

        <!-- Bottom Grid: Deposit & Move-In Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.RoomKit.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deposit"
                    android:textColor="@color/roomkit_text_muted"
                    android:textSize="@dimen/roomkit_text_12" />

                <TextView
                    android:id="@+id/tvDepositValue"
                    style="@style/TextAppearance.RoomKit.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_16"
                    android:textStyle="bold"
                    tools:text="400,000 ៛" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/roomkit_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.RoomKit.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moved in"
                    android:textColor="@color/roomkit_text_muted"
                    android:textSize="@dimen/roomkit_text_12" />

                <TextView
                    android:id="@+id/tvMoveInDateValue"
                    style="@style/TextAppearance.RoomKit.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
                    android:textColor="@color/roomkit_text_secondary"
                    android:textSize="@dimen/roomkit_text_14"
                    android:textStyle="bold"
                    tools:text="Aug 21" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Action Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_button_radius_compact">

            <TextView
                android:id="@+id/btnViewRoomAction"
                style="@style/TextAppearance.RoomKit.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="View Room >"
                android:textColor="@color/roomkit_primary"
                android:textSize="@dimen/roomkit_text_13"
                android:textStyle="bold" />
        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>