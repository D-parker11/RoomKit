<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ================================================================= -->
    <!-- RoomKit Typography System                                         -->
    <!-- ================================================================= -->

    <style name="TextAppearance.RoomKit.Greeting" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/roomkit_text_secondary</item>
    </style>

    <style name="TextAppearance.RoomKit.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/roomkit_text_primary</item>
    </style>

    <style name="TextAppearance.RoomKit.SectionTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/roomkit_text_primary</item>
    </style>

    <style name="TextAppearance.RoomKit.CardLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/roomkit_text_secondary</item>
    </style>

    <style name="TextAppearance.RoomKit.StatValue" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/roomkit_text_primary</item>
    </style>

    <style name="TextAppearance.RoomKit.StatValue.Small">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RoomKit.MoneyLarge" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/roomkit_text_primary</item>
    </style>

    <style name="TextAppearance.RoomKit.MoneyMedium" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RoomKit.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/roomkit_text_secondary</item>
    </style>

    <style name="TextAppearance.RoomKit.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/roomkit_text_muted</item>
    </style>

    <!-- Tab Typography -->
    <style name="TextAppearance.RoomKit.Tab" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- ================================================================= -->
    <!-- RoomKit Widget Components                                         -->
    <!-- ================================================================= -->

    <!-- Base Flat Card -->
    <style name="Widget.RoomKit.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/roomkit_surface</item>
        <item name="cardCornerRadius">@dimen/roomkit_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/roomkit_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Stat Card (16dp Radius) -->
    <style name="Widget.RoomKit.Card.Stat">
        <item name="cardCornerRadius">@dimen/roomkit_card_radius_sm</item>
    </style>

    <!-- Month Selector Capsule Card -->
    <style name="Widget.RoomKit.Card.MonthPill">
        <item name="cardBackgroundColor">@color/roomkit_border</item>
        <item name="cardCornerRadius">@dimen/roomkit_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.RoomKit.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">@dimen/roomkit_button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/roomkit_on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/roomkit_primary</item>
        <item name="cornerRadius">@dimen/roomkit_button_radius</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.RoomKit.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/roomkit_button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/roomkit_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/roomkit_surface</item>
        <item name="cornerRadius">@dimen/roomkit_button_radius</item>
        <item name="strokeColor">@color/roomkit_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    !-- Neutral Soft Surface Button (e.g., View Rooms) -->
    <style name="Widget.RoomKit.Button.NeutralSurface" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/roomkit_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">#F2F4F7</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Outlined Button (e.g., Edit) -->
    <style name="Widget.RoomKit.Button.OutlinedSmall" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/roomkit_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/roomkit_surface</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/roomkit_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="TextAppearance.RoomKit.Status" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Menu Row Card -->
    <style name="Widget.RoomKit.Card.Menu" parent="Widget.RoomKit.Card">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="ReplacementCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="cardBackgroundColor">@color/replacement_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/replacement_border</item>
    </style>
    <style name="ReplacementSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/replacement_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="ReplacementField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="boxBackgroundColor">@color/replacement_surface</item>
        <item name="boxStrokeColor">@color/replacement_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:textColorHint">@color/replacement_muted</item>
        <item name="hintTextColor">@color/replacement_muted</item>
        <item name="suffixTextColor">@color/replacement_muted</item>
        <item name="errorTextColor">@color/replacement_error</item>
    </style>
    <style name="ReplacementInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/replacement_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:inputType">number</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="InvoiceActionBase" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="InvoiceActionPrimary" parent="InvoiceActionBase">
        <item name="backgroundTint">#111B32</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="iconTint">#FFFFFF</item>
    </style>
    <style name="InvoiceActionSecondary" parent="InvoiceActionBase">
        <item name="backgroundTint">#FFFFFF</item>
        <item name="android:textColor">#26354D</item>
        <item name="iconTint">#52627B</item>
        <item name="strokeColor">#DDE4EE</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="InvoiceActionLink" parent="InvoiceActionBase">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">#3867CC</item>
        <item name="iconTint">#3867CC</item>
    </style>
    <style name="InvoiceActionDanger" parent="InvoiceActionLink">
        <item name="android:textColor">#B42318</item>
        <item name="iconTint">#B42318</item>
    </style>

    <style name="RRCaption" parent="RRBody">
        <item name="android:textColor">@color/rr_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="RRCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/rr_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/rr_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="RRBody" parent="">
        <item name="android:textColor">@color/rr_navy</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="MRBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/mr_text</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="MRCaption" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/mr_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="MRHeading" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/mr_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="MRCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/mr_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/mr_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="MRInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/mr_surface</item>
        <item name="boxStrokeColor">@color/mr_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/mr_accent</item>
        <item name="android:textColorHint">@color/mr_secondary</item>
    </style>
    <style name="MRPrimary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/mr_button_tint</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/mr_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="MRTextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/mr_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="RksLabel">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/rks_muted</item><item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item><item name="android:letterSpacing">0.1</item>
        <item name="android:layout_marginTop">28dp</item><item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="RksInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item><item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item><item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item><item name="boxStrokeColor">@color/rks_muted</item>
        <item name="android:textColorHint">@color/rks_muted</item>
    </style>

    <style name="Rks2Card" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/rks2_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/rks2_border</item>
    </style>
    <style name="Rks2Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/rks2_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="Rks2Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">@color/rks2_text</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="Rks2Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/rks2_text</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/rks2_border</item>
    </style>
    <style name="Widget.RoomKit.PropertyCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/rp_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/rp_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="TextAppearance.RoomKit.PropertyBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/rp_muted</item>
    </style>
    <style name="TextAppearance.RoomKit.PropertyHeading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/rp_ink</item>
    </style>
    <style name="Widget.RoomKit.PropertyButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/rp_ink</item>
        <item name="android:textColor">@color/rp_surface</item>
    </style>
    <style name="Widget.RoomKit.BillingReferenceChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/rb_filter_text</item>
        <item name="chipBackgroundColor">@color/rb_filter_background</item>
        <item name="chipStrokeColor">@color/rb_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">24dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:checkable">true</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipMinTouchTargetSize">48dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
    </style>
</resources>