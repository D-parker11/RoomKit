<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.RoomKit" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/roomkit_primary</item>
        <item name="colorPrimaryVariant">@color/roomkit_primary_dark</item>
        <item name="colorOnPrimary">@color/roomkit_on_primary</item>

        <!-- Surfaces & Backgrounds -->
        <item name="android:colorBackground">@color/roomkit_background</item>
        <item name="colorSurface">@color/roomkit_surface</item>
        <item name="colorOnSurface">@color/roomkit_text_primary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/roomkit_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
