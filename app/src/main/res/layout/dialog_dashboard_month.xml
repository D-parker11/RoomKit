<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            app:cardBackgroundColor="@color/roomkit_border"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/dm_choose_month"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_22" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:letterSpacing="0"
                android:text="@string/dm_cancel"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_text_secondary"
                app:cornerRadius="24dp" />
        </LinearLayout>

        <!-- Selected billing period -->
        <TextView
            android:id="@+id/tvSelectedPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/roomkit_text_secondary"
            android:textSize="@dimen/roomkit_text_14" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviousYear"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="‹"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_28"
                app:cornerRadius="24dp" />

            <TextView
                android:id="@+id/tvYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_20" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextYear"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="›"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_28"
                app:cornerRadius="24dp" />
        </LinearLayout>

        <!-- Four rows of three months, populated in Kotlin -->
        <LinearLayout
            android:id="@+id/monthGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThisMonth"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:letterSpacing="0"
            android:text="@string/dm_this_month"
            android:textAllCaps="false"
            android:textColor="@color/roomkit_primary"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="@string/dm_apply"
            android:textAllCaps="false"
            android:textColor="@color/roomkit_white"
            android:textSize="@dimen/roomkit_text_16"
            app:backgroundTint="@color/roomkit_primary"
            app:cornerRadius="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>