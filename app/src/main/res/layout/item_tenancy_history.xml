<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/roomkit_size_8"
    android:background="@drawable/bg_card_stroke"
    android:orientation="vertical"
    android:padding="@dimen/roomkit_size_12">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvHistoryRoomBuilding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/roomkit_text_primary"
            android:textSize="@dimen/roomkit_text_15"
            android:textStyle="bold"
            tools:text="Room 101 • Campus Residence A" />

        <TextView
            android:id="@+id/tvHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="@color/roomkit_gray_500"
            android:textSize="@dimen/roomkit_text_12"
            android:textStyle="bold"
            tools:text="ENDED" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvHistoryDates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/roomkit_spacing_xs"
        android:textColor="@color/roomkit_gray_600"
        android:textSize="@dimen/roomkit_text_12"
        tools:text="15 Jan 2026 - 30 Jun 2026" />

    <TextView
        android:id="@+id/tvHistoryRent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/roomkit_stroke_width_focused"
        android:textColor="@color/roomkit_gray_500"
        android:textSize="@dimen/roomkit_text_12"
        tools:text="1,000,000 KHR / month" />
<Button android:id="@+id/btnHistorySettlement"
    android:layout_width="match_parent"
    android:layout_height="@dimen/roomkit_touch_target"
    android:text="@string/move_out_history"
    android:textAllCaps="false" />
</LinearLayout>