<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingVertical="@dimen/roomkit_size_8">

    <TextView
        android:id="@+id/tvSummaryRowLabel"
        android:layout_width="@dimen/roomkit_size_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/roomkit_text_secondary"
        android:textSize="@dimen/roomkit_text_14" />

    <TextView
        android:id="@+id/tvSummaryRowValue"
        android:layout_width="@dimen/roomkit_size_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/roomkit_size_12"
        android:gravity="end"
        android:textColor="@color/roomkit_text_primary"
        android:textSize="@dimen/roomkit_text_14"
        android:textStyle="bold" />
</LinearLayout>