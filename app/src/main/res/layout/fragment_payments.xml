<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_background">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/paymentsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Screen Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Payments"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_30"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:text="Track collections and balances."
                android:textColor="@color/roomkit_text_secondary"
                android:textSize="@dimen/roomkit_text_15" />

            <!-- Month Navigation Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="48dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Previous month"
                        android:padding="13dp"
                        android:src="@drawable/ic_rb_left"
                        app:tint="@color/roomkit_text_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_calender"
                            app:tint="@color/roomkit_text_primary" />

                        <TextView
                            android:id="@+id/tvSelectedMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="November 2026"
                            android:textColor="@color/roomkit_text_primary"
                            android:textSize="@dimen/roomkit_text_16"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnNextMonth"
                        android:layout_width="48dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next month"
                        android:padding="13dp"
                        android:src="@drawable/ic_rb_right"
                        app:tint="@color/roomkit_text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Summary Totals Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Outstanding balance"
                        android:textColor="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_15" />

                    <TextView
                        android:id="@+id/tvSummaryOutstanding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="1,746,000 KHR"
                        android:textColor="@color/roomkit_text_primary"
                        android:textSize="@dimen/roomkit_text_30"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="@dimen/roomkit_text_30"
                        app:autoSizeMinTextSize="@dimen/roomkit_text_18"
                        app:autoSizeStepGranularity="@dimen/roomkit_text_1"
                        app:autoSizeTextType="uniform" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/roomkit_border" />

                    <!-- Collected vs Overdue Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Collected -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Collected"
                                android:textColor="@color/roomkit_text_secondary"
                                android:textSize="@dimen/roomkit_text_14" />

                            <TextView
                                android:id="@+id/tvSummaryCollected"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif"
                                android:text="0 KHR"
                                android:textColor="@color/roomkit_success"
                                android:textSize="@dimen/roomkit_text_22"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="20dp"
                            android:background="@color/roomkit_border" />

                        <!-- Overdue -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Overdue"
                                android:textColor="@color/roomkit_text_secondary"
                                android:textSize="@dimen/roomkit_text_14" />

                            <TextView
                                android:id="@+id/tvSummaryOverdue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif"
                                android:text="0 KHR"
                                android:textColor="@color/roomkit_text_secondary"
                                android:textSize="@dimen/roomkit_text_22"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search Field Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/roomkit_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/roomkit_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="@color/roomkit_text_primary" />

                    <EditText
                        android:id="@+id/etSearchPayments"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/roomkit_text_primary"
                        android:textColorHint="@color/roomkit_text_secondary"
                        android:textSize="@dimen/roomkit_text_15" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Full-width filters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.RoomKit.Chip.Filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:checkable="true"
                    android:ellipsize="end"
                    android:text="@string/rb_all"
                    android:textAlignment="center"
                    android:textSize="@dimen/roomkit_text_12"
                    app:checkedIconVisible="false"
                    app:chipIconVisible="false"
                    app:chipMinHeight="40dp"
                    app:chipStartPadding="4dp"
                    app:chipEndPadding="4dp"
                    app:textStartPadding="2dp"
                    app:textEndPadding="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUnpaid"
                    style="@style/Widget.RoomKit.Chip.Filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:checkable="true"
                    android:ellipsize="end"
                    android:text="@string/rb_unpaid"
                    android:textAlignment="center"
                    android:textSize="@dimen/roomkit_text_12"
                    app:checkedIconVisible="false"
                    app:chipIconVisible="false"
                    app:chipMinHeight="40dp"
                    app:chipStartPadding="4dp"
                    app:chipEndPadding="4dp"
                    app:textStartPadding="2dp"
                    app:textEndPadding="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPaid"
                    style="@style/Widget.RoomKit.Chip.Filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:checkable="true"
                    android:ellipsize="end"
                    android:text="@string/rb_paid"
                    android:textAlignment="center"
                    android:textSize="@dimen/roomkit_text_12"
                    app:checkedIconVisible="false"
                    app:chipIconVisible="false"
                    app:chipMinHeight="40dp"
                    app:chipStartPadding="4dp"
                    app:chipEndPadding="4dp"
                    app:textStartPadding="2dp"
                    app:textEndPadding="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMore"
                    style="@style/Widget.RoomKit.Chip.Filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:checkable="true"
                    android:contentDescription="@string/rb_more"
                    android:ellipsize="end"
                    android:text="@string/rb_more"
                    android:textAlignment="center"
                    android:textSize="@dimen/roomkit_text_12"
                    app:checkedIconVisible="false"
                    app:chipIconVisible="false"
                    app:chipMinHeight="40dp"
                    app:chipStartPadding="4dp"
                    app:chipEndPadding="4dp"
                    app:textStartPadding="2dp"
                    app:textEndPadding="2dp"
                    app:closeIcon="@drawable/rc_rb_down"
                    app:closeIconSize="14dp"
                    app:closeIconStartPadding="2dp"
                    app:closeIconEndPadding="0dp"
                    app:closeIconTint="@color/roomkit_filter_text"
                    app:closeIconVisible="true" />

            </LinearLayout>
            <!-- Payment Collection Section -->
            <LinearLayout
                android:id="@+id/collectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="Payment collection"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_20"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCollectionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/roomkit_text_secondary"
                    android:textSize="@dimen/roomkit_text_13"
                    tools:text="2 invoices" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPaymentActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Payment History Section -->
            <LinearLayout
                android:id="@+id/historyHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="Payment history"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_20"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHistoryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/roomkit_text_secondary"
                    android:textSize="@dimen/roomkit_text_13"
                    tools:text="0 records" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPaymentHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Empty Payments State -->
            <LinearLayout
                android:id="@+id/layoutEmptyPayments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="36dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="No records in this view"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_18"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="Try another month or filter."
                    android:textColor="@color/roomkit_text_secondary"
                    android:textSize="@dimen/roomkit_text_14" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressPayments"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/roomkit_text_primary"
        android:visibility="gone" />

</FrameLayout>