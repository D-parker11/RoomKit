<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/pv_sheet_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/roomkit_size_24"
        android:paddingTop="@dimen/roomkit_size_12"
        android:paddingEnd="@dimen/roomkit_size_24"
        android:paddingBottom="@dimen/roomkit_size_24">

        <View
            android:layout_width="@dimen/roomkit_size_36"
            android:layout_height="@dimen/roomkit_spacing_xs"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/roomkit_size_24"
            android:background="@drawable/pv_drag_handle"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/pvu_title"
            android:textColor="@color/roomkit_text_primary"
            android:textSize="@dimen/roomkit_text_24"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_8"
            android:lineSpacingExtra="@dimen/roomkit_size_3"
            android:text="@string/pvu_intro"
            android:textColor="@color/roomkit_slate_600"
            android:textSize="@dimen/roomkit_text_14" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_20"
            app:cardBackgroundColor="@color/roomkit_slate_50"
            app:cardCornerRadius="@dimen/roomkit_size_16"
            app:cardElevation="@dimen/roomkit_size_0"
            app:strokeColor="@color/roomkit_slate_300"
            app:strokeWidth="@dimen/roomkit_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/roomkit_card_radius_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pvu_amount_label"
                    android:textColor="@color/roomkit_slate_600"
                    android:textSize="@dimen/roomkit_text_12" />

                <TextView
                    android:id="@+id/tvVoidAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_size_6"
                    android:textColor="@color/roomkit_text_primary"
                    android:textSize="@dimen/roomkit_text_28"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVoidPaymentInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/roomkit_size_8"
                    android:textColor="@color/roomkit_slate_600"
                    android:textSize="@dimen/roomkit_text_13" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_16"
            android:lineSpacingExtra="@dimen/roomkit_size_3"
            android:text="@string/pvu_effect"
            android:textColor="@color/roomkit_slate_600"
            android:textSize="@dimen/roomkit_text_13" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVoidReason"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_20"
            android:hint="@string/pvu_reason"
            android:textColorHint="@color/roomkit_slate_600"
            app:boxBackgroundColor="@color/roomkit_white"
            app:boxCornerRadiusBottomEnd="@dimen/roomkit_size_12"
            app:boxCornerRadiusBottomStart="@dimen/roomkit_size_12"
            app:boxCornerRadiusTopEnd="@dimen/roomkit_size_12"
            app:boxCornerRadiusTopStart="@dimen/roomkit_size_12"
            app:boxStrokeColor="@color/roomkit_slate_600"
            app:helperText="@string/pvu_reason_example"
            app:helperTextTextColor="@color/roomkit_slate_600"
            app:hintTextColor="@color/roomkit_slate_600">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVoidReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minLines="2"
                android:padding="@dimen/roomkit_size_16"
                android:textColor="@color/roomkit_text_primary"
                android:textSize="@dimen/roomkit_text_15" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvVoidError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_12"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/roomkit_error"
            android:textSize="@dimen/roomkit_text_13"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmVoid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_24"
            android:backgroundTint="@color/roomkit_error"
            android:insetTop="@dimen/roomkit_size_0"
            android:insetBottom="@dimen/roomkit_size_0"
            android:minHeight="@dimen/roomkit_action_height"
            android:paddingVertical="@dimen/roomkit_button_radius_compact"
            android:text="@string/pvu_confirm"
            android:textAllCaps="false"
            android:textColor="@color/roomkit_white"
            android:textSize="@dimen/roomkit_text_15"
            android:textStyle="bold"
            app:cornerRadius="@dimen/roomkit_button_radius_compact" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelVoid"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/roomkit_size_8"
            android:minHeight="@dimen/roomkit_touch_target"
            android:text="@string/pvu_cancel"
            android:textAllCaps="false"
            android:textColor="@color/roomkit_slate_600"
            android:textSize="@dimen/roomkit_text_15" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>